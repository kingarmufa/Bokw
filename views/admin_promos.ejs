<%- include('partials/header', { title: 'Promosi Pop Up' }) %>

<%
  // Format waktu WIB untuk tampilan & untuk <input type="datetime-local">
  const wibText = (d) => new Date(d).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).replace(/\./g, ':') + ' WIB';
  const wibInput = (d) => d ? new Date(new Date(d).getTime() + 7 * 3600 * 1000).toISOString().slice(0, 16) : '';
  const leftText = (d) => {
    const ms = new Date(d).getTime() - nowMs;
    if (ms <= 0) return '';
    const m = Math.floor(ms / 60000), h = Math.floor(m / 60), day = Math.floor(h / 24);
    if (day >= 1) return day + ' hari ' + (h % 24) + ' jam lagi';
    if (h >= 1) return h + ' jam ' + (m % 60) + ' menit lagi';
    return Math.max(1, m) + ' menit lagi';
  };
  const fieldWrap = 'flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-1.5';
  const fieldIn = 'flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full';
  const fileIn = fieldIn + ' file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-gray-100 file:text-gray-700';
%>

<div class="max-w-3xl mx-auto px-6 mt-1 pb-10">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-medium text-gray-800">Promosi Pop Up</h1>
    <span class="text-[12px] font-semibold text-gray-500"><%= promos.length %> Promosi</span>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-rose-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <div class="bg-orange-50 border border-orange-200 text-orange-700 px-4 py-3 rounded-xl mb-4 text-[11.5px] font-medium">
    <i class="fa-solid fa-circle-info mr-1"></i> Pop up muncul di dashboard user (maksimal 5 promo aktif, urut sesuai "Urutan Tampil"). Promo yang sudah lewat waktu expired otomatis berhenti tampil. User bisa menutup pop up atau centang "Jangan tampilkan lagi".
  </div>

  <!-- ===== FORM BUAT PROMO ===== -->
  <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-5 mb-6">
    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
      <i class="fa-solid fa-window-restore text-gray-700 text-sm"></i>
      <h2 class="text-sm font-medium text-gray-800">Buat Promosi Pop Up</h2>
    </div>

    <form method="POST" action="/admin/promos" enctype="multipart/form-data" class="flex flex-col gap-3">
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Judul Promosi</label>
        <div class="<%= fieldWrap %>">
          <input name="title" type="text" maxlength="100" placeholder="Contoh: Diskon Paket VIP 50%" class="<%= fieldIn %>">
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Gambar <span class="text-red-500">*</span></label>
        <div class="<%= fieldWrap %>">
          <input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="<%= fileIn %>">
        </div>
        <p class="text-[11px] text-gray-400 mt-1.5 mb-2">Upload gambar (JPG/PNG/WEBP/GIF, maks 5MB) <b>atau</b> isi URL gambar di bawah. Kalau dua-duanya diisi, file upload yang dipakai.</p>
        <div class="<%= fieldWrap %>">
          <input name="imageUrl" type="url" placeholder="URL gambar: https://contoh.com/promo.jpg" class="<%= fieldIn %>">
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Link Tujuan (opsional)</label>
        <div class="<%= fieldWrap %>">
          <input name="linkUrl" type="url" placeholder="https://..." class="<%= fieldIn %>">
        </div>
        <p class="text-[11px] text-gray-400 mt-1.5">Kalau diisi, gambar pop up bisa diklik dan membuka tautan ini di tab baru.</p>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Expired (waktu WIB)</label>
        <div class="<%= fieldWrap %>">
          <input name="expiresAt" type="datetime-local" class="<%= fieldIn %>">
        </div>
        <p class="text-[11px] text-gray-400 mt-1.5">Setelah waktu ini pop up otomatis berhenti tampil. Kosongkan kalau tidak ada batas waktu.</p>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Urutan Tampil (opsional)</label>
        <div class="<%= fieldWrap %>">
          <input name="order" type="number" value="0" class="<%= fieldIn %>">
        </div>
        <p class="text-[11px] text-gray-400 mt-1.5">Angka lebih kecil tampil lebih dulu.</p>
      </div>

      <button type="submit" class="comic-btn-primary mt-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-[13.5px] font-bold">
        <i class="fa-solid fa-paper-plane"></i> Buat Pop Up
      </button>
    </form>
  </div>

  <!-- ===== DAFTAR PROMO ===== -->
  <div class="flex items-center gap-2 mb-3 px-1">
    <i class="fas fa-images text-gray-700 text-sm"></i>
    <h2 class="text-sm font-medium text-gray-800">Daftar Promosi</h2>
  </div>

  <% if (!promos || promos.length === 0) { %>
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-8 text-center">
      <p class="text-sm font-medium text-gray-600">Belum ada promosi pop up. Buat yang pertama di atas.</p>
    </div>
  <% } else { %>
    <div class="flex flex-col gap-3">
      <% promos.forEach(function(pr, idx) {
           const expired = pr.expiresAt && new Date(pr.expiresAt).getTime() <= nowMs;
           const live = pr.active && !expired;
           const stTxt = expired ? 'Expired' : (pr.active ? 'Tampil' : 'Nonaktif');
           const stCls = expired ? 'bg-rose-100 text-rose-700' : (pr.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500');
           const isLocal = String(pr.imageUrl).indexOf('/uploads/promos/') === 0;
      %>
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 overflow-hidden <%= live ? '' : 'opacity-90' %>">
          <img src="<%= pr.imageUrl %>" alt="<%= pr.title || 'Promo' %>" class="w-full h-[160px] object-cover block bg-gray-100 <%= expired ? 'grayscale' : '' %>">
          <div class="p-4">
            <div class="flex items-center justify-between gap-2 mb-1">
              <p class="text-[13.5px] font-bold text-gray-800 truncate"><%= pr.title || '(Tanpa judul)' %></p>
              <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full border-2 border-black <%= stCls %>"><%= stTxt %></span>
            </div>
            <% if (pr.linkUrl) { %>
              <p class="text-[12px] text-blue-500 font-medium truncate mb-1"><i class="fa-solid fa-link text-[10px] mr-1"></i><%= pr.linkUrl %></p>
            <% } %>
            <p class="text-[11px] mb-1 font-semibold <%= expired ? 'text-rose-600' : 'text-gray-500' %>">
              <i class="fa-regular fa-clock mr-1"></i>
              <% if (!pr.expiresAt) { %>Tanpa expired
              <% } else if (expired) { %>Expired sejak <%= wibText(pr.expiresAt) %>
              <% } else { %>Expired <%= wibText(pr.expiresAt) %> (<%= leftText(pr.expiresAt) %>)<% } %>
            </p>
            <p class="text-[11px] text-gray-400 mb-3">Urutan: <%= pr.order %> &middot; Gambar: <%= isLocal ? 'upload' : 'URL' %> &middot; Dibuat <%= new Date(pr.createdAt).toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta' }) %></p>

            <div class="flex items-center gap-2 mb-2">
              <button type="button" onclick="document.getElementById('editPromo-<%= idx %>').classList.toggle('hidden')"
                      class="flex-1 comic-btn-primary px-3 py-2 rounded-xl text-[12.5px] font-bold">
                <i class="fa-solid fa-pen"></i> Edit
              </button>
              <form method="POST" action="/admin/promos/<%= pr._id %>/toggle" class="flex-1">
                <button type="submit" class="w-full comic-btn-secondary px-3 py-2 rounded-xl text-[12.5px] font-bold">
                  <i class="fa-solid <%= pr.active ? 'fa-eye-slash' : 'fa-eye' %>"></i> <%= pr.active ? 'Nonaktifkan' : 'Aktifkan' %>
                </button>
              </form>
            </div>
            <form method="POST" action="/admin/promos/<%= pr._id %>/delete" onsubmit="return confirm('Hapus promosi ini? Tindakan ini tidak bisa dibatalkan.');">
              <button type="submit" class="w-full comic-btn-danger px-3 py-2 rounded-xl text-[12.5px] font-bold">
                <i class="fa-solid fa-trash"></i> Hapus
              </button>
            </form>

            <!-- Panel Edit -->
            <div id="editPromo-<%= idx %>" class="hidden mt-3 pt-3 border-t border-gray-200">
              <form method="POST" action="/admin/promos/<%= pr._id %>/edit" enctype="multipart/form-data" class="flex flex-col gap-3">
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-2">Judul Promosi</label>
                  <div class="<%= fieldWrap %>">
                    <input name="title" type="text" maxlength="100" value="<%= pr.title || '' %>" class="<%= fieldIn %>">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-2">Ganti Gambar (opsional)</label>
                  <div class="<%= fieldWrap %>">
                    <input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="<%= fileIn %>">
                  </div>
                  <p class="text-[11px] text-gray-400 mt-1.5 mb-2">Upload file baru, atau ubah URL gambar di bawah. Kosongkan file kalau tidak ingin mengganti.</p>
                  <div class="<%= fieldWrap %>">
                    <input name="imageUrl" type="url" value="<%= isLocal ? '' : pr.imageUrl %>" placeholder="URL gambar: https://..." class="<%= fieldIn %>">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-2">Link Tujuan</label>
                  <div class="<%= fieldWrap %>">
                    <input name="linkUrl" type="url" value="<%= pr.linkUrl || '' %>" placeholder="https://..." class="<%= fieldIn %>">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-2">Expired (waktu WIB)</label>
                  <div class="<%= fieldWrap %>">
                    <input name="expiresAt" type="datetime-local" value="<%= wibInput(pr.expiresAt) %>" class="<%= fieldIn %>">
                  </div>
                  <p class="text-[11px] text-gray-400 mt-1.5">Kosongkan = tanpa expired. Mengubah promo membuat pop up muncul lagi ke user yang sudah menutupnya.</p>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-2">Urutan Tampil</label>
                  <div class="<%= fieldWrap %>">
                    <input name="order" type="number" value="<%= pr.order %>" class="<%= fieldIn %>">
                  </div>
                </div>
                <button type="submit" class="comic-btn-primary inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-[13px] font-bold">
                  <i class="fa-solid fa-floppy-disk"></i> Simpan Perubahan
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
