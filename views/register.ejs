<!DOCTYPE html>
<html <%- include('partials/htmlattrs') %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff" />
  <%- include('partials/seo_meta', { pageTitle: settings.name }) %>
  
  <% if (settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">  
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { 
      theme: { 
        extend: { 
          fontFamily: { 
            'sans': ['Inter', 'sans-serif']
          }
        } 
      } 
    }
  </script>
  <style>
    :root {
      --cream-top: #f8e3e0;
      --blue-500: #3b82f6;
      --green-600: #16a34a;
    }
    body {
      color: #1f2937;
      margin: 0;
    }
    .validation-msg { font-size: 11px; margin-top: 4px; }
    .valid { color: #16a34a; }
    .invalid { color: #dc2626; }

    /* ===== Pilihan metode verifikasi (warna brand sendiri, bukan biru tema) ===== */
    .vm-option { cursor: pointer; display: block; }
    .vm-option input { display: none; }
    .vm-option .box { border: 1.5px solid #e5e7eb; transition: all .15s ease; background: #fff; }
    .vm-option.vm-wa input:checked + .box   { border-color: #25D366; background: #f0fdf4; box-shadow: 0 0 0 3px rgba(37,211,102,.16); }
    .vm-option.vm-mail input:checked + .box { border-color: #EA4335; background: #fef2f2; box-shadow: 0 0 0 3px rgba(234,67,53,.14); }
    .vm-option.vm-tg input:checked + .box   { border-color: #229ED9; background: #f0f9ff; box-shadow: 0 0 0 3px rgba(34,158,217,.16); }
    .vm-option.disabled { cursor: not-allowed; opacity: .5; }
    .vm-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .vm-icon-wa   { background: #25D366; }
    .vm-icon-mail { background: #EA4335; }
    .vm-icon-tg   { background: #229ED9; }
    .vm-check { width: 18px; height: 18px; border-radius: 999px; border: 1.5px solid #d1d5db; display: flex; align-items: center; justify-content: center; color: transparent; font-size: 9px; transition: all .15s ease; }
    .vm-wa   input:checked + .box .vm-check { background: #25D366; border-color: #25D366; color: #fff; }
    .vm-mail input:checked + .box .vm-check { background: #EA4335; border-color: #EA4335; color: #fff; }
    .vm-tg   input:checked + .box .vm-check { background: #229ED9; border-color: #229ED9; color: #fff; }
    .wa-focus:focus-within { border-color: #25D366 !important; box-shadow: 0 0 0 1px #25D366; }
  </style>
  <style>
    /* Tampilan register: polos & bersih (tanpa tema kuning/komik) */
    html, body { background: #f1f5f9 !important; }
    body { font-family: 'Inter', system-ui, sans-serif; color: #1f2937; }
    button[type=submit] { background: #1d4ed8 !important; color: #fff !important; }
    button[type=submit]:hover { background: #1e40af !important; }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Konten utama -->
  <div class="flex-1 flex flex-col justify-center items-center px-6 py-16">

    <!-- Card Register -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 shadow-md transition-shadow duration-300 px-6 py-10 w-full max-w-md flex flex-col gap-6 shadow-sm">
      
      <!-- Logo (jika ada) -->
      <% if (settings.logoUrl) { %>
        <div class="text-center">
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto object-contain mx-auto mb-2">
          <h2 class="text-base font-medium text-gray-800">Buat Akun Baru</h2>
        </div>
      <% } else { %>
        <div class="text-center">
          <h2 class="text-base font-medium text-gray-800">Buat Akun Baru</h2>
        </div>
      <% } %>

      <!-- Alert Error -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-[#fef2f2] border border-[#fecaca] text-[#dc2626] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= error %>
        </div>
      <% } %>
      
      <!-- Alert Success (jika ada, misal setelah redirect) -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-[#f0fdf4] border border-[#bbf7d0] text-[#16a34a] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= success %>
        </div>
      <% } %>

      <!-- Form Register -->
      <form method="POST" action="/register" class="flex flex-col gap-4" autocomplete="off" id="registerForm" novalidate>
        
        <!-- Username -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Username</label>
          <input id="usernameInput" name="username" type="text" placeholder="Username" 
                 class="w-full bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm px-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400" 
                 maxlength="15" required>
          <p id="usernameFeedback" class="validation-msg"></p>
        </div>

        <!-- Nama (opsional) -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Nama <span class="text-gray-400 font-normal">(opsional)</span></label>
          <input id="firstNameInput" name="first_name" type="text" placeholder="Kosongkan untuk pakai username"
                 class="w-full bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm px-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400"
                 maxlength="20">
        </div>

        <!-- Email -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Alamat Email</label>
          <input id="emailInput" name="email" type="email" placeholder="nama@email.com" 
                 class="w-full bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm px-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400" required>
          <p id="emailFeedback" class="validation-msg"></p>
        </div>
        
        <!-- Password -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Password</label>
          <div class="flex items-center bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm transition-all focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500">
            <input id="passwordInput" name="password" type="password" placeholder="••••••••" 
                   class="flex-1 bg-transparent px-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none w-full placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400" 
                   minlength="4" required>
            <button type="button" onclick="togglePassword()" class="w-9 h-9 text-gray-400 hover:text-gray-600 transition-all flex items-center justify-center shrink-0 mr-1">
              <i id="toggleIcon" class="far fa-eye text-[13.5px]"></i>
            </button>
          </div>
          <p id="passwordFeedback" class="validation-msg"></p>
        </div>

        <!-- Konfirmasi Password -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Konfirmasi Password</label>
          <div class="flex items-center bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm transition-all focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500">
            <input id="confirmPasswordInput" name="confirm_password" type="password" placeholder="••••••••" 
                   class="flex-1 bg-transparent px-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none w-full placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400" 
                   minlength="4" required>
            <button type="button" onclick="toggleConfirmPassword()" class="w-9 h-9 text-gray-400 hover:text-gray-600 transition-all flex items-center justify-center shrink-0 mr-1">
              <i id="confirmToggleIcon" class="far fa-eye text-[13.5px]"></i>
            </button>
          </div>
          <p id="confirmFeedback" class="validation-msg"></p>
        </div>

        <!-- Nomor WhatsApp (WAJIB selalu, tidak tergantung metode verifikasi yang dipilih) -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Nomor WhatsApp</label>
          <div class="wa-focus flex items-center bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm transition-all">
            <i class="fab fa-whatsapp pl-4 pr-1" style="color:#25D366"></i>
            <select id="waCc" name="whatsapp_cc" class="bg-transparent text-[13.5px] font-medium text-gray-700 outline-none pl-1 pr-1 py-3 max-w-[112px] cursor-pointer" aria-label="Kode negara">
              <%- include('partials/wa_country_options', { sel: '62' }) %>
            </select>
            <span class="w-px h-5 bg-gray-200 mx-1"></span>
            <input id="waInput" name="whatsapp" type="tel" inputmode="numeric" placeholder="81234567890" maxlength="16" required
                   class="flex-1 bg-transparent pr-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none w-full placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400">
          </div>
          <p class="text-[11px] text-gray-400 mt-1 px-1">Pilih kode negara lalu isi nomor tanpa angka 0 di depan. Atau ketik nomor lengkap diawali <b>+</b> (contoh: +60123456789).</p>
          <p id="waFeedback" class="validation-msg"></p>
        </div>

        <!-- ID Telegram (opsional) -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">ID Telegram <span class="text-gray-400 font-normal">(opsional)</span></label>
          <div class="flex items-center bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm transition-all focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500">
            <i class="fab fa-telegram pl-4 pr-1" style="color:#229ED9"></i>
            <input id="telegramIdInput" name="telegram_id" type="text" inputmode="numeric" placeholder="Contoh: 123456789" maxlength="15"
                   class="flex-1 bg-transparent px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none w-full placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400">
          </div>
          <p class="text-[11px] text-gray-400 mt-1 px-1">Dapatkan ID Telegram kamu lewat bot @userinfobot. Boleh dikosongkan.</p>
          <p id="telegramIdFeedback" class="validation-msg"></p>
        </div>

        <% const vEnabled = (typeof verify !== 'undefined' && verify && verify.enabled); %>
        <% if (vEnabled) { %>
        <!-- Metode Verifikasi: WhatsApp, Gmail, atau Telegram -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Verifikasi Akun Lewat</label>
          <div class="flex flex-col gap-3">

            <label class="vm-option vm-wa <%= verify.whatsappAvailable ? '' : 'disabled' %>">
              <input type="radio" name="verify_method" value="whatsapp" <%= verify.whatsappAvailable ? '' : 'disabled' %> <%= verify.whatsappAvailable ? 'checked' : '' %>>
              <div class="box rounded-2xl px-4 py-3.5 flex items-center gap-3">
                <div class="vm-icon vm-icon-wa"><i class="fab fa-whatsapp text-white text-[22px]"></i></div>
                <div class="flex-1">
                  <p class="text-[13.5px] font-semibold text-gray-800">Verifikasi Nomor WhatsApp</p>
                  <p class="text-[12px] text-gray-500"><%= verify.whatsappAvailable ? 'Kode OTP dikirim ke nomor WhatsApp di atas' : 'Belum tersedia saat ini' %></p>
                </div>
                <span class="vm-check"><i class="fas fa-check"></i></span>
              </div>
            </label>

            <label class="vm-option vm-mail <%= verify.emailAvailable ? '' : 'disabled' %>">
              <input type="radio" name="verify_method" value="email" <%= verify.emailAvailable ? '' : 'disabled' %> <%= (!verify.whatsappAvailable && verify.emailAvailable) ? 'checked' : '' %>>
              <div class="box rounded-2xl px-4 py-3.5 flex items-center gap-3">
                <div class="vm-icon vm-icon-mail"><i class="fas fa-envelope text-white text-[18px]"></i></div>
                <div class="flex-1">
                  <p class="text-[13.5px] font-semibold text-gray-800">Verifikasi Gmail</p>
                  <p class="text-[12px] text-gray-500"><%= verify.emailAvailable ? 'Kode OTP dikirim ke email yang didaftarkan' : 'Belum tersedia saat ini' %></p>
                </div>
                <span class="vm-check"><i class="fas fa-check"></i></span>
              </div>
            </label>

            <label id="vmTgOption" class="vm-option vm-tg disabled" data-tg-available="<%= verify.telegramAvailable ? '1' : '0' %>">
              <input id="vmTgRadio" type="radio" name="verify_method" value="telegram" disabled>
              <div class="box rounded-2xl px-4 py-3.5 flex items-center gap-3">
                <div class="vm-icon vm-icon-tg"><i class="fab fa-telegram-plane text-white text-[18px]"></i></div>
                <div class="flex-1">
                  <p class="text-[13.5px] font-semibold text-gray-800">Verifikasi Telegram</p>
                  <p id="vmTgDesc" class="text-[12px] text-gray-500"><%= verify.telegramAvailable ? 'Isi ID Telegram di atas dulu untuk pakai opsi ini' : 'Belum tersedia saat ini' %></p>
                </div>
                <span class="vm-check"><i class="fas fa-check"></i></span>
              </div>
            </label>

          </div>
        </div>
        <% } %>

        <% if (typeof referral !== 'undefined' && referral.enabled) { %>
        <!-- Kode Referral (otomatis terisi & terkunci kalau daftar lewat link, atau isi manual kalau punya) -->
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Kode Referral <span class="text-gray-400 font-normal">(opsional)</span></label>
          <input id="refInput" name="ref" type="text" placeholder="Kode referral (kalau ada)" maxlength="20"
                 value="<%= referral.code || '' %>" <%= referral.code ? 'readonly' : '' %>
                 class="w-full <%= referral.code ? 'bg-gray-100 text-gray-500' : 'bg-[#f9f9f9] text-gray-800' %> border border-gray-100 rounded-2xl shadow-sm px-4 py-3 text-[13.5px] font-medium outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400 uppercase">
          <% if (referral.code) { %>
            <p class="text-[11px] text-gray-400 mt-1 px-1">Kamu daftar lewat link referral, kode otomatis terpakai.</p>
          <% } %>
        </div>
        <% } %>

        <!-- Tombol Daftar -->
        <button type="submit" id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white w-full py-3 rounded-xl text-[13.5px] font-semibold shadow-md shadow-blue-600/20 hover:shadow-lg hover:shadow-blue-600/25 hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center mt-2">
          <span id="submitBtnText">Daftar Sekarang</span>
          <i id="submitBtnSpinner" class="fas fa-spinner fa-spin text-[13.5px] hidden ml-2"></i>
        </button>
      </form>

      <!-- Link Login -->
      <p class="text-center text-[13.5px] font-medium text-gray-700">
        Sudah punya akun? 
        <a href="/login" class="text-blue-500 font-medium hover:underline transition-colors">Masuk di sini</a>
      </p>
    </div>

    <!-- Link bawah -->
    <div class="mt-8 text-center flex flex-col gap-6">
      <a href="/" class="text-[13.5px] font-medium text-blue-600 transition-colors flex items-center justify-center gap-1">
        <i class="fas fa-arrow-left text-[13.5px]"></i> Ke Beranda
      </a>
      
      <div class="text-center flex gap-1">
        <p class="text-[13.5px] text-gray-800 font-medium">Butuh bantuan?</p>
        <a href="<%= settings.contactDeveloper || '#' %>" class="text-[13.5px] font-medium text-blue-600 underline transition-colors flex items-center justify-center gap-1">
          Hubungi tim Support
        </a>
      </div>
    </div>

  </div>

  <%- include('partials/credit') %>

  <script>
    // Elemen input
    const usernameInput = document.getElementById('usernameInput');
    const emailInput = document.getElementById('emailInput');
    const passwordInput = document.getElementById('passwordInput');
    const confirmPasswordInput = document.getElementById('confirmPasswordInput');

    // Elemen feedback
    const usernameFeedback = document.getElementById('usernameFeedback');
    const emailFeedback = document.getElementById('emailFeedback');
    const passwordFeedback = document.getElementById('passwordFeedback');
    const confirmFeedback = document.getElementById('confirmFeedback');

    // Flag pencegahan double submit
    let isSubmitting = false;

    // ===== Metode verifikasi (WhatsApp / Gmail / Telegram) =====
    const waInput = document.getElementById('waInput');
    const waFeedback = document.getElementById('waFeedback');
    const telegramIdInput = document.getElementById('telegramIdInput');
    const telegramIdFeedback = document.getElementById('telegramIdFeedback');
    const vmTgOption = document.getElementById('vmTgOption');
    const vmTgRadio = document.getElementById('vmTgRadio');
    function currentVerifyMethod() {
      const r = document.querySelector('input[name="verify_method"]:checked');
      return r ? r.value : null;
    }
    function waNormalize(raw, cc) {
      const str = String(raw || '').trim();
      let n = str.replace(/[^0-9]/g, '');
      if (!n) return '';
      let full;
      if (str.startsWith('+')) full = n;
      else {
        n = n.replace(/^0+/, '');
        full = (cc === '62' && n.startsWith('62')) ? n : cc + n;
      }
      if (full.startsWith('62')) return /^628\d{8,12}$/.test(full) ? full : '';
      return /^[1-9]\d{7,14}$/.test(full) ? full : '';
    }
    // Nomor WhatsApp sekarang WAJIB selalu, apapun metode verifikasi yang dipilih.
    function validateWa() {
      if (!waInput) return true;
      if (waInput.value.replace(/[^0-9]/g, '').length === 0) { waFeedback.textContent = 'Nomor WhatsApp wajib diisi'; waFeedback.className = 'validation-msg invalid'; return false; }
      const cc = document.getElementById('waCc').value;
      if (waNormalize(waInput.value, cc)) {
        waFeedback.textContent = 'Nomor WhatsApp valid';
        waFeedback.className = 'validation-msg valid';
        return true;
      }
      waFeedback.textContent = 'Nomor WhatsApp tidak valid, cek kode negara & nomornya';
      waFeedback.className = 'validation-msg invalid';
      return false;
    }
    // ID Telegram opsional — kalau diisi harus 5-15 digit angka. Kalau valid & bot tersedia,
    // opsi "Verifikasi Telegram" ikut aktif; kalau dikosongkan lagi, opsi itu dinonaktifkan lagi.
    function validateTelegramId() {
      if (!telegramIdInput) return true;
      const val = telegramIdInput.value.trim();
      if (val.length === 0) { telegramIdFeedback.textContent = ''; return true; }
      if (/^[0-9]{5,15}$/.test(val)) {
        telegramIdFeedback.textContent = 'Format ID Telegram valid';
        telegramIdFeedback.className = 'validation-msg valid';
        return true;
      }
      telegramIdFeedback.textContent = 'ID Telegram harus berupa angka (5-15 digit)';
      telegramIdFeedback.className = 'validation-msg invalid';
      return false;
    }
    function syncTelegramOption() {
      if (!vmTgOption || !vmTgRadio) return;
      const tgAvailable = vmTgOption.dataset.tgAvailable === '1';
      const hasValidId = telegramIdInput && /^[0-9]{5,15}$/.test(telegramIdInput.value.trim());
      const canUse = tgAvailable && hasValidId;
      vmTgRadio.disabled = !canUse;
      vmTgOption.classList.toggle('disabled', !canUse);
      if (!canUse && vmTgRadio.checked) {
        vmTgRadio.checked = false;
        const fallback = document.querySelector('input[name="verify_method"]:not(:disabled)');
        if (fallback) fallback.checked = true;
      }
    }
    if (waInput) waInput.addEventListener('input', validateWa);
    const waCcEl = document.getElementById('waCc');
    if (waCcEl) waCcEl.addEventListener('change', validateWa);
    if (telegramIdInput) telegramIdInput.addEventListener('input', function () { validateTelegramId(); syncTelegramOption(); });
    syncTelegramOption();

    // Fungsi untuk menghapus spasi
    function removeSpaces(e) {
      const input = e.target;
      const cursorPos = input.selectionStart;
      const oldValue = input.value;
      const newValue = oldValue.replace(/\s/g, '');
      if (oldValue !== newValue) {
        input.value = newValue;
        // Posisikan kursor kembali
        const diff = oldValue.length - newValue.length;
        input.setSelectionRange(cursorPos - diff, cursorPos - diff);
      }
    }

    // Pasang event listener untuk menghapus spasi
    usernameInput.addEventListener('input', removeSpaces);
    emailInput.addEventListener('input', removeSpaces);
    passwordInput.addEventListener('input', removeSpaces);
    confirmPasswordInput.addEventListener('input', removeSpaces);

    // Toggle visibility
    function togglePassword() {
      const icon = document.getElementById('toggleIcon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    function toggleConfirmPassword() {
      const icon = document.getElementById('confirmToggleIcon');
      if (confirmPasswordInput.type === 'password') {
        confirmPasswordInput.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        confirmPasswordInput.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    // Validasi username (4-15, hanya huruf & angka)
    function validateUsername() {
      const val = usernameInput.value.trim();
      if (val.length === 0) {
        usernameFeedback.textContent = '';
        return false;
      }
      const regex = /^[a-zA-Z0-9]+$/;
      if (val.length >= 4 && val.length <= 15 && regex.test(val)) {
        usernameFeedback.textContent = 'Username valid';
        usernameFeedback.className = 'validation-msg valid';
        return true;
      } else {
        usernameFeedback.textContent = 'Username minimal 4 karakter, huruf & angka saja';
        usernameFeedback.className = 'validation-msg invalid';
        return false;
      }
    }

    // Validasi email
    function validateEmail() {
      const val = emailInput.value.trim();
      if (val.length === 0) {
        emailFeedback.textContent = '';
        return false;
      }
      const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (regex.test(val)) {
        emailFeedback.textContent = 'Email valid';
        emailFeedback.className = 'validation-msg valid';
        return true;
      } else {
        emailFeedback.textContent = 'Format email tidak valid';
        emailFeedback.className = 'validation-msg invalid';
        return false;
      }
    }

    // Validasi password
    function validatePassword() {
      const val = passwordInput.value;
      if (val.length === 0) {
        passwordFeedback.textContent = '';
        return false;
      }
      if (val.length >= 4) {
        passwordFeedback.textContent = 'Password minimal 4 karakter';
        passwordFeedback.className = 'validation-msg valid';
        return true;
      } else {
        passwordFeedback.textContent = 'Password minimal 4 karakter';
        passwordFeedback.className = 'validation-msg invalid';
        return false;
      }
    }

    // Validasi konfirmasi password
    function validateConfirmPassword() {
      const password = passwordInput.value;
      const confirm = confirmPasswordInput.value;
      if (confirm.length === 0) {
        confirmFeedback.textContent = '';
        return false;
      }
      if (password === confirm) {
        confirmFeedback.textContent = 'Password cocok';
        confirmFeedback.className = 'validation-msg valid';
        return true;
      } else {
        confirmFeedback.textContent = 'Password tidak cocok';
        confirmFeedback.className = 'validation-msg invalid';
        return false;
      }
    }

    // Event listeners
    usernameInput.addEventListener('input', validateUsername);
    emailInput.addEventListener('input', validateEmail);
    passwordInput.addEventListener('input', () => {
      validatePassword();
      validateConfirmPassword(); // update juga konfirmasi jika password berubah
    });
    confirmPasswordInput.addEventListener('input', validateConfirmPassword);

    // Saat submit, cek ulang semua validasi dan cegah double submit
    document.getElementById('registerForm').addEventListener('submit', function(e) {
      // Jika sudah dalam proses pengiriman, cegah submit ulang
      if (isSubmitting) {
        e.preventDefault();
        return false;
      }

      // Trigger semua validasi
      const isUserValid = validateUsername();
      const isEmailValid = validateEmail();
      const isPassValid = validatePassword();
      const isConfirmValid = validateConfirmPassword();

      // Kalau verifikasi aktif, harus ada metode terpilih
      if (document.querySelector('input[name="verify_method"]') && !currentVerifyMethod()) {
        e.preventDefault();
        alert('Belum ada metode verifikasi yang tersedia. Silakan hubungi Support.');
        return false;
      }
      // Nomor WhatsApp WAJIB selalu; ID Telegram opsional tapi kalau diisi harus valid.
      const isWaValid = validateWa();
      const isTgIdValid = validateTelegramId();

      if (!isUserValid || !isEmailValid || !isPassValid || !isConfirmValid || !isWaValid || !isTgIdValid) {
        e.preventDefault();
        // Fokus ke input pertama yang tidak valid
        if (!isUserValid) usernameInput.focus();
        else if (!isEmailValid) emailInput.focus();
        else if (!isPassValid) passwordInput.focus();
        else if (!isConfirmValid) confirmPasswordInput.focus();
        else if (!isWaValid && waInput) waInput.focus();
        else if (!isTgIdValid && telegramIdInput) telegramIdInput.focus();
        return false;
      }

      // Validasi lolos, kunci tombol
      isSubmitting = true;
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.classList.add('opacity-70', 'cursor-not-allowed');
      document.getElementById('submitBtnText').textContent = 'Mendaftarkan...';
      document.getElementById('submitBtnSpinner').classList.remove('hidden');
    });

    // Reset tombol jika halaman dimuat dari cache (misal tombol back)
    window.addEventListener('pageshow', function(event) {
      if (event.persisted) {
        isSubmitting = false;
        const btn = document.getElementById('submitBtn');
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
          document.getElementById('submitBtnText').textContent = 'Daftar Sekarang';
          document.getElementById('submitBtnSpinner').classList.add('hidden');
        }
      }
    });
  </script>

</body>
</html>