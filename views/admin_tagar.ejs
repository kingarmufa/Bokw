<%- include('partials/header', { title: 'Tagar' }) %>

<div class="px-6 pb-6 mt-1 max-w-[480px] md:max-w-lg mx-auto">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <h1 class="text-base font-bold text-gray-800 mb-1">Tagar</h1>
  <p class="text-[11.5px] text-gray-500 mb-4">Tagar dipakai sebagai kata kunci SEO (meta keywords &amp; article:tag) dan bisa ditampilkan sebagai #hashtag di beranda. Ditambah lewat menu <a href="/admin/seo" class="text-blue-600 font-semibold">SEO Pencarian</a> juga tersambung.</p>

  <form method="POST" action="/admin/tagar/tambah" class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3"><i class="fa-solid fa-hashtag mr-1 text-blue-500"></i> Tambah Tagar</h2>
    <textarea name="tags" rows="3" required placeholder="qris, payment gateway, api qris&#10;deposit otomatis" class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs"></textarea>
    <p class="text-[10px] text-gray-400 mt-1">Pisahkan dengan koma atau baris baru. Tanda # boleh dipakai. Maks <%= maxTags %> tagar (sekarang <%= tags.length %>).</p>
    <button type="submit" class="w-full py-2.5 rounded-xl bg-blue-600 text-white text-[12.5px] font-bold mt-3">Tambah</button>
  </form>

  <div class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3">Daftar Tagar (<%= tags.length %>)</h2>
    <% if (!tags.length) { %>
      <p class="text-[11.5px] text-gray-400">Belum ada tagar.</p>
    <% } else { %>
      <div class="flex flex-wrap gap-2">
        <% tags.forEach(function (t) { %>
          <form method="POST" action="/admin/tagar/hapus" class="inline-flex items-center gap-1 px-3 py-1 rounded-full border border-gray-300 text-[11.5px] font-bold text-gray-700">
            <input type="hidden" name="tag" value="<%= t %>">
            <span><%= '#' + t.replace(/[\s-]+/g, '') %></span>
            <button type="submit" title="Hapus" class="text-red-500 ml-1" onclick="return confirm('Hapus tagar ini?')"><i class="fa-solid fa-xmark"></i></button>
          </form>
        <% }); %>
      </div>
    <% } %>
  </div>

  <form method="POST" action="/admin/tagar/tampil" class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <label class="flex items-center justify-between cursor-pointer">
      <span class="text-[12px] font-semibold text-gray-700">Tampilkan tagar di beranda</span>
      <input type="checkbox" name="seoTagsShow" <%= settings.seoTagsShow !== false ? 'checked' : '' %> class="w-4 h-4 accent-blue-600">
    </label>
    <button type="submit" class="w-full py-2.5 rounded-xl bg-blue-600 text-white text-[12.5px] font-bold mt-3">Simpan</button>
  </form>

</div>

<%- include('partials/footer') %>
