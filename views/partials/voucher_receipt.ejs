<% if (order.voucherCode) { %><section class="vc-checkout" data-comic-owned aria-label="Potongan voucher"><strong><%= order.voucherCode %> · diskon <%= order.voucherPercent %>%</strong><div class="vc-summary"><div><span>Harga awal</span><span>Rp <%= Number(order.originalPrice).toLocaleString('id-ID') %></span></div><div><span>Potongan</span><strong>− Rp <%= Number(order.discountAmount).toLocaleString('id-ID') %></strong></div><div class="vc-total"><span>Total dibayar</span><strong>Rp <%= Number(order.price ?? order.sellPrice ?? order.cost ?? 0).toLocaleString('id-ID') %></strong></div></div></section><% } %>
