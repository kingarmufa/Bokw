<script>
  (function () {
    const sheet = document.getElementById('comicMenuSheet');
    const search = document.getElementById('comicMenuSearch');
    const items = Array.from(sheet.querySelectorAll('.comic-menu-item'));
    const titles = Array.from(sheet.querySelectorAll('.comic-menu-section-title'));
    const empty = document.createElement('p');
    empty.className = 'comic-menu-empty'; empty.textContent = 'Menu tidak ditemukan. Coba kata lain.';
    empty.hidden = true; empty.setAttribute('role', 'status');
    sheet.querySelector('.comic-menu-body').appendChild(empty);
    function filter() {
      const q = search.value.trim().toLocaleLowerCase('id-ID');
      items.forEach(item => { item.hidden = !item.textContent.toLocaleLowerCase('id-ID').includes(q); });
      titles.forEach(title => {
        let next = title.nextElementSibling, visible = false;
        while (next && !next.classList.contains('comic-menu-section-title')) {
          if (next.classList.contains('comic-menu-item') && !next.hidden) visible = true;
          next = next.nextElementSibling;
        }
        title.hidden = !visible;
      });
      empty.hidden = items.some(item => !item.hidden);
    }
    search.addEventListener('input', filter);
    const path = location.pathname;
    items.forEach(item => {
      if (new URL(item.href, location.href).pathname === path) item.setAttribute('aria-current', 'page');
    });
    const nav = document.getElementById('comicNavInner');
    if (nav) {
      const active = nav.querySelector('.comic-nav-item.active');
      if (active && active.tagName === 'A') active.setAttribute('aria-current', 'page');
      if (!active) document.getElementById('comicMenuBtn').classList.add('active');
    }
    function expanded(value) {
      document.querySelectorAll('#comicMenuBtn, .menu-toggle-btn').forEach(btn => {
        btn.setAttribute('aria-expanded', String(value));
        btn.setAttribute('aria-controls', 'comicMenuSheet');
        btn.setAttribute('aria-haspopup', 'dialog');
      });
    }
    window.openComicMenu = function () {
      search.value = ''; filter(); ComicDialog.open(sheet); expanded(true);
    };
    window.closeComicMenu = function () { ComicDialog.close(sheet); };
    window.toggleComicMenu = function () { sheet.open ? closeComicMenu() : openComicMenu(); };
    sheet.addEventListener('close', () => expanded(false));
    expanded(false);
  })();
</script>
<% } %>
