<!DOCTYPE html>
<html <%- include('partials/htmlattrs') %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1e3a8a" />
  <%- include('partials/seo_meta', { pageTitle: 'Dokumentasi API - ' + settings.name }) %>
  <% if (settings.logoUrl) { %><link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>"><% } %>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8fafc; margin: 0; }

    /* ===== Top bar khusus Dokumentasi (terpisah dari header/bottom-nav aplikasi) ===== */
    .docs-topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 50;
      height: 64px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 10px;
      padding: 0 14px;
      background: #0f172a;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .docs-topbar-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .docs-topbar-logo { width: 34px; height: 34px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
    .docs-topbar-name { color: #fff; font-weight: 700; font-size: 15px; letter-spacing: 0.2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .docs-topbar-right { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .docs-icon-btn {
      width: 38px; height: 38px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.06);
      color: #cbd5e1;
      border: none; cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .docs-icon-btn:hover { background: rgba(255,255,255,0.12); color: #fff; }
    .docs-auth-btn {
      display: flex; align-items: center; gap: 6px;
      padding: 0 14px; height: 38px; border-radius: 10px;
      font-size: 12.5px; font-weight: 700;
      text-decoration: none; white-space: nowrap;
    }
    .docs-auth-btn.login { background: #2563eb; color: #fff; }
    .docs-auth-btn.login:hover { background: #1d4ed8; }
    .docs-auth-btn.logout { background: rgba(255,255,255,0.08); color: #fecaca; }
    .docs-auth-btn.logout:hover { background: rgba(255,255,255,0.14); }

    /* ===== Search box (muncul di bawah topbar saat ikon search ditekan) ===== */
    .docs-search-wrap {
      position: fixed; top: 64px; left: 0; right: 0; z-index: 49;
      background: #0f172a; border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 10px 14px;
      display: none;
    }
    .docs-search-wrap.open { display: block; }
    .docs-search-wrap input {
      width: 100%; height: 38px; border-radius: 10px; border: none;
      background: rgba(255,255,255,0.08); color: #fff; padding: 0 14px; font-size: 13px; outline: none;
    }
    .docs-search-wrap input::placeholder { color: #94a3b8; }

    /* ===== Sidebar ===== */
    .docs-shell { display: flex; padding-top: 64px; min-height: 100vh; }
    .docs-sidebar {
      width: 260px; flex-shrink: 0;
      background: #0f172a;
      border-right: 1px solid rgba(255,255,255,0.08);
      position: fixed; top: 64px; bottom: 0; left: 0; z-index: 45;
      overflow-y: auto;
      padding: 18px 12px 40px;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
    }
    .docs-sidebar.open { transform: translateX(0); }
    .docs-sidebar-overlay {
      position: fixed; inset: 0; top: 64px; z-index: 44;
      background: rgba(0,0,0,0.5);
      opacity: 0; pointer-events: none; transition: opacity 0.2s ease;
    }
    .docs-sidebar-overlay.open { opacity: 1; pointer-events: auto; }
    .docs-nav-title {
      font-size: 10.5px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase;
      color: #64748b; margin: 18px 8px 8px;
    }
    .docs-nav-title:first-child { margin-top: 4px; }
    .docs-nav-item {
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding: 9px 10px; border-radius: 10px; margin-bottom: 2px;
      font-size: 13px; font-weight: 600; color: #cbd5e1;
      text-decoration: none;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .docs-nav-item:hover { background: rgba(255,255,255,0.06); color: #fff; }
    .docs-nav-item.active { background: #1d4ed8; color: #fff; }
    .docs-nav-badge {
      font-size: 9.5px; font-weight: 800; padding: 2px 7px; border-radius: 999px;
      background: rgba(34,197,94,0.15); color: #4ade80; flex-shrink: 0;
    }

    @media (min-width: 1024px) {
      .docs-sidebar { transform: translateX(0); position: sticky; top: 64px; height: calc(100vh - 64px); }
      .docs-sidebar-overlay { display: none !important; }
      .docs-hamburger-btn { display: none; }
      .docs-shell { padding-top: 64px; }
      .docs-main { margin-left: 0; }
    }

    .docs-main { flex: 1; min-width: 0; }

    /* ===== Unduh JSON & Prompt AI: warna teks/latar selalu berpasangan eksplisit (tidak menyatu) ===== */
    .ai-box { background:#ffffff; color:#171717; border:2px solid #171717; border-radius:12px; padding:16px; }
    .ai-box, .ai-box p, .ai-box h2, .ai-box h3, .ai-box li, .ai-box b { color:#171717 !important; }
    .ai-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
    .ai-btn { display:inline-flex; align-items:center; gap:8px; padding:9px 14px; border-radius:10px; font-size:13px; font-weight:800; cursor:pointer; text-decoration:none;
      background:#edc531 !important; color:#171717 !important; border:2px solid #171717 !important; box-shadow:3px 3px 0 #171717; }
    .ai-btn:hover { transform:translate(1px,1px); box-shadow:2px 2px 0 #171717; }
    .ai-btn.alt { background:#ffffff !important; }
    .ai-btn i { color:#171717 !important; }
    .ai-card { background:#ffffff; border:2px solid #171717; border-radius:12px; margin-top:14px; overflow:hidden; }
    .ai-card-head { padding:12px 14px; border-bottom:2px solid #171717; background:#edc531; }
    .ai-card-head, .ai-card-head * { color:#171717 !important; }
    .ai-card-head h3 { margin:0; font-size:14px; font-weight:800; }
    .ai-card-head p { margin:2px 0 0; font-size:12.5px; font-weight:600; }
    .ai-card pre.ai-prompt-text { margin:0; padding:14px; background:#ffffff !important; color:#171717 !important; font-size:12.5px; line-height:1.6; font-weight:600;
      white-space:pre-wrap; word-break:break-word; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; max-height:260px; overflow:auto; }
    .ai-card-foot { display:flex; flex-wrap:wrap; gap:8px; padding:10px 14px; border-top:2px solid #171717; background:#ffffff; }
    /* Hilangkan garis/outline kuning di kotak kode dokumentasi */
    pre, .bg-gray-900 pre { border: none !important; outline: none !important; box-shadow: none !important; }
    /* Blok kode: selalu bisa digeser kiri-kanan di HP */
    .overflow-x-auto { -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; touch-action: pan-x pan-y; scrollbar-width: thin; }
    .overflow-x-auto > pre { display: inline-block; min-width: 100%; white-space: pre; margin: 0; }
  </style>
  <link rel="stylesheet" href="/docs-comic.css">
</head>
<body>

  <!-- ===== TOP BAR (khusus halaman Dokumentasi — tidak digabung dengan header/bottom-nav aplikasi) ===== -->
  <header class="docs-topbar">
    <div class="docs-topbar-left">
      <button type="button" class="docs-icon-btn docs-hamburger-btn" id="docsHamburgerBtn" onclick="toggleDocsSidebar()" aria-label="Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
      <a href="/" class="docs-topbar-left" style="text-decoration:none;">
        <% if (settings.logoUrl) { %><img src="<%= settings.logoUrl %>" alt="Logo" class="docs-topbar-logo"><% } %>
        <span class="docs-topbar-name"><%= settings.name %></span>
      </a>
    </div>
    <div class="docs-topbar-right">
      <button type="button" class="docs-icon-btn" onclick="toggleDocsSearch()" aria-label="Cari">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
      <a href="<%= (typeof user !== 'undefined' && user) ? (user.role === 'admin' ? '/admin/dashboard' : '/dashboard') : '/' %>" class="docs-icon-btn" aria-label="Dashboard">
        <i class="fa-solid fa-house"></i>
      </a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/logout" class="docs-auth-btn logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
      <% } else { %>
        <a href="/login" class="docs-auth-btn login"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
      <% } %>
    </div>
  </header>

  <div class="docs-search-wrap" id="docsSearchWrap">
    <input type="text" id="docsSearchInput" placeholder="Cari endpoint... (mis. withdraw, saldo, nokos)" oninput="filterDocsNav(this.value)">
  </div>

  <div class="docs-sidebar-overlay" id="docsSidebarOverlay" onclick="closeDocsSidebar()"></div>

  <div class="docs-shell">
    <aside class="docs-sidebar" id="docsSidebar">

      <div class="docs-nav-title">Mulai</div>
      <a href="#sec-persiapan" class="docs-nav-item" data-nav><i class="fa-solid fa-book w-4"></i>&nbsp; Persiapan</a>
      <a href="#sec-panduan" class="docs-nav-item" data-nav><i class="fa-solid fa-graduation-cap w-4"></i>&nbsp; Panduan Pemula</a>
      <a href="#sec-prompt-ai" class="docs-nav-item" data-nav><i class="fa-solid fa-wand-magic-sparkles w-4"></i>&nbsp; Unduh JSON &amp; Prompt AI</a>

      <div class="docs-nav-title">Saldo &amp; Topup</div>
      <a href="#sec-saldo" class="docs-nav-item" data-nav>Cek Saldo <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-invoice" class="docs-nav-item" data-nav>Buat Invoice <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-invoice-status" class="docs-nav-item" data-nav>Cek Status Invoice <span class="docs-nav-badge">GET</span></a>

      <div class="docs-nav-title">Penarikan</div>
      <a href="#sec-withdraw-methods" class="docs-nav-item" data-nav>Metode Withdraw <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-withdraw" class="docs-nav-item" data-nav>Melakukan Withdraw <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-withdraw-status" class="docs-nav-item" data-nav>Cek Status Withdraw <span class="docs-nav-badge">GET</span></a>

      <div class="docs-nav-title">Layanan</div>
      <a href="#sec-nokos" class="docs-nav-item" data-nav>Nokos (Nomor OTP) <span class="docs-nav-badge">GET/POST</span></a>
      <a href="#sec-gacha-nokos" class="docs-nav-item" data-nav>
        Gacha Nokos
        <% if (gachaNokosStatus === 'approved') { %><span class="docs-nav-badge">GET</span><% } else { %><i class="fa-solid fa-lock text-[10px] ml-1 text-gray-400"></i><% } %>
      </a>
      <a href="#sec-fix-no" class="docs-nav-item" data-nav>
        Fix No / Unban WA
        <% if (fixNoAccess) { %><span class="docs-nav-badge">POST</span><% } else { %><i class="fa-solid fa-lock text-[10px] ml-1 text-gray-400"></i><% } %>
      </a>
      <a href="#sec-pterodactyl" class="docs-nav-item" data-nav>Panel Hosting <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-premium" class="docs-nav-item" data-nav>Aplikasi Premium <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-sosmed" class="docs-nav-item" data-nav>Suntik Sosmed <span class="docs-nav-badge">GET</span></a>

      <div class="docs-nav-title">Produk &amp; Reseller</div>
      <a href="#sec-produk" class="docs-nav-item" data-nav>Produk <span class="docs-nav-badge">GET</span></a>
      <a href="#sec-panel-role" class="docs-nav-item" data-nav>Panel Role <span class="docs-nav-badge">GET</span></a>

    </aside>

    <main class="docs-main">
<section class="vc-card" data-comic-owned><h2>Voucher layanan</h2><p>Tambahkan parameter opsional <code>voucherCode=VOCHER10</code> pada API pembelian Nokos, Gacha Nokos, Panel, Premium, Sosmed, atau Produk. Kode dicek berdasarkan layanan dan waktu kedaluwarsa. Harga pesanan adalah total setelah diskon; rincian tersedia pada <code>originalPrice</code>, <code>discountAmount</code>, <code>voucherCode</code>, dan <code>voucherPercent</code>. Voucher tidak berlaku untuk top up, penarikan, atau transfer saldo.</p></section>


<div class="px-6 max-w-[480px] md:max-w-3xl mx-auto pb-4">

  <!-- Judul Halaman -->
  <div class="mb-6">
    <h1 class="text-base font-medium text-gray-800">Dokumentasi API</h1>
    <p class="text-[13.5px] font-medium text-gray-700">
      Panduan lengkap integrasi API pembayaran untuk platform atau aplikasi kamu.
    </p>
  </div>

  <!-- A. Persiapan -->
  <section class="mb-6" id="sec-persiapan">
    <h2 class="text-base font-medium text-gray-800">A. Persiapan</h2>
    <p class="text-[13.5px] font-medium text-gray-700 leading-relaxed">
      Langkah pertama yang harus kamu lakukan adalah mendaftar dan login ke dashboard. Setelah itu, dapatkan API Key kamu di menu Profil untuk mulai mengintegrasikan sistem pembayaran ke aplikasi kamu.
    </p>
  </section>

  <!-- A1. Panduan untuk Pemula -->
  <section class="mb-6 bg-white border border-gray-200 rounded-md p-4" id="sec-panduan">
    <h2 class="text-base mb-2 font-medium text-gray-800">📘 Panduan Cepat untuk Pemula</h2>
    <p class="text-[13.5px] font-medium text-gray-700 leading-relaxed mb-3">
      Belum pernah pakai API sebelumnya? Tenang, semua endpoint di dokumentasi ini pakai <b>method GET</b> — jadi bisa langsung dicoba lewat browser dengan cara paste URL-nya, tidak wajib nulis kode dulu. Beberapa hal penting yang perlu kamu tahu:
    </p>
    <ul class="list-disc list-inside text-[13.5px] text-gray-700 ml-1 font-medium leading-relaxed space-y-1.5 mb-3">
      <li><b>Base URL</b> = alamat website kamu sendiri (otomatis muncul di tiap contoh kode di bawah, ganti <span class="text-blue-600">BASE_URL</span> kalau kamu salin manual).</li>
      <li><b>API Key</b> = "kunci" biar sistem tahu itu kamu. Ambil di menu Profil, lalu tempel di parameter <span class="text-blue-600">apikey</span> pada setiap request. <b>Jangan pernah share API Key ke orang lain</b>, siapa saja yang pegang API Key kamu bisa transaksi pakai saldo kamu.</li>
      <li>Endpoint GET memakai parameter URL (query string), contoh: <span class="text-blue-600">?apikey=XXXX&amp;amount=50000</span>.</li>
      <li><b>Format respons sukses</b> biasanya: <span class="text-blue-600">{ "success": true, "data": {...} }</span></li>
      <li><b>Format respons gagal</b> biasanya: <span class="text-blue-600">{ "success": false, "error": "pesan errornya" }</span> — selalu cek dulu field <span class="text-blue-600">success</span>/<span class="text-blue-600">error</span> sebelum lanjut proses data-nya.</li>
      <li>Beberapa fitur (Nokos, Beli Panel, Aplikasi Premium) punya <b>beberapa langkah berurutan</b> (mis. pilih layanan → pilih negara → beli, atau pilih produk → beli → cek status), jadi endpoint-nya harus dipanggil satu-satu sesuai urutan, bukan sekali panggil langsung jadi.</li>
      <li>Tiap contoh kode di bawah ada pilihan bahasa (Node.js / Python / cURL / PHP) — klik tab-nya buat lihat versi yang kamu pakai. Kalau baru belajar, cURL paling gampang dicoba langsung dari terminal/CMD tanpa install apa-apa.</li>
    </ul>
    <p class="text-[13.5px] font-medium text-gray-700 leading-relaxed">
      Kalau masih bingung, bisa hubungi <span class="text-blue-600">CS Bantuan</span> di dashboard buat ditemenin nyoba step-by-step.
    </p>
  </section>

  <!-- A2. Unduh JSON & Prompt AI -->
  <section class="mb-6" id="sec-prompt-ai">
    <div class="ai-box">
      <h2 class="text-base mb-1 font-medium">🤖 Unduh Dokumentasi (.json) &amp; Prompt AI</h2>
      <p class="text-[13.5px] font-medium leading-relaxed">
        Seluruh dokumentasi endpoint tersedia dalam satu file JSON (parameter, contoh request/response, webhook). Unduh, lalu tempelkan ke AI bersama prompt di bawah untuk dibuatkan payment gateway seperti ini.
      </p>
      <div class="ai-actions">
        <a class="ai-btn" href="/docs.json?download=1" download="averpay-api-docs.json"><i class="fa-solid fa-download"></i> Unduh .json</a>
        <a class="ai-btn alt" href="/docs.json" target="_blank" rel="noopener"><i class="fa-solid fa-eye"></i> Lihat JSON</a>
        <button type="button" class="ai-btn alt" onclick="copyText(location.origin + '/docs.json', this, 'Link Tersalin')"><i class="fa-solid fa-link"></i> Salin Link JSON</button>
      </div>
    </div>

    <% (typeof aiPrompts !== 'undefined' ? aiPrompts : []).forEach(function (ap) { %>
    <div class="ai-card">
      <div class="ai-card-head">
        <h3><%= ap.title %></h3>
        <p><%= ap.description %></p>
      </div>
      <pre class="ai-prompt-text" data-prompt-id="<%= ap.id %>"><%= ap.prompt %></pre>
      <div class="ai-card-foot">
        <button type="button" class="ai-btn" onclick="copyPromptEl(this)"><i class="far fa-copy"></i> Salin Prompt</button>
        <button type="button" class="ai-btn alt" onclick="copyPromptWithSpec(this)"><i class="fa-solid fa-file-code"></i> Salin Prompt + JSON</button>
      </div>
    </div>
    <% }); %>
    <p class="text-[12.5px] font-medium mt-3 leading-relaxed" style="color:#171717;">
      Tips: kalau AI kamu tidak bisa membuka link, pakai tombol <b>Salin Prompt + JSON</b> supaya dokumentasinya ikut tertempel. Bagian dalam kurung siku <b>[ISI: ...]</b> ganti sesuai kebutuhanmu.
    </p>
  </section>

  <!-- B. Cek Saldo -->
  <section class="mb-6" id="sec-saldo">
    <h2 class="text-base mb-1 font-medium text-gray-800">B. Cek Saldo (Balance)</h2>

    <ul class="list-disc list-inside text-[13.5px] text-gray-700 ml-1 font-medium mb-4">
      <li>Method: <span class="text-blue-600 font-medium">GET</span></li>
      <li>URL: <span id="urlBalance" class="text-blue-600 text-[13.5px]">/api/balance</span></li>
    </ul>

    <p class="text-[13.5px] text-gray-800 font-medium mb-2">Parameter:</p>
    <ul class="list-disc list-inside text-[13.5px] text-gray-700 ml-4 font-medium mb-5">
      <li><span class="text-blue-600 text-[13.5px]">apikey</span> (string, wajib)</li>
    </ul>

    <p class="text-[13.5px] text-gray-800 font-medium mb-2">Contoh Request:</p>
    <div class="bg-white border border-gray-300 rounded-md overflow-hidden mb-4" data-code-switcher>
      <div class="flex bg-gray-100 border-b border-gray-300 px-1 pt-1 overflow-x-scroll gap-1">
        <button onclick="switchCodeTab(this, 'nodejs')" data-lang="nodejs" class="code-tab active flex items-center gap-1.5 px-3 py-1.5 text-[13.5px] font-medium rounded-t-sm bg-white border border-b-0 border-gray-300 text-gray-800 -mb-px relative z-10">
          <i class="fab fa-node-js text-green-600 text-sm"></i> Node.js
        </button>
        <button onclick="switchCodeTab(this, 'python')" data-lang="python" class="code-tab flex items-center gap-1.5 px-3 py-1.5 text-[13.5px] font-medium rounded-t-sm text-gray-500 hover:text-gray-700 border border-transparent">
          <i class="fab fa-python text-blue-500 text-sm"></i> Python
        </button>
        <button onclick="switchCodeTab(this, 'curl')" data-lang="curl" class="code-tab flex items-center gap-1.5 px-3 py-1.5 text-[13.5px] font-medium rounded-t-sm text-gray-500 hover:text-gray-700 border border-transparent">
          <i class="fas fa-terminal text-gray-500 text-sm"></i> cURL
        </button>
        <button onclick="switchCodeTab(this, 'php')" data-lang="php" class="code-tab flex items-center gap-1.5 px-3 py-1.5 text-[13.5px] font-medium rounded-t-sm text-gray-500 hover:text-gray-700 border border-transparent">
          <i class="fab fa-php text-indigo-500 text-sm"></i> PHP
        </button>
      </div>
      <div class="relative bg-gray-50 p-3 group">
        <button onclick="copyCode(this)" class="absolute top-3 right-3 text-gray-400 hover:text-gray-700 bg-transparent border-none cursor-pointer z-10" title="Salin">
          <i class="far fa-copy text-sm"></i>
        </button>
        <pre class="text-[13.5px] text-gray-800 font-medium leading-relaxed"><code class="copy-content" data-code="nodejs">const axios = require('axios');
axios.get('<span class="base-url-placeholder">BASE_URL</span>/api/balance?apikey=YOUR_API_KEY')
  .then(response => console.log(response.data));

/*
Contoh response:
{
  "username": "your_username", 
  "email": "name@gmail.com", 
  "balance": 150000
}
*/</code><code class="copy-content hidden" data-code="python">import requests
response = requests.get('<span class="base-url-placeholder">BASE_URL</span>/api/balance?apikey=YOUR_API_KEY')
print(response.json())

"""
Contoh response:
{
  "username": "your_username", 
  "email": "name@gmail.com", 
  "balance": 150000
}
"""</code><code class="copy-content hidden" data-code="curl">curl -X GET '<span class="base-url-placeholder">BASE_URL</span>/api/balance?apikey=YOUR_API_KEY'

# Contoh response:
# {
#   "balance": 150000
# }</code><code class="copy-content hidden" data-code="php">&lt;?php
$response = file_get_contents('<span class="base-url-placeholder">BASE_URL</span>/api/balance?apikey=YOUR_API_KEY');
echo $response;

/*
Contoh response:
{
  "username": "your_username", 
  "email": "name@gmail.com", 
  "balance": 150000
