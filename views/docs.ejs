  document.getElementById('urlNokosStatus').textContent = baseUrl + '/api/nokos/status';
  document.getElementById('urlPteroPanels').textContent = baseUrl + '/api/pterodactyl/panels';
  document.getElementById('urlPteroPackages').textContent = baseUrl + '/api/pterodactyl/packages';
  document.getElementById('urlPteroEggs').textContent = baseUrl + '/api/pterodactyl/eggs';
  document.getElementById('urlPteroOrder').textContent = baseUrl + '/api/pterodactyl/order';
  document.getElementById('urlPteroStatus').textContent = baseUrl + '/api/pterodactyl/status';
  document.getElementById('urlPteroClaim').textContent = baseUrl + '/api/pterodactyl/claim-warranty';
  document.getElementById('urlPremiumProducts').textContent = baseUrl + '/api/premium/products';
  document.getElementById('urlPremiumStock').textContent = baseUrl + '/api/premium/stock';
  document.getElementById('urlPremiumOrder').textContent = baseUrl + '/api/premium/order';
  document.getElementById('urlPremiumStatus').textContent = baseUrl + '/api/premium/status';
  document.getElementById('urlSosmedServices').textContent = baseUrl + '/api/sosmed/services';
  document.getElementById('urlSosmedOrder').textContent = baseUrl + '/api/sosmed/order';
  document.getElementById('urlSosmedStatus').textContent = baseUrl + '/api/sosmed/status';
  document.getElementById('urlSosmedRefill').textContent = baseUrl + '/api/sosmed/refill';
  document.getElementById('urlSosmedRefillStatus').textContent = baseUrl + '/api/sosmed/refill/status';
  document.getElementById('urlProdukList').textContent = baseUrl + '/api/produk/list';
  document.getElementById('urlProdukBeli').textContent = baseUrl + '/api/produk/beli';
  document.getElementById('urlProdukStatus').textContent = baseUrl + '/api/produk/status';
  document.getElementById('urlPanelServers').textContent = baseUrl + '/api/panel/servers';
  document.getElementById('urlPanelEggs').textContent = baseUrl + '/api/panel/eggs';
  document.getElementById('urlPanelAddServer').textContent = baseUrl + '/api/panel/add-server';
  document.getElementById('urlPanelCreateAdmin').textContent = baseUrl + '/api/panel/create-admin';

  // ===== Prompt AI: isi token {{BASE_URL}}/{{SPEC_URL}} dengan alamat situs ini =====
  document.querySelectorAll('.ai-prompt-text').forEach(el => {
    el.textContent = el.textContent.replace(/\{\{BASE_URL\}\}/g, baseUrl).replace(/\{\{SPEC_URL\}\}/g, baseUrl + '/docs.json');
  });

  function copyText(text, btn, doneLabel) {
    const label = btn.innerHTML;
    const done = () => {
      btn.innerHTML = '<i class="fa-solid fa-check"></i> ' + (doneLabel || 'Tersalin');
      setTimeout(() => { btn.innerHTML = label; }, 1600);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
    } else { fallbackCopy(text, done); }
  }
  function fallbackCopy(text, done) {
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta); done();
  }
  function copyPromptEl(btn) {
    const pre = btn.closest('.ai-card').querySelector('.ai-prompt-text');
    copyText(pre.textContent, btn, 'Prompt Tersalin');
  }
  async function copyPromptWithSpec(btn) {
    const pre = btn.closest('.ai-card').querySelector('.ai-prompt-text');
    let spec = '';
    try { spec = await (await fetch('/docs.json')).text(); } catch (e) { spec = '(gagal memuat JSON, buka ' + baseUrl + '/docs.json)'; }
    copyText(pre.textContent + '\n\n=== DOKUMENTASI API (JSON) ===\n' + spec, btn, 'Prompt + JSON Tersalin');
  }

  // Replace all BASE_URL placeholders in code blocks
  document.querySelectorAll('.base-url-placeholder').forEach(el => {
    el.textContent = baseUrl;
  });

  function switchCodeTab(btn, lang) {
    const switcher = btn.closest('[data-code-switcher]');
    if (!switcher) return;

    switcher.querySelectorAll('.code-tab').forEach(tab => {
      tab.classList.remove('active', 'bg-white', 'border', 'border-b-0', 'border-gray-300', 'text-gray-800', '-mb-px', 'relative', 'z-10');
      tab.classList.add('text-gray-500', 'border-transparent');
    });

    btn.classList.add('active', 'bg-white', 'border', 'border-b-0', 'border-gray-300', 'text-gray-800', '-mb-px', 'relative', 'z-10');
    btn.classList.remove('text-gray-500', 'border-transparent');

    switcher.querySelectorAll('.copy-content[data-code]').forEach(code => {
      if (code.getAttribute('data-code') === lang) {
        code.classList.remove('hidden');
      } else {
        code.classList.add('hidden');
      }
    });
  }

  function copyCode(btn) {
    const container = btn.closest('[data-code-switcher]') || btn.closest('.relative');
    let codeElement = null;

    if (container && container.hasAttribute('data-code-switcher')) {
      codeElement = container.querySelector('.copy-content:not(.hidden)');
    } else {
      codeElement = container ? container.querySelector('.copy-content') : null;
    }

    const text = codeElement ? (codeElement.innerText || codeElement.textContent) : '';
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = 'fas fa-check text-sm text-green-500';
        setTimeout(() => { icon.className = 'far fa-copy text-sm'; }, 1500);
      }
    }).catch(() => {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = 'fas fa-check text-sm text-green-500';
        setTimeout(() => { icon.className = 'far fa-copy text-sm'; }, 1500);
      }
    });
  }

  // ===== Sidebar (off-canvas di mobile, selalu terlihat di desktop) =====
  function toggleDocsSidebar() {
    document.getElementById('docsSidebar').classList.toggle('open');
    document.getElementById('docsSidebarOverlay').classList.toggle('open');
  }
  function closeDocsSidebar() {
    document.getElementById('docsSidebar').classList.remove('open');
    document.getElementById('docsSidebarOverlay').classList.remove('open');
  }

  // ===== Search box di top bar: filter link-link di sidebar =====
  function toggleDocsSearch() {
    const wrap = document.getElementById('docsSearchWrap');
    wrap.classList.toggle('open');
    if (wrap.classList.contains('open')) {
      document.getElementById('docsSearchInput').focus();
    } else {
      document.getElementById('docsSearchInput').value = '';
      filterDocsNav('');
    }
  }
  function filterDocsNav(query) {
    const q = query.trim().toLowerCase();
    document.querySelectorAll('.docs-nav-item').forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
  }

  // ===== Highlight menu sidebar sesuai section yang lagi kelihatan (scrollspy) =====
  (function() {
    const navItems = Array.from(document.querySelectorAll('.docs-nav-item[data-nav]'));
    const sections = navItems
      .map(a => document.querySelector(a.getAttribute('href')))
      .filter(Boolean);
    if (!sections.length) return;

    function setActive(id) {
      navItems.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + id));
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    sections.forEach(sec => observer.observe(sec));

    // Klik menu sidebar: tutup sidebar (di mobile) supaya konten kelihatan
    navItems.forEach(a => a.addEventListener('click', () => {
      if (window.innerWidth < 1024) closeDocsSidebar();
    }));
  })();
</script>

