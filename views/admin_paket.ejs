<%- include('partials/header', { title: 'Kelola Paket' }) %>

<style>
  /* ===== Halaman Paket =====
     Semua elemen memakai warna SOLID + border hitam tebal + bayangan keras, jadi tidak pernah
     menyatu dengan background biru / krem / foto. Pakai kelas pk-* (bukan utilitas bg-*/border-*
     Tailwind) supaya tidak ketimpa aturan global comic-theme.css. */
  .pk-wrap { color: #14120f; }
  .pk-card {
    background: #ffffff; border: 3px solid #14120f; border-radius: 18px;
    box-shadow: 5px 5px 0 #14120f; overflow: hidden; margin-bottom: 18px;
  }
  .pk-card-head {
    background: #ffd400; border-bottom: 3px solid #14120f; padding: 12px 16px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .pk-card-title { font-size: 16px; font-weight: 800; color: #14120f; margin: 0; flex: 1 1 auto; min-width: 0; word-break: break-word; }
  .pk-card-body { padding: 16px; }

  .pk-hero { background: #14120f; border: 3px solid #14120f; border-radius: 18px; box-shadow: 5px 5px 0 #ffd400; padding: 16px; margin-bottom: 18px; }
  .pk-hero h1 { font-family: 'Bangers', 'Baloo 2', sans-serif; font-size: 26px; letter-spacing: 1px; color: #ffd400; margin: 0 0 4px; }
  .pk-hero p { color: #ffffff; font-size: 12.5px; font-weight: 600; line-height: 1.5; margin: 0 0 12px; }

  .pk-flash { border: 3px solid #14120f; border-radius: 14px; padding: 11px 14px; margin-bottom: 14px; font-size: 13px; font-weight: 700; box-shadow: 4px 4px 0 #14120f; }
  .pk-flash.ok { background: #bbf7d0; color: #14120f; }
  .pk-flash.err { background: #fecaca; color: #14120f; }

  .pk-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border: 2px solid #14120f; border-radius: 999px; font-size: 10.5px; font-weight: 800; white-space: nowrap; }
  .pk-badge.default { background: #14120f; color: #ffd400; }
  .pk-badge.on { background: #22c55e; color: #14120f; }
  .pk-badge.off { background: #d1d5db; color: #14120f; }
  .pk-badge.users { background: #ffffff; color: #14120f; }

  .pk-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  .pk-chip { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; background: #fff7cc; border: 2px solid #14120f; border-radius: 10px; font-size: 11.5px; font-weight: 800; color: #14120f; }
  .pk-chip b { font-weight: 800; }
  .pk-chip.role { background: #14120f; color: #ffd400; }
  .pk-chip.free { background: #bbf7d0; }

  .pk-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 9px 14px; border: 2.5px solid #14120f; border-radius: 12px; font-size: 12.5px; font-weight: 800; cursor: pointer; box-shadow: 3px 3px 0 #14120f; transition: transform .12s ease, box-shadow .12s ease; color: #14120f; background: #ffffff; }
  .pk-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #14120f; }
  .pk-btn.yellow { background: #ffd400; }
  .pk-btn.green { background: #22c55e; }
  .pk-btn.red { background: #ef2b2d; color: #ffffff; }
  .pk-btn.dark { background: #14120f; color: #ffd400; }
  .pk-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pk-actions form { margin: 0; }
  .pk-actions .pk-btn { width: 100%; }

  .pk-panel { display: none; margin-top: 14px; padding-top: 14px; border-top: 3px dashed #14120f; }
  .pk-panel.open { display: block; }

  /* ----- form ----- */
  .pk-form { display: block; }
  .pk-field { margin-bottom: 12px; }
  .pk-label { display: block; font-size: 12.5px; font-weight: 800; color: #14120f; margin-bottom: 6px; }
  .pk-req { color: #b3161c; }
  .pk-input {
    width: 100%; background: #ffffff; color: #14120f; border: 2.5px solid #14120f; border-radius: 12px;
    padding: 10px 12px; font-size: 14px; font-weight: 700; outline: none; box-sizing: border-box; min-width: 0;
  }
  .pk-input::placeholder { color: #6b7280; font-weight: 600; }
  .pk-input:focus { box-shadow: 0 0 0 3px #ffb703; }
  select.pk-input { appearance: auto; }

  .pk-toggles { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
  .pk-toggle-line { display: flex; align-items: center; gap: 12px; background: #fff7cc; border: 2.5px solid #14120f; border-radius: 14px; padding: 10px 12px; cursor: pointer; }
  .pk-toggle-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pk-toggle-text b { font-size: 13px; font-weight: 800; color: #14120f; }
  .pk-toggle-text small { font-size: 11px; font-weight: 600; color: #374151; line-height: 1.4; }

  .pk-sec { display: inline-flex; align-items: center; gap: 8px; background: #14120f; color: #ffd400; border-radius: 10px; padding: 6px 12px; font-size: 13px; font-weight: 800; margin: 6px 0 8px; }
  .pk-note { font-size: 11.5px; font-weight: 600; color: #374151; line-height: 1.5; margin: 0 0 10px; }
  .pk-note b { color: #14120f; }

  .pk-row { background: #fff7cc; border: 2.5px solid #14120f; border-radius: 14px; padding: 12px; margin-bottom: 12px; box-shadow: 3px 3px 0 #14120f; }
  .pk-row-top { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
  .pk-ico { flex: 0 0 auto; width: 36px; height: 36px; border: 2.5px solid #14120f; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 15px; }
  .pk-row-text { min-width: 0; }
  .pk-row-title { font-size: 13.5px; font-weight: 800; color: #14120f; margin: 0; }
  .pk-row-sub { font-size: 11px; font-weight: 600; color: #374151; line-height: 1.4; margin: 2px 0 0; }
  .pk-ctrl { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .pk-val { display: block; }

  .pk-pill { display: none; padding: 4px 10px; border: 2px solid #14120f; border-radius: 999px; font-size: 11px; font-weight: 800; color: #14120f; }
  .pk-pill-on { background: #22c55e; }
  .pk-pill-off { background: #ffffff; }
  .pk-row.is-percent .pk-fee-ctrl .pk-pill-on, .pk-row.is-on .pk-pill-on { display: inline-block; }
  .pk-benefit .pk-ben-on { background: #22c55e; }
  .pk-benefit .pk-ben-off { background: #ffffff; }
  .pk-row:not(.is-off) .pk-ben-on { display: inline-block; }
  .pk-row.is-off .pk-ben-off { display: inline-block; }
  .pk-row.is-off { background: #f3f4f6; }
  .pk-row.is-off .pk-fee-ctrl, .pk-row.is-off .pk-fee-val { opacity: .4; pointer-events: none; }
  .pk-row:not(.is-percent):not(.is-on) .pk-fee-ctrl .pk-pill-off, .pk-row[data-pk-role]:not(.is-on) .pk-pill-off { display: inline-block; }

  .pk-inputwrap { display: flex; align-items: center; gap: 8px; }
  .pk-unit { flex: 0 0 auto; background: #14120f; color: #ffd400; border-radius: 8px; padding: 8px 10px; font-size: 12px; font-weight: 800; white-space: nowrap; }
  .pk-row[data-pk-fee] .pk-show-percent { display: none; }
  .pk-row[data-pk-fee].is-percent .pk-show-percent { display: flex; }
  .pk-row[data-pk-fee].is-percent .pk-show-fixed { display: none; }
  .pk-row[data-pk-fee]:not(.is-percent) .pk-show-fixed { display: flex; }
  .pk-row[data-pk-role] .pk-show-on { display: none; }
  .pk-row[data-pk-role].is-on .pk-show-on { display: block; }

  /* ----- toggle switch: OFF abu-abu gelap, ON hijau terang, knob putih, semua ber-border hitam ----- */
  .pk-switch { position: relative; display: inline-block; flex: 0 0 auto; width: 58px; height: 32px; }
  .pk-switch input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; z-index: 2; }
  .pk-track { position: absolute; inset: 0; background: #6b7280; border: 3px solid #14120f; border-radius: 999px; transition: background .15s ease; }
  .pk-knob { position: absolute; top: 50%; left: 3px; width: 20px; height: 20px; margin-top: -10px; background: #ffffff; border: 2.5px solid #14120f; border-radius: 50%; transition: left .15s ease; }
  .pk-switch input:checked ~ .pk-track { background: #22c55e; }
  .pk-switch input:checked ~ .pk-track .pk-knob { left: 29px; }
  .pk-switch input:focus-visible ~ .pk-track { box-shadow: 0 0 0 3px #ffb703; }

  .pk-submit { display: flex; width: 100%; align-items: center; justify-content: center; gap: 8px; padding: 13px 16px; border-radius: 14px; font-size: 14px; margin-top: 6px; cursor: pointer; }

  /* ----- pengguna paket ----- */
  .pk-userlist { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .pk-user { display: inline-flex; align-items: center; gap: 6px; background: #ffffff; border: 2px solid #14120f; border-radius: 999px; padding: 3px 4px 3px 11px; font-size: 12px; font-weight: 800; color: #14120f; }
  .pk-user form { margin: 0; }
  .pk-user button { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #14120f; background: #ef2b2d; color: #ffffff; font-size: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  .pk-empty { background: #ffffff; border: 3px solid #14120f; border-radius: 18px; box-shadow: 5px 5px 0 #14120f; padding: 28px 16px; text-align: center; font-size: 13.5px; font-weight: 800; color: #14120f; }
</style>

<div class="max-w-3xl mx-auto px-6 mt-1 pb-10 pk-wrap">

  <div class="pk-hero">
    <h1>Kelola Paket</h1>
    <p>Atur biaya admin tiap layanan (persen atau nominal), role payment &amp; role panel dalam satu paket, lalu pasang ke user. Nilai 0 = tanpa biaya admin.</p>
    <button type="button" class="pk-btn yellow" onclick="pkTogglePanel('pk-new')"><i class="fa-solid fa-plus"></i> Buat Paket Baru</button>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="pk-flash ok"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="pk-flash err"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <!-- ===== BUAT PAKET ===== -->
  <div id="pk-new" class="pk-card" style="display:none">
    <div class="pk-card-head">
      <i class="fa-solid fa-gem"></i>
      <h2 class="pk-card-title">Buat Paket Baru</h2>
    </div>
    <div class="pk-card-body">
      <%- include('partials/paket_form', { p: null, idp: 'new', action: '/admin/paket', submitLabel: 'Buat Paket' }) %>
    </div>
  </div>

  <!-- ===== DAFTAR PAKET ===== -->
  <% if (pakets.length === 0) { %>
    <div class="pk-empty">Belum ada paket. Klik &ldquo;Buat Paket Baru&rdquo; di atas.</div>
  <% } else { %>
    <%
      const fmt = (n) => Number(n || 0).toLocaleString('id-ID');
      const roleName = { user: 'User', vip: 'VIP', merchant: 'Merchant', reseller: 'Seller', adminpanel: 'Admin Panel' };
      const feeLabels = [['deposit', 'Deposit'], ['withdraw', 'Tarik'], ['nokos', 'Nokos'], ['panel', 'Panel'], ['smm', 'SMM'], ['produk', 'Produk'], ['aplikasi', 'Aplikasi']];
    %>
    <% pakets.forEach(function(pk, idx) { %>
      <div class="pk-card">
        <div class="pk-card-head">
          <h2 class="pk-card-title"><%= pk.name %></h2>
          <% if (pk.isDefault) { %><span class="pk-badge default"><i class="fa-solid fa-star"></i> DEFAULT</span><% } %>
          <span class="pk-badge <%= pk.active ? 'on' : 'off' %>"><%= pk.active ? 'AKTIF' : 'NONAKTIF' %></span>
          <span class="pk-badge users"><i class="fa-solid fa-users"></i> <%= pk.userCount %></span>
          <% if (pk.price > 0 && !pk.isDefault) { %><span class="pk-badge on"><i class="fa-solid fa-cart-shopping"></i> Rp <%= Number(pk.price).toLocaleString('id-ID') %> · <%= pk.durationDays > 0 ? pk.durationDays + ' hari' : 'Permanen' %></span><% } %>
        </div>
        <div class="pk-card-body">
          <% if (pk.description) { %><p class="pk-note" style="margin-bottom:0"><%= pk.description %></p><% } %>

          <div class="pk-chips">
            <% feeLabels.forEach(function(fl) {
                 const r = pk[fl[0]] || {};
                 const off = r.enabled === false;
                 const isPct = r.mode === 'percent';
                 const val = isPct ? Number(r.percent || 0) : Number(r.fixed || 0);
                 const free = !off && val === 0;
                 const txt = off ? 'OFF' : (free ? 'Gratis' : (isPct ? val + '%' : 'Rp ' + fmt(val) + (fl[0] === 'smm' ? '/1000' : '')));
            %>
              <span class="pk-chip <%= free ? 'free' : '' %>" <%- off ? 'style="opacity:.55"' : '' %>><%= fl[1] %> <b><%= txt %></b></span>
            <% }); %>
            <span class="pk-chip role"><i class="fa-solid fa-crown"></i> Payment: <%= (pk.rolePayment && pk.rolePayment.enabled) ? roleName[pk.rolePayment.role] : 'OFF' %></span>
            <span class="pk-chip role"><i class="fa-solid fa-store"></i> Panel: <%= (pk.rolePanel && pk.rolePanel.enabled) ? roleName[pk.rolePanel.role] : 'OFF' %></span>
            <% if (pk.gachaNokosAccess) { %><span class="pk-chip role"><i class="fa-solid fa-dice"></i> Gacha Nokos: ON</span><% } %>
            <% if (pk.fixNoAccess) { %><span class="pk-chip role"><i class="fa-solid fa-wrench"></i> Fix No: ON</span><% } %>
          </div>

          <div class="pk-actions">
            <button type="button" class="pk-btn yellow" onclick="pkTogglePanel('pk-edit-<%= idx %>')"><i class="fa-solid fa-pen"></i> Edit</button>
            <button type="button" class="pk-btn" onclick="pkTogglePanel('pk-users-<%= idx %>')"><i class="fa-solid fa-user-plus"></i> Pengguna</button>
            <form method="POST" action="/admin/paket/<%= pk._id %>/toggle">
              <button type="submit" class="pk-btn <%= pk.active ? 'dark' : 'green' %>"><i class="fa-solid <%= pk.active ? 'fa-eye-slash' : 'fa-eye' %>"></i> <%= pk.active ? 'Nonaktifkan' : 'Aktifkan' %></button>
            </form>
            <form method="POST" action="/admin/paket/<%= pk._id %>/delete" onsubmit="return confirm('Hapus paket ini? Paket dilepas dari semua user dan role dari paket ini dikembalikan ke User.');">
              <button type="submit" class="pk-btn red"><i class="fa-solid fa-trash"></i> Hapus</button>
            </form>
          </div>

          <div id="pk-edit-<%= idx %>" class="pk-panel">
            <p class="pk-note">Perubahan role langsung diterapkan ke semua user yang memakai paket ini.</p>
            <%- include('partials/paket_form', { p: pk, idp: 'e' + idx, action: '/admin/paket/' + pk._id + '/edit', submitLabel: 'Simpan Perubahan' }) %>
          </div>

          <div id="pk-users-<%= idx %>" class="pk-panel">
            <form method="POST" action="/admin/paket/<%= pk._id %>/assign">
              <label class="pk-label" for="pk-assign-<%= idx %>">Pasang ke user (username, pisahkan spasi / koma / baris baru)</label>
              <textarea id="pk-assign-<%= idx %>" name="usernames" rows="2" class="pk-input" placeholder="cth: budi123 sari88" style="resize:vertical"></textarea>
              <label class="pk-label" for="pk-expires-<%= idx %>" style="margin-top:10px">Tanggal Expired (opsional, kosongkan = permanen)</label>
              <input type="date" id="pk-expires-<%= idx %>" name="expiresAt" class="pk-input">
              <button type="submit" class="pk-btn green" style="margin-top:10px"><i class="fa-solid fa-check"></i> Pasang Paket</button>
            </form>

            <p class="pk-label" style="margin-top:16px">Pengguna paket ini (<%= pk.userCount %>)</p>
            <% if (pk.users.length === 0) { %>
              <p class="pk-note">Belum ada user yang dipasangi paket ini.</p>
            <% } else { %>
              <div class="pk-userlist">
                <% pk.users.forEach(function(u) { %>
                  <span class="pk-user"><%= u.username %><%= u.paketExpiresAt ? ' · s.d. ' + new Date(u.paketExpiresAt).toLocaleDateString('id-ID') : '' %>
                    <form method="POST" action="/admin/paket/<%= pk._id %>/unassign" onsubmit="return confirm('Lepas paket dari <%= u.username %>?');">
                      <input type="hidden" name="userId" value="<%= u._id %>">
                      <button type="submit" aria-label="Lepas paket dari <%= u.username %>"><i class="fa-solid fa-xmark"></i></button>
                    </form>
                  </span>
                <% }); %>
              </div>
              <% if (pk.userCount > pk.users.length) { %>
                <p class="pk-note" style="margin-top:8px">Menampilkan <%= pk.users.length %> dari <%= pk.userCount %> user. Sisanya bisa diatur dari menu Kelola User.</p>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="pk-card">
    <div class="pk-card-head"><i class="fa-solid fa-circle-info"></i><h2 class="pk-card-title">Aturan main</h2></div>
    <div class="pk-card-body">
      <p class="pk-note" style="margin:0 0 6px">&bull; Paket yang dipasang ke user dipakai lebih dulu. Kalau user tidak punya paket, dipakai <b>Paket Default</b> (kalau ada). Kalau tidak ada keduanya, biaya bawaan sistem tetap berlaku.</p>
      <p class="pk-note" style="margin:0 0 6px">&bull; Paket Default untuk deposit &amp; withdraw hanya berlaku untuk role User biasa. VIP dan Merchant hanya kena paket kalau dipasang langsung.</p>
      <p class="pk-note" style="margin:0 0 6px">&bull; Nokos, SMM, dan Aplikasi: biaya paket menggantikan markup global. Panel dan Produk: biaya ditambahkan di atas harga.</p>
      <p class="pk-note" style="margin:0">&bull; Deposit lewat QRIS admin: kalau nominal total sama dengan deposit lain yang masih pending, biaya naik Rp 1 supaya pembayaran tidak tertukar.</p>
    </div>
  </div>

</div>

<script>
  function pkTogglePanel(id) {
    var el = document.getElementById(id);
    if (!el) return;
    if (el.classList.contains('pk-panel')) {
      el.classList.toggle('open');
    } else {
      el.style.display = (el.style.display === 'none' || !el.style.display) ? 'block' : 'none';
      if (el.style.display === 'block') el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  // Toggle persen/nominal & toggle role: ganti kelas pada baris terkait.
  document.addEventListener('change', function (e) {
    var t = e.target;
    if (!t || !t.matches) return;
    if (t.matches('input[data-pk-benefit]')) {
      var rowb = t.closest('.pk-row');
      if (rowb) rowb.classList.toggle('is-off', !t.checked);
    } else if (t.matches('input[data-pk-mode]')) {
      var row = t.closest('.pk-row');
      if (row) row.classList.toggle('is-percent', t.checked);
    } else if (t.matches('input[data-pk-roleswitch]')) {
      var row2 = t.closest('.pk-row');
      if (row2) row2.classList.toggle('is-on', t.checked);
    }
  });
</script>

<%- include('partials/footer') %>
