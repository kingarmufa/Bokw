<%- include('partials/header', { title: 'Detail Produk' }) %>

<div class="max-w-lg mx-auto px-4 pt-4 pb-28">

  <div class="flex items-center gap-2 mb-4">
    <a href="/produk/riwayat" class="w-9 h-9 rounded-xl border-2 border-black bg-white flex items-center justify-center shadow-[2px_2px_0_#14120f]">
      <i class="fa-solid fa-arrow-left text-sm"></i>
    </a>
    <h1 class="text-lg font-extrabold">Detail Produk</h1>
  </div>
  <%- include('partials/voucher_receipt', { order }) %>


  <!-- Ringkasan -->
  <div class="comic-panel mb-4">
    <div class="comic-panel-head">
      <i class="fa-solid fa-box text-base"></i>
      <span><%= order.produkName %></span>
    </div>
    <div class="p-4 text-[12.5px] font-medium text-gray-700 flex flex-col gap-1.5">
      <div class="flex justify-between"><span class="text-gray-500">Tipe</span>
        <span class="font-bold"><%= order.fullUp ? 'Full Up (dapat link Group)' : 'Tidak Full Up' %></span>
      </div>
      <div class="flex justify-between"><span class="text-gray-500">Harga</span>
        <% if (order.price === 0) { %>
          <span class="comic-badge-free" style="font-size:11px;padding:2px 8px;">Gratis</span>
        <% } else { %>
          <span class="font-bold">Rp <%= order.price.toLocaleString('id-ID') %></span>
        <% } %>
      </div>
      <div class="flex justify-between"><span class="text-gray-500">Dibeli</span><span class="font-bold"><%= new Date(order.createdAt).toLocaleString('id-ID') %></span></div>
    </div>
  </div>

  <!-- Link Akses -->
  <div class="comic-panel mb-4">
    <div class="comic-panel-head">
      <i class="fa-solid fa-link text-base"></i>
      <span>Akses Produk</span>
    </div>
    <div class="p-4 text-[12.5px] font-medium text-gray-700 flex flex-col gap-3">

      <% if (order.fullUp) { %>
        <% if (order.groupLink) { %>
          <div>
            <p class="text-gray-500 mb-1.5"><i class="fa-solid fa-users mr-1"></i>Link Group Join</p>
            <a href="<%= order.groupLink %>" target="_blank" rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl border-2 border-black bg-blue-500 text-white font-extrabold text-[13px] shadow-[3px_3px_0_#14120f] active:translate-x-[2px] active:translate-y-[2px] active:shadow-[1px_1px_0_#14120f]">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> Gabung Group
            </a>
          </div>
        <% } else { %>
          <p class="text-[11px] text-amber-600 font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Link Group belum tersedia. Hubungi CS Bantuan.</p>
        <% } %>
      <% } %>

      <% if (order.downloadLink) { %>
        <div>
          <p class="text-gray-500 mb-1.5"><i class="fa-solid fa-download mr-1"></i>Link Download</p>
          <a href="<%= order.downloadLink %>" target="_blank" rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl border-2 border-black bg-white text-black font-extrabold text-[13px] shadow-[3px_3px_0_#14120f] active:translate-x-[2px] active:translate-y-[2px] active:shadow-[1px_1px_0_#14120f]">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> Buka Link Download
          </a>
        </div>
      <% } %>

      <% if (!order.fullUp && !order.downloadLink) { %>
        <p class="text-[11px] text-gray-400">Tidak ada link yang tersedia untuk produk ini.</p>
      <% } %>

    </div>
  </div>

</div>

<style>
  .comic-panel { border: 2.5px solid #14120f; border-radius: 18px; background:#fffdf7; box-shadow: 3px 3px 0 #14120f; overflow: hidden; }
  .comic-panel-head { display:flex; align-items:center; gap:8px; padding:10px 14px; background: var(--comic-yellow, #ffd23f); border-bottom: 2.5px solid #14120f; font-weight:800; font-size:13px; }
</style>

<%- include('partials/footer') %>
