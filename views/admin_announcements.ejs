<%- include('partials/header', { title: 'Kelola Pengumuman' }) %>

<style>
  .custom-scroll::-webkit-scrollbar { width: 2px; height: 2px; }
  .custom-scroll::-webkit-scrollbar-track { background: #f1f1f1; }
  .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 4px; }
  .custom-scroll:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }

  .desc-type-tab {
    flex: 1;
    text-align: center;
    padding: 10px 8px;
    border-radius: 12px;
    border: 2.5px solid var(--comic-black);
    background: #fff;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--comic-black);
    cursor: pointer;
  }
  .desc-type-tab.active { background: var(--comic-yellow); box-shadow: 2px 2px 0 var(--comic-black); }
</style>

<div class="max-w-3xl mx-auto px-6 mt-1 pb-10">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-medium text-gray-800">Kelola Pengumuman</h1>
    <span class="text-[12px] font-semibold text-gray-500"><%= announcements.length %> Pengumuman</span>
  </div>

  <!-- Alert Success dari server -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>

  <!-- Alert Error dari server -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <!-- ===== FORM BUAT PENGUMUMAN ===== -->
  <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-6">
    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
      <i class="fa-solid fa-circle-info text-gray-700 text-sm"></i>
      <h2 class="text-sm font-medium text-gray-800">Buat Pengumuman</h2>
    </div>

    <form method="POST" action="/admin/announcements" enctype="multipart/form-data" class="flex flex-col gap-3" id="announceForm">
      <label class="ev-card" data-comic-owned><span class="ev-ribbon" style="display:block"><span>EVENT KHUSUS</span></span><span class="ev-content" style="display:flex;align-items:center;gap:10px"><input type="checkbox" name="isEvent"> Tandai sebagai event / pengumuman penting (pita bergaris)</span></label>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Judul Pengumuman <span class="text-red-500">*</span></label>
        <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5">
          <input name="title" type="text" maxlength="150" required placeholder="Contoh: Maintenance Server Malam Ini"
                 class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full">
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Tipe Deskripsi <span class="text-red-500">*</span></label>
        <div class="flex gap-2">
          <div class="desc-type-tab active" id="tabText" onclick="setDescType('text')"><i class="fa-solid fa-keyboard mr-1"></i> Ketik Teks</div>
          <div class="desc-type-tab" id="tabVoice" onclick="setDescType('voice')"><i class="fa-solid fa-microphone mr-1"></i> Pesan Suara (VN)</div>
        </div>
        <input type="hidden" name="descriptionType" id="descriptionType" value="text">
      </div>

      <!-- Deskripsi Teks -->
      <div id="sectionText">
        <label class="block text-xs font-medium text-gray-700 mb-2">Deskripsi (bebas)</label>
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5">
          <textarea name="descriptionText" rows="4" maxlength="2000" placeholder="Tulis isi pengumuman di sini..."
                    class="w-full bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none resize-none"></textarea>
        </div>
      </div>

      <!-- Deskripsi Voice Note -->
      <div id="sectionVoice" class="hidden">
        <label class="block text-xs font-medium text-gray-700 mb-2">Pesan Suara (VN) &mdash; unggah file audio</label>
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-3 flex flex-col gap-3">
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-1.5">
            <input name="voice" id="voiceFileInput" type="file" accept="audio/*"
                   class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-gray-100 file:text-gray-700">
          </div>
          <p class="text-[11px] text-gray-400 mb-0">Format MP3/WAV/OGG/WEBM/M4A, maksimal 10MB.</p>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Hapus Otomatis</label>
        <select name="autoDeleteOption" id="autoDeleteOption" onchange="toggleCustomDate()"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 px-3 py-2.5 text-xs font-medium text-gray-800 outline-none">
          <option value="never" selected>Tidak ada (tetap sampai dihapus manual)</option>
          <option value="1h">1 Jam dari sekarang</option>
          <option value="24h">1 Hari dari sekarang</option>
          <option value="72h">3 Hari dari sekarang</option>
          <option value="168h">1 Minggu dari sekarang</option>
          <option value="custom">Atur tanggal &amp; jam kustom</option>
        </select>
        <div id="customDateWrap" class="hidden mt-2">
          <input type="datetime-local" name="autoDeleteAt"
                 class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 px-3 py-2.5 text-xs font-medium text-gray-800 outline-none">
        </div>
        <p class="text-[11px] text-gray-400 mt-1.5">Pengumuman akan otomatis terhapus permanen begitu waktunya tiba.</p>
      </div>

      <!-- Warna netral (krem + border hitam) — jangan pakai bg-blue-* : tema memaksa kelas itu jadi warna tema sehingga menyatu dengan tombol -->
      <div class="flex items-start gap-3 bg-amber-50 border-2 border-black rounded-2xl p-3 shadow-[2px_2px_0_#14120f]">
        <input type="checkbox" name="notifyTelegram" id="notifyTelegram" value="on"
               class="mt-0.5 w-5 h-5 shrink-0 cursor-pointer" style="accent-color:#14120f">
        <label for="notifyTelegram" class="text-[12px] font-semibold text-gray-800 leading-snug cursor-pointer">
          <i class="fa-brands fa-telegram text-sky-500 text-base mr-1 align-middle"></i>
          Kirim juga lewat Bot Telegram ke setiap user yang sudah menghubungkan ID Telegram-nya (dikirim satu per satu ke chat pribadi masing-masing sesuai ID akun mereka).
        </label>
      </div>

      <button type="submit"
              class="comic-btn-primary mt-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-[13.5px] font-bold">
        <i class="fa-solid fa-circle-info"></i> Buat Pengumuman
      </button>
    </form>
  </div>

  <!-- ===== DAFTAR PENGUMUMAN ===== -->
  <div class="flex items-center gap-2 mb-3 px-1">
    <i class="fas fa-list-ul text-gray-700 text-sm"></i>
    <h2 class="text-sm font-medium text-gray-800">Daftar Pengumuman</h2>
  </div>

  <% if (!announcements || announcements.length === 0) { %>
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-8 text-center">
      <p class="text-sm font-medium text-gray-600">Belum ada pengumuman. Buat pengumuman pertama Anda di atas.</p>
    </div>
  <% } else { %>
    <div class="flex flex-col gap-3">
      <% announcements.forEach(function(a) { %>
        <% if (a.isEvent) { %><div class="ev-ribbon" data-comic-owned><span>EVENT · PENGUMUMAN PENTING</span></div><% } %>
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-4">
          <div class="flex items-center justify-between gap-2 mb-1">
            <p class="text-[13.5px] font-bold text-gray-800 truncate"><%= a.title %></p>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full border-2 border-black <%= a.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
              <%= a.active ? 'Aktif' : 'Nonaktif' %>
            </span>
          </div>

          <% if (a.notifyTelegram) { %>
            <span class="inline-flex items-center gap-1 text-[10.5px] font-bold text-blue-600 mb-2">
              <i class="fa-brands fa-telegram"></i> Dikirim via Bot Telegram
            </span>
          <% } %>

          <% if (a.descriptionType === 'voice' && a.voiceUrl) { %>
            <audio controls preload="none" src="<%= a.voiceUrl %>" class="w-full my-2" style="height:38px;"></audio>
          <% } else { %>
            <p class="text-[12px] text-gray-600 mb-2 whitespace-pre-line"><%= a.descriptionText %></p>
          <% } %>

          <p class="text-[11px] text-gray-400 mb-3">
            Dibuat <%= new Date(a.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
            <% if (a.autoDeleteAt) { %>
              &middot; <i class="fa-solid fa-clock text-[10px]"></i> Hapus otomatis <%= new Date(a.autoDeleteAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
            <% } %>
          </p>

          <div class="flex items-center gap-2">
            <form method="POST" action="/admin/announcements/<%= a._id %>/toggle" class="flex-1">
              <button type="submit" class="w-full comic-btn-secondary px-3 py-2 rounded-xl text-[12.5px] font-bold">
                <i class="fa-solid <%= a.active ? 'fa-eye-slash' : 'fa-eye' %>"></i> <%= a.active ? 'Nonaktifkan' : 'Aktifkan' %>
              </button>
            </form>
            <form method="POST" action="/admin/announcements/<%= a._id %>/delete" class="flex-1" onsubmit="return confirm('Hapus pengumuman ini? Tindakan ini tidak bisa dibatalkan.');">
              <button type="submit" class="w-full comic-btn-danger px-3 py-2 rounded-xl text-[12.5px] font-bold">
                <i class="fa-solid fa-trash"></i> Hapus
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<script>
  function setDescType(type) {
    document.getElementById('descriptionType').value = type;
    document.getElementById('tabText').classList.toggle('active', type === 'text');
    document.getElementById('tabVoice').classList.toggle('active', type === 'voice');
    document.getElementById('sectionText').classList.toggle('hidden', type !== 'text');
    document.getElementById('sectionVoice').classList.toggle('hidden', type !== 'voice');
  }

  function toggleCustomDate() {
    const val = document.getElementById('autoDeleteOption').value;
    document.getElementById('customDateWrap').classList.toggle('hidden', val !== 'custom');
  }

  // Validasi ringan sebelum submit: pastikan sudah ada isi sesuai tipe deskripsi
  document.getElementById('announceForm').addEventListener('submit', function (e) {
    const type = document.getElementById('descriptionType').value;
    if (type === 'text') {
      const val = this.querySelector('textarea[name="descriptionText"]').value.trim();
      if (!val) { e.preventDefault(); alert('Deskripsi teks wajib diisi.'); }
    } else {
      const fileInput = document.getElementById('voiceFileInput');
      if (!fileInput.files || fileInput.files.length === 0) {
        e.preventDefault();
        alert('Rekam pesan suara atau unggah file audio terlebih dahulu.');
      }
    }
  });
</script>

<%- include('partials/footer') %>
