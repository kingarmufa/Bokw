<%- include('partials/header', { title: 'Setting Nokos' }) %>

<div class="px-6 pb-6 mt-1 max-w-[480px] md:max-w-lg mx-auto">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <h1 class="text-base font-bold text-gray-800 mb-1">Setting Nokos</h1>
  <p class="text-[11.5px] text-gray-500 mb-4">Konfigurasi API numberpanel.tech &amp; kelola pendaftaran member "Gacha Nokos".</p>

  <!-- ===== KONFIGURASI API ===== -->
  <form method="POST" action="/admin/setting-nokos/save" class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3"><i class="fa-solid fa-plug mr-1 text-blue-500"></i> Koneksi API numberpanel.tech</h2>

    <label class="flex items-center justify-between mb-3 cursor-pointer">
      <span class="text-[12px] font-semibold text-gray-700">Aktifkan Fitur Gacha Nokos</span>
      <input type="checkbox" name="gachaNokosEnabled" <%= settings.gachaNokosEnabled ? 'checked' : '' %> class="w-4 h-4 accent-blue-600">
    </label>

    <div class="mb-3">
      <label class="block text-[11px] font-bold text-gray-500 mb-1.5">Mode Pendaftaran Member Baru</label>
      <div class="flex flex-col gap-1.5">
        <label class="flex items-start gap-2 text-[11.5px] text-gray-700 border border-gray-200 rounded-xl px-3 py-2 cursor-pointer">
          <input type="radio" name="gachaNokosRegistrationMode" value="manual" onchange="toggleFeeField()" <%= (settings.gachaNokosRegistrationMode || 'manual') === 'manual' ? 'checked' : '' %> class="mt-0.5 accent-blue-600">
          <span><b>Manual (perlu ACC admin)</b><br><span class="text-gray-400">User daftar → masuk antrian → admin ACC/Tolak manual. Gratis.</span></span>
        </label>
        <label class="flex items-start gap-2 text-[11.5px] text-gray-700 border border-gray-200 rounded-xl px-3 py-2 cursor-pointer">
          <input type="radio" name="gachaNokosRegistrationMode" value="auto" onchange="toggleFeeField()" <%= settings.gachaNokosRegistrationMode === 'auto' ? 'checked' : '' %> class="mt-0.5 accent-blue-600">
          <span><b>Otomatis ACC</b><br><span class="text-gray-400">User daftar → langsung disetujui sistem, tanpa review admin. Gratis.</span></span>
        </label>
        <label class="flex items-start gap-2 text-[11.5px] text-gray-700 border border-gray-200 rounded-xl px-3 py-2 cursor-pointer">
          <input type="radio" name="gachaNokosRegistrationMode" value="paid" onchange="toggleFeeField()" <%= settings.gachaNokosRegistrationMode === 'paid' ? 'checked' : '' %> class="mt-0.5 accent-blue-600">
          <span><b>Daftar Bayar</b><br><span class="text-gray-400">User bayar biaya pendaftaran di bawah → langsung disetujui otomatis (tanpa review admin).</span></span>
        </label>
        <label class="flex items-start gap-2 text-[11.5px] text-gray-700 border border-gray-200 rounded-xl px-3 py-2 cursor-pointer">
          <input type="radio" name="gachaNokosRegistrationMode" value="closed" onchange="toggleFeeField()" <%= settings.gachaNokosRegistrationMode === 'closed' ? 'checked' : '' %> class="mt-0.5 accent-blue-600">
          <span><b>Daftar Tutup</b><br><span class="text-gray-400">Pendaftaran member baru ditutup sepenuhnya. Member lama tidak terpengaruh.</span></span>
        </label>
      </div>
    </div>

    <div class="mb-3 <%= settings.gachaNokosRegistrationMode === 'paid' ? '' : 'hidden' %>" id="feeFieldWrap">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">Biaya Pendaftaran (Rp) — dipakai kalau mode "Daftar Bayar"</label>
      <input type="number" name="gachaNokosRegistrationFee" min="0" value="<%= settings.gachaNokosRegistrationFee || 0 %>"
        class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs">
    </div>

    <script>
      function toggleFeeField() {
        const mode = document.querySelector('input[name="gachaNokosRegistrationMode"]:checked')?.value;
        document.getElementById('feeFieldWrap').classList.toggle('hidden', mode !== 'paid');
      }
    </script>

    <div class="mb-3">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">API Key (Bearer Token)</label>
      <input type="text" name="gachaNokosApiKey" value="<%= settings.gachaNokosApiKey || '' %>" placeholder="Dari numberpanel.tech/signin"
        class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs">
    </div>

    <div class="mb-3">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">Base URL API</label>
      <input type="text" name="gachaNokosBaseUrl" value="<%= settings.gachaNokosBaseUrl || 'https://numberpanel.tech/api' %>"
        class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs">
    </div>

    <div class="mb-3">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">Biaya per Tarik (Rp, 0 = gratis)</label>
      <input type="number" name="gachaNokosCost" min="0" value="<%= settings.gachaNokosCost || 0 %>"
        class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs">
    </div>

    <div class="mb-4">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">Syarat &amp; Ketentuan (ditampilkan ke user sebelum daftar)</label>
      <textarea name="gachaNokosTerms" rows="6" class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs"><%= settings.gachaNokosTerms %></textarea>
    </div>

    <button type="submit" class="w-full py-2.5 rounded-xl bg-blue-600 text-white text-[12.5px] font-bold">Simpan Pengaturan</button>
  </form>

  <!-- ===== PENDAFTARAN MENUNGGU ACC ===== -->
  <div class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3"><i class="fa-solid fa-hourglass-half mr-1 text-yellow-500"></i> Menunggu Review (<%= pending.length %>)</h2>
    <% if (pending.length === 0) { %>
      <p class="text-[11.5px] text-gray-400">Tidak ada pendaftaran baru.</p>
    <% } %>
    <% pending.forEach(u => { %>
      <div class="flex items-center justify-between gap-2 border border-gray-200 rounded-xl px-3 py-2.5 mb-2">
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-gray-800 truncate"><%= u.username %></p>
          <p class="text-[10.5px] text-gray-500 truncate"><%= u.email %></p>
        </div>
        <div class="flex gap-1.5 shrink-0">
          <form action="/admin/setting-nokos/acc/<%= u._id %>" method="POST">
            <button type="submit" class="px-3 py-1.5 rounded-lg bg-green-600 text-white text-[11px] font-bold">ACC</button>
          </form>
          <form action="/admin/setting-nokos/tolak/<%= u._id %>" method="POST" onsubmit="return setAlasan(this)">
            <button type="submit" class="comic-btn-danger px-3 py-1.5 rounded-lg text-[11px]" style="background:#ef2b2d;color:#fff;border:2.5px solid #14120f;box-shadow:2px 2px 0 #14120f;font-weight:800;">Tolak</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- ===== MEMBER AKTIF (APPROVED) ===== -->
  <div class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3"><i class="fa-solid fa-circle-check mr-1 text-green-500"></i> Member Aktif (<%= approved.length %>)</h2>
    <% if (approved.length === 0) { %>
      <p class="text-[11.5px] text-gray-400">Belum ada member yang di-ACC.</p>
    <% } %>
    <% approved.forEach(u => { %>
      <div class="flex items-center justify-between gap-2 border border-gray-200 rounded-xl px-3 py-2.5 mb-2">
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-gray-800 truncate"><%= u.username %></p>
          <p class="text-[10.5px] text-gray-500 truncate"><%= u.email %></p>
        </div>
        <form action="/admin/setting-nokos/cabut/<%= u._id %>" method="POST" onsubmit="return confirm('Cabut akses Gacha Nokos user ini?')">
          <button type="submit" class="px-3 py-1.5 rounded-lg bg-gray-500 text-white text-[11px] font-bold shrink-0">Cabut Akses</button>
        </form>
      </div>
    <% }) %>
  </div>

  <!-- ===== DITOLAK ===== -->
  <div class="bg-white border border-gray-200 rounded-2xl p-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3"><i class="fa-solid fa-circle-xmark mr-1 text-red-500"></i> Ditolak (<%= rejected.length %>)</h2>
    <% if (rejected.length === 0) { %>
      <p class="text-[11.5px] text-gray-400">Belum ada yang ditolak.</p>
    <% } %>
    <% rejected.forEach(u => { %>
      <div class="border border-gray-200 rounded-xl px-3 py-2.5 mb-2">
        <p class="text-[12px] font-bold text-gray-800"><%= u.username %></p>
        <p class="text-[10.5px] text-gray-500"><%= u.email %></p>
        <% if (u.gachaNokosNote) { %><p class="text-[10.5px] text-red-500 mt-1">Alasan: <%= u.gachaNokosNote %></p><% } %>
      </div>
    <% }) %>
  </div>

</div>

<script>
  function setAlasan(form) {
    const alasan = prompt('Alasan penolakan (opsional):') || '';
    const input = document.createElement('input');
    input.type = 'hidden'; input.name = 'alasan'; input.value = alasan;
    form.appendChild(input);
    return true;
  }
</script>

<%- include('partials/footer') %>
