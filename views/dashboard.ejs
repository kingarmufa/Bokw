<% if (typeof promoPopups !== 'undefined' && promoPopups && promoPopups.length) { %>
<!-- ===== POP UP PROMOSI (dikelola admin, punya masa expired) ===== -->
<style>
  /* Popup promo memakai ComicPopup (overlay .cp-overlay + kartu .cp-card): selalu di depan layar. */
  #promoPopup .cp-card { max-width: 360px; }
  #promoPopup .pp-close { position: absolute; top: 10px; right: 10px; z-index: 2; width: 38px; height: 38px; display: grid; place-items: center; padding: 0; background: var(--cm-white) !important; border-radius: 7px !important; }
  #promoPopup .pp-scroll { overflow-y: auto; -webkit-overflow-scrolling: touch; flex: 1; }
  #promoPopup .pp-img { display: block; width: 100%; max-height: 50vh; max-height: 50dvh; object-fit: contain; background: #f3f4f6; }
  #promoPopup .pp-body { padding: 14px 16px 16px; }
  #promoPopup .pp-title { font-size: 18px; line-height: 1.25; margin: 0 0 4px; word-break: break-word; }
  #promoPopup .pp-exp { font-size: 12px; font-weight: 700; margin: 0 0 10px; }
  #promoPopup .pp-btn { display: block; width: 100%; text-align: center; padding: 11px 14px; font-family: Bangers, Impact, sans-serif; font-size: 1.25rem; letter-spacing: .06em; border-radius: 8px; text-decoration: none; background: var(--cm-yellow) !important; border: 3px solid var(--cm-ink); box-shadow: 3px 3px 0 var(--cm-ink); }
  #promoPopup .pp-hide { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 12.5px; font-weight: 700; cursor: pointer; }
</style>
<div id="promoPopup" class="cp-overlay hidden" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="cp-card">
    <button type="button" class="pp-close comic-btn-secondary" id="ppClose" data-cp-close aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    <div class="pp-scroll">
      <a id="ppImgLink" target="_blank" rel="noopener noreferrer" style="display:block"><img id="ppImg" class="pp-img" alt=""></a>
      <div class="pp-body">
        <p class="pp-title font-comic" id="ppTitle"></p>
        <p class="pp-exp" id="ppExp"></p>
        <a id="ppGo" class="pp-btn" target="_blank" rel="noopener noreferrer" style="display:none">Lihat Promo <i class="fa-solid fa-arrow-up-right-from-square" style="margin-left:4px"></i></a>
        <label class="pp-hide"><input type="checkbox" id="ppNever"> Jangan tampilkan lagi</label>
      </div>
    </div>
  </div>
</div>
<script type="application/json" id="promoData"><%- JSON.stringify(promoPopups.map(function(p) { return { id: String(p._id), v: new Date(p.updatedAt || p.createdAt).getTime(), title: p.title || '', imageUrl: p.imageUrl, linkUrl: p.linkUrl || '', expiresAt: p.expiresAt ? new Date(p.expiresAt).toISOString() : null }; })).replace(/</g, '\\u003c') %></script>
<script>
  (function () {
    var dataEl = document.getElementById('promoData');
    if (!dataEl) return;
    var items = [];
    try { items = JSON.parse(dataEl.textContent) || []; } catch (e) { return; }
    function keyOf(p) { return 'promo:' + p.id + ':' + p.v; }
    var queue = items.filter(function (p) {
      if (p.expiresAt && Date.now() >= new Date(p.expiresAt).getTime()) return false;   // sudah expired
      try {
        if (localStorage.getItem(keyOf(p) + ':hide') === '1') return false;             // "jangan tampilkan lagi"
        if (sessionStorage.getItem(keyOf(p) + ':seen') === '1') return false;           // sudah ditutup di sesi ini
      } catch (e) {}
      return true;
    });
    if (!queue.length) return;

    var root = document.getElementById('promoPopup');
    var img = document.getElementById('ppImg'), imgLink = document.getElementById('ppImgLink');
    var titleEl = document.getElementById('ppTitle'), expEl = document.getElementById('ppExp');
    var go = document.getElementById('ppGo'), never = document.getElementById('ppNever');
    var current = null;

    function fmtExp(iso) {
      try {
        return new Date(iso).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }).replace(/\./g, ':') + ' WIB';
      } catch (e) { return ''; }
    }
    function show() {
      current = queue.shift();
      if (!current) return;
      if (current.expiresAt && Date.now() >= new Date(current.expiresAt).getTime()) { current = null; return show(); }
      img.src = current.imageUrl;
      img.alt = current.title || 'Promo';
      img.style.display = '';
      img.onerror = function () { img.style.display = 'none'; };
      titleEl.textContent = current.title;
      titleEl.style.display = current.title ? '' : 'none';
      expEl.textContent = current.expiresAt ? 'Berlaku sampai ' + fmtExp(current.expiresAt) : '';
      expEl.style.display = current.expiresAt ? '' : 'none';
      if (current.linkUrl) { go.href = current.linkUrl; go.style.display = 'block'; imgLink.href = current.linkUrl; imgLink.style.pointerEvents = ''; }
      else { go.style.display = 'none'; imgLink.removeAttribute('href'); imgLink.style.pointerEvents = 'none'; }
      never.checked = false;
      ComicPopup.open(root);
    }
    // Tombol X / klik latar / Esc ditangani ComicPopup; di sini hanya mencatat "sudah dilihat" saat popup tertutup.
    root.addEventListener('comicpopup:close', function () {
      if (!current) return;
      try {
        sessionStorage.setItem(keyOf(current) + ':seen', '1');
        if (never.checked) localStorage.setItem(keyOf(current) + ':hide', '1');
      } catch (e) {}
      current = null;
      setTimeout(show, 250);
    });
    // Tunggu loading intro (komik) selesai & dashboard tampil dulu, baru popup muncul.
    function startWhenReady() {
      var loaderEl = document.getElementById('cmLoader');
      if (loaderEl && window.__cmLoaderDone !== true) {
        document.addEventListener('cmloader:done', function () { setTimeout(show, 500); }, { once: true });
      } else {
        setTimeout(show, 600);
      }
    }
    if (document.readyState === 'complete') startWhenReady();
    else window.addEventListener('load', startWhenReady);
  })();
</script>
<% } %>

<script>
  function toggleBalance() {
    const real = document.getElementById('balanceReal');
    const hidden = document.getElementById('balanceHidden');
    const icon = document.getElementById('balanceToggleIcon');
    const isHidden = real.classList.contains('hidden');
    real.classList.toggle('hidden', !isHidden);
    hidden.classList.toggle('hidden', isHidden);
    icon.classList.toggle('fa-eye', !isHidden);
    icon.classList.toggle('fa-eye-slash', isHidden);
  }
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script type="application/json" id="dashChartData"><%- JSON.stringify(chartSeries) %></script>
<script>
  (function () {
    const canvas = document.getElementById('dashTrxChart');
    if (!canvas || typeof Chart === 'undefined') return;
    let series = { daily: [], hourly: [] };
    try { series = JSON.parse(document.getElementById('dashChartData').textContent) || series; } catch (e) {}

    function slice(range) {
      if (range === 'today') return series.hourly || [];
      if (range === '30') return series.daily || [];
      return (series.daily || []).slice(-7); // 7 Hari
    }

    const ctx = canvas.getContext('2d');
    let chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          { label: 'Masuk', data: [], borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,.12)', tension: 0.35, fill: true, pointRadius: 3 },
          { label: 'Keluar', data: [], borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,.10)', tension: 0.35, fill: true, pointRadius: 3 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.dataset.label + ': Rp ' + c.parsed.y.toLocaleString('id-ID') } } },
        scales: {
          y: { beginAtZero: true, ticks: { callback: v => 'Rp ' + Number(v).toLocaleString('id-ID') } },
          x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 7 } }
        }
      }
    });

    function render(range) {
      const rows = slice(range);
      chart.data.labels = rows.map(r => r.label);
      chart.data.datasets[0].data = rows.map(r => r.masuk);
      chart.data.datasets[1].data = rows.map(r => r.keluar);
      chart.update();
    }

    document.querySelectorAll('.dashChartTab').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.dashChartTab').forEach(b => { b.classList.remove('bg-blue-600', 'text-white'); b.classList.add('bg-gray-100', 'text-gray-600'); });
        btn.classList.remove('bg-gray-100', 'text-gray-600'); btn.classList.add('bg-blue-600', 'text-white');
        render(btn.dataset.range);
      });
    });

    render('7');
  })();
</script>

