    .tfd-green{background:#22c55e}.tfd-yellow{background:#facc15}
    .tfd-mine{display:flex;align-items:center;justify-content:space-between;gap:10px;border:3px solid #111;border-radius:16px;padding:12px 16px;margin-bottom:20px;background:#111;color:#facc15!important;box-shadow:4px 4px 0 #22c55e;text-decoration:none}
    .tfd-mine b{font-family:'Bangers',cursive;font-size:19px;letter-spacing:.5px;color:#facc15}.tfd-mine small{display:block;font-size:10.5px;font-weight:700;color:#fff;opacity:.85}
  </style>
  <div class="tfd-grid">
    <a href="/transfer?mode=qr" class="tfd-btn tfd-green"><span class="ic"><i class="fa-solid fa-qrcode"></i></span><b>TRANSFER QRIS</b><small>Upload foto QRIS penerima</small></a>
    <a href="/transfer?mode=username" class="tfd-btn tfd-yellow"><span class="ic"><i class="fa-solid fa-user-check"></i></span><b>TRANSFER USERNAME</b><small>Cek profil lalu kirim saldo</small></a>
  </div>
  <a href="/transfer?mode=my" class="tfd-mine"><span><b>QRIS SAYA</b><small>Lihat &amp; download QRIS untuk terima transfer</small></span><i class="fa-solid fa-download"></i></a>
  <% } %>

  <!-- ===== BANNER / IKLAN (TV Komik, full-width, auto-slide) ===== -->
  <% if (typeof banners !== 'undefined' && banners && banners.length > 0) { %>
    <div class="comic-tv-banner mb-5">
      <div class="comic-tv-frame">
        <span class="comic-tv-antenna comic-tv-antenna-l"></span>
        <span class="comic-tv-antenna comic-tv-antenna-r"></span>
        <span class="comic-tv-knobs"><span></span><span></span></span>
        <div class="comic-tv-screen">
          <div class="comic-tv-track" id="bannerTrack">
            <% banners.forEach(function(b) { %>
              <div class="comic-tv-slide">
                <% if (b.linkUrl) { %>
                  <a href="<%= b.linkUrl %>" target="_blank" rel="noopener noreferrer">
                    <img src="<%= b.imageUrl %>" alt="<%= b.title || 'Iklan' %>">
                  </a>
                <% } else { %>
                  <img src="<%= b.imageUrl %>" alt="<%= b.title || 'Iklan' %>">
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
      <% if (banners.length > 1) { %>
        <div class="comic-tv-dots" id="bannerDots">
          <% banners.forEach(function(b, i) { %>
            <span class="comic-tv-dot<%= i === 0 ? ' active' : '' %>"></span>
          <% }); %>
        </div>
      <% } %>
    </div>
    <script>
      (function () {
        const track = document.getElementById('bannerTrack');
        if (!track) return;
        const slides = track.children;
        const total = slides.length;
        const dotsWrap = document.getElementById('bannerDots');
        const dots = dotsWrap ? dotsWrap.children : [];
        let idx = 0, timer = null;

        const screenBox = track.parentElement;
        // Tinggi bingkai mengikuti rasio asli gambar slide aktif (tidak terpotong).
        function fitHeight() {
          const img = slides[idx] && slides[idx].querySelector('img');
          if (img && img.clientHeight) screenBox.style.height = (img.clientHeight + 6) + 'px';
        }
        for (let k = 0; k < total; k++) {
          const im = slides[k].querySelector('img');
          if (im) im.addEventListener('load', fitHeight);
        }
        window.addEventListener('resize', fitHeight);

        function goTo(i) {
          idx = (i + total) % total;
          track.style.transform = 'translateX(-' + (idx * 100) + '%)';
          fitHeight();
          for (let d = 0; d < dots.length; d++) dots[d].classList.toggle('active', d === idx);
        }
        function next() { goTo(idx + 1); }
        function startAuto() { stopAuto(); if (total > 1) timer = setInterval(next, 3500); }
        function stopAuto() { if (timer) clearInterval(timer); }

        // swipe manual
        let startX = 0, deltaX = 0, dragging = false;
        const screenEl = track.parentElement;
        screenEl.addEventListener('touchstart', function (e) {
          dragging = true; startX = e.touches[0].clientX; deltaX = 0; stopAuto();
        }, { passive: true });
        screenEl.addEventListener('touchmove', function (e) {
          if (dragging) deltaX = e.touches[0].clientX - startX;
        }, { passive: true });
        screenEl.addEventListener('touchend', function () {
          if (!dragging) return;
          dragging = false;
          if (deltaX > 40) goTo(idx - 1);
          else if (deltaX < -40) goTo(idx + 1);
          startAuto();
        });

        for (let d = 0; d < dots.length; d++) {
          dots[d].addEventListener('click', function () { goTo(d); startAuto(); });
        }

        goTo(0);
        startAuto();
      })();
    </script>
  <% } %>

  <!-- ===== STORY (ala IG, tampilan komik) ===== -->
  <%- include('partials/social_card') %>
  <%- include('partials/story_bar') %>

  <!-- ===== 2 KOTAK BESAR: TOTAL MASUK & TOTAL KELUAR ===== -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="comic-flow-box comic-anim masuk rounded-2xl px-4 py-6 flex flex-col items-center text-center">
      <i class="fa-solid fa-arrow-down text-2xl text-black mb-2"></i>
      <p class="text-[12px] font-bold uppercase tracking-wide text-black/70 mb-1">Total Masuk</p>
      <p class="font-comic text-2xl md:text-3xl text-black leading-none">Rp <%= totalDeposit.toLocaleString('id-ID') %></p>
    </div>

    <div class="comic-flow-box comic-anim keluar rounded-2xl px-4 py-6 flex flex-col items-center text-center">
      <i class="fa-solid fa-arrow-up text-2xl text-black mb-2"></i>
      <p class="text-[12px] font-bold uppercase tracking-wide text-black/70 mb-1">Total Keluar</p>
      <p class="font-comic text-2xl md:text-3xl text-black leading-none">Rp <%= totalWithdraw.toLocaleString('id-ID') %></p>
