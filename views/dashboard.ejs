<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="max-w-3xl mx-auto px-6 pb-2 mt-1">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-medium text-gray-800">Dashboard</h1>
    <span class="text-[13.5px] font-medium text-gray-800"><a href="/profile" class="inline-flex items-center text-[13.5px] font-bold text-blue-500 transition-colors">
      <%= user.email.replace(/^(.{3})[^@]*(?=@)/, '$1****') %>
    </a></span>
