      <button type="button" class="dashChartTab px-3.5 py-1.5 rounded-full text-[12px] font-bold bg-gray-100 text-gray-600" data-range="30">30 Hari</button>
      <button type="button" class="dashChartTab px-3.5 py-1.5 rounded-full text-[12px] font-bold bg-gray-100 text-gray-600" data-range="today">Hari Ini</button>
    </div>
    <div style="height:220px">
      <canvas id="dashTrxChart"></canvas>
    </div>
  </div>

  <!-- ===== TRANSAKSI TERAKHIR (semua layanan) ===== -->
  <div class="bg-white comic-anim border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 mb-6">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <h3 class="text-[14.5px] font-bold text-gray-800 mb-0">Transaksi Terakhir</h3>
      <a href="/deposit" class="text-[12.5px] font-bold text-blue-500">Lihat Semua</a>
    </div>
    <% if (!activityFeed || !activityFeed.length) { %>
      <p class="text-[12.5px] text-gray-400 text-center py-6 mb-0">Belum ada transaksi.</p>
    <% } else { %>
      <div class="divide-y divide-gray-100">
        <% activityFeed.forEach(function (item) { %>
          <div class="flex items-center justify-between px-4 py-3">
            <div class="min-w-0 pr-3">
              <p class="text-[13px] font-semibold text-gray-800 mb-0.5 truncate"><%= item.label %></p>
              <p class="text-[11px] text-gray-400 mb-0"><%= new Date(item.date).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).replace(/\./g, ':') %></p>
            </div>
            <p class="text-[13.5px] font-bold mb-0 whitespace-nowrap" style="color:<%= item.direction === 'masuk' ? '#16a34a' : '#dc2626' %>">
              <%= item.direction === 'masuk' ? '+' : '-' %>Rp <%= item.amount.toLocaleString('id-ID') %>
