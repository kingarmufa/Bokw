  <!-- ===== TOTAL TRANSAKSI ===== -->
  <div class="bg-white comic-anim border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300">
    <div class="bg-gray-50 border-b border-gray-200 px-4 py-2">
      <p class="text-sm font-medium text-gray-800 mb-0">Total Transaksi</p>
    </div>
    <div class="px-4 py-5">
      <p class="text-base font-medium text-gray-800"><%= recentTrx.length %> Transaksi</p>
      <a href="/deposit" class="inline-flex items-center gap-1 text-[13.5px] font-bold text-blue-500 transition-colors">
        Lihat Semua Transaksi <i class="fas fa-arrow-right text-[9.5px]"></i>
