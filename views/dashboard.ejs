  <!-- ===== HUD STATUS (di bawah Total Masuk / Total Keluar) ===== -->
  <div class="mb-6 hud-wide">
    <%- include('partials/hud_status') %>
  </div>

  <!-- ===== GRAFIK TRANSAKSI ===== -->
