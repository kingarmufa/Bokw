    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
      <h3 class="text-[15px] font-bold text-gray-800 mb-0">Grafik Transaksi</h3>
      <div class="flex items-center gap-3 text-[11.5px] font-semibold">
        <span class="flex items-center gap-1.5 text-gray-600"><span class="w-2.5 h-2.5 rounded-full" style="background:#22c55e"></span> Masuk</span>
