    .tfd-btn{display:flex;flex-direction:column;gap:6px;border:3px solid #111;border-radius:16px;padding:14px;box-shadow:4px 4px 0 #111;color:#111!important;text-decoration:none;transition:transform .12s,box-shadow .12s}
    .tfd-btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 #111}
    .tfd-btn .ic{width:40px;height:40px;border:3px solid #111;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:18px}
    .tfd-btn b{font-family:'Bangers',cursive;font-size:21px;letter-spacing:.5px;line-height:1.05}
