  <!-- ===== SALDO AKTIF (besar) ===== -->
  <div class="comic-balance-card comic-anim rounded-2xl mb-5 px-6 py-7 relative">
    <div class="relative flex items-center justify-between">
      <span class="text-[13px] font-bold uppercase tracking-wide text-white/90">
        <%= user.role === 'merchant' ? 'Total Transaksi Bulan Ini' : 'Total Saldo Aktif' %>
      </span>
      <i class="fa-solid fa-wallet text-2xl text-white/80"></i>
    </div>
    <div class="relative flex items-center gap-3 mt-2">
      <h2 id="balanceReal" class="font-comic text-4xl md:text-5xl text-white mb-0 leading-none" style="text-shadow:2px 2px 0 var(--comic-black);">
        Rp <%= displayBalance.toLocaleString('id-ID') %>
      </h2>
      <h2 id="balanceHidden" class="font-comic text-4xl md:text-5xl text-white hidden mb-0 leading-none" style="text-shadow:2px 2px 0 var(--comic-black);">
        Rp •••••••
      </h2>
      <button type="button" onclick="toggleBalance()" class="w-9 h-9 shrink-0 rounded-full border-2 border-black bg-white/90 text-gray-800 flex items-center justify-center">
        <i id="balanceToggleIcon" class="far fa-eye text-[13.5px]"></i>
      </button>
    </div>
    <% if (user.role === 'merchant') { %>
      <p class="relative text-[11.5px] font-medium text-white/80 mt-2 mb-0">Dihitung dari transaksi QRIS pribadi bulan berjalan, reset tiap awal bulan.</p>
    <% } %>
    <div class="relative flex items-center gap-1.5 mt-3 pt-3 border-t border-white/20">
      <i class="fa-solid fa-lock text-white/70 text-[11px]"></i>
      <p class="text-[11.5px] font-semibold text-white/90 mb-0">
        Saldo Tertahan: Rp <%= (user.heldBalance || 0).toLocaleString('id-ID') %>
      </p>
    </div>
    <p class="relative text-[10.5px] text-white/70 mt-1 mb-0">Saldo tertahan bisa dipakai beli semua layanan, tapi tidak bisa ditarik. Penarikan (instan &amp; manual) hanya dari saldo aktif.</p>
  </div>

  <%- include('partials/event_announcements') %>

  <!-- ===== SALDO TERTAHAN (ShopeePay hold), cuma tampil kalau ada ===== -->
  <% if (user.heldBalance > 0) { %>
    <div class="comic-anim rounded-2xl mb-5 px-5 py-4 flex items-center gap-3 border-2 border-black bg-orange-50 shadow-[3px_3px_0_#14120f]">
      <span class="w-10 h-10 shrink-0 rounded-full bg-orange-500 border-2 border-black flex items-center justify-center">
        <i class="fa-solid fa-lock text-white text-[15px]"></i>
      </span>
      <div>
        <p class="text-[11.5px] font-bold text-orange-700 uppercase tracking-wide mb-0.5">Saldo Tertahan</p>
        <p class="font-comic text-lg text-gray-800 mb-0 leading-none">Rp <%= user.heldBalance.toLocaleString('id-ID') %></p>
        <p class="text-[10.5px] text-gray-500 mt-1 mb-0">
          Dari deposit ShopeePay, otomatis cair ke saldo aktif sesuai jadwal hold. Sebelum cair tetap bisa dipakai beli layanan.
        </p>
      </div>
    </div>
  <% } %>

  <!-- ===== SALDO TOP UP (khusus merchant, buat beli Nokos & Panel) ===== -->
  <% if (user.role === 'merchant') { %>
    <a href="/merchant/topup" class="comic-anim rounded-2xl mb-5 px-5 py-4 flex items-center justify-between border-2 border-black bg-white shadow-[3px_3px_0_#14120f]">
      <span class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-blue-500 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-plus text-white text-sm"></i>
        </span>
        <span>
          <span class="block text-[11px] font-bold uppercase tracking-wide text-gray-500">Saldo Top Up (Beli Nokos & Panel)</span>
          <span class="block text-lg font-comic text-gray-800 leading-none mt-0.5">Rp <%= (user.topupBalance || 0).toLocaleString('id-ID') %></span>
        </span>
      </span>
      <i class="fa-solid fa-chevron-right text-gray-400 text-xs"></i>
    </a>
  <% } %>

  <% if (user.role !== 'merchant' && user.role !== 'admin' && typeof transferSettings !== 'undefined' && transferSettings.transferEnabled !== false) { %>
