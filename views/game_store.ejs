<%- include('partials/game_head', {tab}) %>
<main>
<% if(tab==='home' || tab==='mine'){ const selectedGame=categories.find(c=>String(c._id)===filter); %>
<div class="gs-breadcrumb"><a href="/game-store">Beranda</a><span>›</span><span><%= tab==='mine'?'Akun saya':selectedGame?selectedGame.name:'Marketplace akun game' %></span></div>
<% if(!filter && tab==='home'){ %>
<section class="gs-hero"><div><span class="gs-tag">★ THE NEXT LEVEL MARKET</span><h1>AKUN BARU.<br><mark>LEVEL BARU!</mark></h1><p>Cari akun incaranmu, cek speknya,<br>langsung ngobrol dengan penjual.</p><a href="/game-store/new" class="gs-btn black">+ Mulai jual akun</a></div><div class="gs-art" aria-hidden="true"><div class="gs-star">★</div><div class="gs-controller"><span>✚</span><b>●<br>● ●</b></div><em>LET’S PLAY!</em><small>YOUR NEXT ADVENTURE ↗</small></div></section>
<% } %>
<section class="gs-market-title"><% if(selectedGame){ %><img src="<%= selectedGame.image %>" alt=""><% }else{ %><span class="gs-market-icon">★</span><% } %><div><span class="gs-eyebrow"><%= tab==='mine'?'SELLER SPACE':'GAME ACCOUNT STORE' %></span><h1><%= tab==='mine'?'Postingan saya':selectedGame?'Jual Akun '+selectedGame.name:'Jual beli akun game' %></h1></div><span class="gs-market-label">AKUN</span></section>
<% } %>
<aside class="gs-safety"><span>◆ <b>Waspada akun ditarik kembali / diretas.</b> Periksa bukti kepemilikan dan gunakan admin penengah jika ragu.</span><% if(cfg.mediator){ %><a class="gs-btn" href="<%= cfg.mediator %>" target="_blank" rel="noopener noreferrer">MC ADMIN JIKA RAGU ↗</a><% }else{ %><button disabled class="gs-btn" title="Admin belum mengatur kontak penengah">MC ADMIN JIKA RAGU</button><small>Kontak admin belum diatur.</small><% } %></aside>
<% if(tab==='home'){ %>
<section class="gs-section gs-game-section"><div class="gs-heading"><h2>Pilih game kamu</h2><span>FIND YOUR ARENA ↗</span></div><div class="gs-categories"><a class="gs-category <%= !filter?'selected':'' %>" href="/game-store"><span class="gs-all">★</span><b>Semua game</b></a><% categories.forEach(c=>{ %><a class="gs-category <%= filter===String(c._id)?'selected':'' %>" href="/game-store?category=<%= c._id %>"><img src="<%= c.image %>" alt="" loading="lazy"><b><%= c.name %></b></a><% }) %></div></section>
<% } %>
<% if(tab==='home'||tab==='mine'){ %>
<section class="gs-products">
<% if(tab==='home'){ %>
<form class="gs-search" action="/game-store"><div class="gs-search-box"><span aria-hidden="true">⌕</span><input name="q" value="<%= query %>" placeholder="Cari akun, rank, atau skin…" aria-label="Cari akun" maxlength="80"></div><input type="hidden" name="category" value="<%= filter %>"><label class="gs-sort"><span>Urutkan</span><select name="sort" aria-label="Urutkan akun"><option value="newest" <%= sort==='newest'?'selected':'' %>>Terbaru</option><option value="price_asc" <%= sort==='price_asc'?'selected':'' %>>Harga terendah</option><option value="price_desc" <%= sort==='price_desc'?'selected':'' %>>Harga tertinggi</option></select></label><button class="gs-btn yellow">Cari ↗</button></form>
<% } %>
<div class="gs-results"><p><%= tab==='mine'?'Postingan milikmu':'Hasil pencarian ditemukan' %>: <strong><%= total.toLocaleString('id-ID') %> akun</strong></p><span>✦ <%= tab==='mine'?'KELOLA AKUN':'TEMUKAN PILIHANMU' %></span></div>
<div class="gs-grid"><% listings.forEach(p=>{const c=categories.find(c=>String(c._id)===String(p.category)); %>
<article class="gs-card"><a class="gs-cover" href="/game-store/item/<%= p._id %>" aria-label="Lihat <%= p.name %>"><img src="<%= p.photos[0] %>" alt="<%= p.name %>" loading="lazy"><small>▧ <%= p.photos.length %> foto</small></a><div class="gs-card-body"><h3><a href="/game-store/item/<%= p._id %>"><%= p.name %></a></h3><p class="gs-product-type">Akun · <%= c?c.name:'Game' %></p><span class="gs-stock">● Tersedia</span><div class="gs-price">Rp <%= p.price.toLocaleString('id-ID') %></div><div class="gs-seller"><span class="gs-seller-avatar">★</span><span><%= p.seller %></span></div><a class="gs-card-action" href="/game-store/item/<%= p._id %>">Lihat akun <span>↗</span></a><% if(tab==='mine'){ %><form class="gs-delete" action="/game-store/item/<%= p._id %>/delete" method="post" data-confirm="Hapus postingan dan seluruh komentarnya?"><input type="hidden" name="_csrf" value="<%= gameCsrf %>"><button class="gs-link danger">Hapus postingan</button></form><% } %></div></article>
<% }) %></div>
<% if(!listings.length){ %><div class="gs-empty"><span>★</span><strong>BELUM ADA AKUN!</strong><p><%= tab==='mine'?'Yuk, mulai jual akun pertamamu.':'Coba kata kunci atau kategori game lainnya.' %></p><a class="gs-btn yellow" href="/game-store/new">+ Posting akun</a></div><% } %>
<div class="gs-pages"><% if(page>1){ %><a class="gs-btn" href="?page=<%= page-1 %>&q=<%= encodeURIComponent(query) %>&category=<%= filter %>&sort=<%= sort %>">← Sebelumnya</a><% } %><% if(hasMore){ %><a class="gs-btn" href="?page=<%= page+1 %>&q=<%= encodeURIComponent(query) %>&category=<%= filter %>&sort=<%= sort %>">Berikutnya →</a><% } %></div></section>
<% } %>
<% if(tab==='new'){ %>
<section class="gs-panel"><span class="gs-tag">SELLER MODE / ON</span><h1>POSTING AKUN!</h1><p>Lengkapi spek dan foto asli akunmu. Kolom bertanda * wajib diisi.</p><% if(!categories.length){ %><p class="gs-note">Admin belum menambahkan kategori game. Hubungi admin untuk membuat kategori beserta fotonya.</p><% } %><form action="/game-store/new?csrf=<%= gameCsrf %>" method="post" enctype="multipart/form-data" class="gs-form" data-upload-form><label>Kategori game *<select name="category" required><option value="">Pilih game</option><% categories.forEach(c=>{ %><option value="<%= c._id %>"><%= c.name %></option><% }) %></select></label><div class="gs-cols"><label>Nama akun *<input name="name" required maxlength="120" placeholder="Contoh: Akun FF Sultan Level 70"></label><label>ID game (opsional)<input name="gameId" maxlength="100" placeholder="ID akun di game"></label></div><label>Deskripsi & spek akun *<textarea name="description" required maxlength="5000" rows="5" placeholder="Rank, skin, level, server, metode login, dan detail lainnya"></textarea></label><label>Harga (Rp) *<input name="price" required type="number" min="1" max="100000000000" step="1" placeholder="250000"></label><label class="gs-drop">Foto spek akun *<small>Pilih 2–10 foto sekaligus. JPG, PNG, WebP; maksimal 5 MB per foto.</small><input type="file" name="photos" accept="image/jpeg,image/png,image/webp" required multiple data-photo-input data-min="2" data-max="10"></label><div class="gs-preview" data-preview></div><div class="gs-cols"><label>Hubungi melalui *<select name="channel" id="gs-channel"><option value="wa">WhatsApp — wa.me/</option><option value="telegram">Telegram — t.me/</option></select></label><label><span id="gs-contact-label">Nomor WhatsApp *</span><div class="gs-contact"><span id="gs-prefix">wa.me/</span><input name="contact" id="gs-contact" required maxlength="150" placeholder="628123456789"></div></label></div><p role="alert" data-form-error class="danger"></p><button class="gs-btn yellow wide" <%= !categories.length?'disabled':'' %>>TERBITKAN AKUN ↗</button></form></section>
<% } %>
<% if(tab==='detail'){const p=listing; const c=categories.find(c=>String(c._id)===String(p.category)); %>
<a class="gs-back" href="/game-store">← Kembali ke store</a><section class="gs-detail"><div><div class="gs-main-photo"><img id="gs-main-image" src="<%= p.photos[0] %>" alt="Foto utama <%= p.name %>"></div><div class="gs-thumbs"><% p.photos.forEach((src,i)=>{ %><button type="button" data-photo="<%= src %>" aria-label="Lihat foto <%= i+1 %>"><img src="<%= src %>" alt="Spek <%= i+1 %>"></button><% }) %></div></div><div class="gs-panel"><span class="gs-tag"><%= c?c.name:'GAME ACCOUNT' %></span><h1><%= p.name %></h1><p>@<%= p.seller %> · <%= new Date(p.createdAt).toLocaleDateString('id-ID') %></p><div class="gs-price large">Rp <%= p.price.toLocaleString('id-ID') %></div><% if(p.gameId){ %><p><b>ID game:</b> <%= p.gameId %></p><% } %><p class="gs-description"><%= p.description %></p><a class="gs-btn yellow wide" href="<%= p.contact %>" target="_blank" rel="noopener noreferrer">Hubungi via <%= p.channel==='wa'?'WhatsApp':'Telegram' %> ↗</a><a class="gs-btn wide" href="#comments">↳ Tanya / komentar</a></div></section>
<section id="comments" class="gs-panel"><h2>KOMENTAR & TANYA JAWAB</h2><% if(user){ %><form method="post" action="/game-store/item/<%= p._id %>/comments" class="gs-form"><input type="hidden" name="_csrf" value="<%= gameCsrf %>"><label>Pertanyaan kamu<textarea name="text" required maxlength="1000" rows="3" placeholder="Tanyakan spek, kondisi, atau ketersediaan akun…"></textarea></label><button class="gs-btn">Kirim komentar ↗</button></form><% }else{ %><p><a href="/login">Login</a> untuk bertanya dan membalas komentar.</p><% } %><% if(!comments.length){ %><p>Belum ada komentar. Jadilah yang pertama bertanya!</p><% } %><% comments.filter(c=>!c.parent).forEach(c=>{ %><article class="gs-comment"><b>@<%= c.author %> <%= String(c.owner)===String(p.owner)?'· PENJUAL':'' %></b><small><%= new Date(c.createdAt).toLocaleString('id-ID') %></small><p><%= c.text %></p><% comments.filter(r=>String(r.parent)===String(c._id)).forEach(r=>{ %><div class="gs-reply"><b>@<%= r.author %> <%= String(r.owner)===String(p.owner)?'· PENJUAL':'' %></b><p><%= r.text %></p></div><% }) %><% if(user){ %><details><summary>↳ Balas pertanyaan</summary><form method="post" action="/game-store/item/<%= p._id %>/comments" class="gs-form"><input type="hidden" name="_csrf" value="<%= gameCsrf %>"><input type="hidden" name="parent" value="<%= c._id %>"><label>Balasan<textarea name="text" required maxlength="1000" rows="2"></textarea></label><button class="gs-btn">Kirim balasan</button></form></details><% } %></article><% }) %></section>
<% } %>
</main><footer class="gs-footer"><strong><%= settings.name %> / GAME STORE</strong><span>Temukan akun. Kenali penjual. Mainkan petualangan baru.</span><% if(user && user.role==='admin'){ %><a href="/admin/game-store">Pengaturan store ↗</a><% } %></footer></div><script src="/game-store.js?v=2" defer></script></body></html>
