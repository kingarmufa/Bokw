<%- include('partials/header', { title: 'Riwayat Fix No' }) %>

<div class="max-w-md mx-auto px-6 pb-6 mt-1">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-medium text-gray-800">Riwayat Fix No / Unban WA</h1>
    <a href="/fix-no" class="text-[11.5px] font-bold text-blue-600 flex items-center gap-1">
      <i class="fa-solid fa-plus"></i> Baru
    </a>
  </div>

  <div class="flex flex-col gap-2.5">
    <% if (riwayat.length === 0) { %>
      <div class="comic-panel p-6 text-center">
        <p class="text-xs font-medium text-gray-500">Belum pernah kirim permohonan.</p>
      </div>
    <% } %>
    <% riwayat.forEach(r => { %>
      <div class="riwayat-item">
        <div class="min-w-0">
          <p class="text-[12.5px] font-bold text-gray-800 truncate">
            <%= r.jenis === 'fix_merah' ? 'Fix Nomor Merah' : 'Unban Akun WA' %> &middot; <%= r.phoneNumber %>
          </p>
          <p class="text-[10.5px] text-gray-500">
            Sender <%= r.senderType === 'private' ? 'Private' : 'Global' %> &middot; <%= r.targetsSent %>/<%= r.targetsTotal %> terkirim
          </p>
        </div>
        <span class="status-badge <%= r.status %>">
          <%= ({PROCESSING:'Proses', SENT:'Terkirim', FAILED:'Gagal'})[r.status] || r.status %>
        </span>
      </div>
    <% }) %>
  </div>

</div>

<style>
  .comic-panel { background: #fffdf7; border: 3px solid var(--comic-black); border-radius: 20px; box-shadow: 4px 4px 0 var(--comic-black); }
  .riwayat-item {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 12px 14px;
    border: 2.5px solid var(--comic-black);
    border-radius: 16px;
    background: #fffdf7;
    box-shadow: 2.5px 2.5px 0 var(--comic-black);
  }
  .status-badge { font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 999px; border: 2px solid var(--comic-black); background: #fff; white-space: nowrap; flex-shrink: 0; }
  .status-badge.PROCESSING { background: var(--comic-yellow); }
  .status-badge.SENT { background: var(--comic-blue-light); }
  .status-badge.FAILED { background: #94a3b8; color: #fff; }
</style>

<%- include('partials/footer') %>
