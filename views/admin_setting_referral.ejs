<%- include('partials/header', { title: 'Setting Kode Referral' }) %>

<div class="px-6 pb-6 mt-1 max-w-[480px] md:max-w-lg mx-auto">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <h1 class="text-base font-bold text-gray-800 mb-1">Setting Kode Referral</h1>
  <p class="text-[11.5px] text-gray-500 mb-4">Tiap user otomatis punya kode referral sendiri (bisa dilihat di halaman Profil). Kalau ada orang daftar lewat link/kode itu, dua-duanya bisa dapat saldo sesuai pengaturan di bawah.</p>

  <form method="POST" action="/admin/setting-referral/save" class="bg-white border border-gray-200 rounded-2xl p-4 mb-4">
    <h2 class="text-[13px] font-bold text-gray-800 mb-3"><i class="fa-solid fa-gear mr-1 text-blue-500"></i> Pengaturan Utama</h2>

    <label class="flex items-center justify-between mb-4 cursor-pointer">
      <span class="text-[12px] font-semibold text-gray-700">Aktifkan Kode Referral</span>
      <input type="checkbox" name="referralEnabled" <%= settings.referralEnabled ? 'checked' : '' %> class="w-4 h-4 accent-blue-600">
    </label>

    <div class="mb-3">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">Saldo Diterima Setelah Registrasi (Rp, buat user baru)</label>
      <input type="number" name="referralBonusRegister" min="0" value="<%= settings.referralBonusRegister || 0 %>" class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs">
      <p class="text-[10px] text-gray-400 mt-1">Bonus saldo buat user yang baru daftar pakai link/kode referral orang lain. Isi 0 kalau tidak mau kasih bonus.</p>
    </div>

    <div class="mb-2">
      <label class="block text-[11px] font-bold text-gray-500 mb-1">Saldo Diterima Pemilik Kode/Referral (Rp)</label>
      <input type="number" name="referralBonusReferrer" min="0" value="<%= settings.referralBonusReferrer || 0 %>" class="w-full px-3 py-2 rounded-xl border border-gray-300 text-xs">
      <p class="text-[10px] text-gray-400 mt-1">Bonus saldo buat pemilik kode, tiap kali ada orang berhasil daftar lewat link/kodenya.</p>
    </div>

    <button type="submit" class="w-full py-2.5 rounded-xl bg-blue-600 text-white text-[12.5px] font-bold mt-3">Simpan Pengaturan</button>
  </form>

</div>

<%- include('partials/footer') %>
