<!DOCTYPE html>
<html <%- include('partials/htmlattrs') %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff" />
  <title><%= settings.name %></title>
  
  <% if (settings.description) { %>
  <meta name="description" content="<%= settings.description %>">
  <% } %>
  
  <% if (settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/comic-theme.css">
  <script src="/comic-fx.js" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">  
  <link rel="preconnect" href="https://fonts.googleapis.com">
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { 
      theme: { 
        extend: { 
          fontFamily: { 
            'sans': ['Inter', 'sans-serif']
          }
        } 
      } 
    }
  </script>
  <style>
    :root {
      --cream-top: #f8e3e0;
      --blue-500: #3b82f6;
      --green-600: #16a34a;
    }
    body {
      color: #1f2937;
      margin: 0;
    }
  </style>
  <link rel="stylesheet" href="/auth-anime.css">
  <meta name="theme-color" content="#070b1f">
</head>
<body class="min-h-screen flex flex-col auth-anime" id="authAnime" data-auth="forgot">

  <!-- Konten utama -->
  <div class="flex-1 flex flex-col justify-center items-center px-6 py-16">

    <!-- Card Lupa Password -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-6 py-10 w-full max-w-md flex flex-col gap-6 shadow-sm">
      
      <!-- Logo (jika ada) -->
      <% if (settings.logoUrl) { %>
        <div class="text-center">
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto object-contain mx-auto mb-2">
          <h2 class="text-base font-medium text-gray-800">Lupa Password</h2>
        </div>
      <% } else { %>
        <div class="text-center">
          <h2 class="text-base font-medium text-gray-800">Lupa Password</h2>
        </div>
      <% } %>

      <!-- Alert Error -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-[#fef2f2] border border-[#fecaca] text-[#dc2626] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= error %>
        </div>
      <% } %>

      <!-- Alert Success -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-[#f0fdf4] border border-[#bbf7d0] text-[#16a34a] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= success %>
        </div>
      <% } %>

      <!-- Form Lupa Password -->
      <form method="POST" action="/forgot-password" class="flex flex-col gap-4" id="forgotPasswordForm">
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Email atau Username</label>
          <input name="login" type="text" placeholder="username atau email" 
                 class="w-full bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm px-4 py-3 text-[13.5px] font-medium text-gray-800 outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder:text-[13.5px] placeholder:font-medium placeholder:text-gray-400" 
                 required
                 oninput="this.value = this.value.toLowerCase()">
        </div>

        <button type="submit" id="forgotPasswordBtn" class="bg-blue-600 hover:bg-blue-700 text-white w-full py-3 rounded-xl text-[13.5px] font-semibold shadow-md shadow-blue-600/20 hover:shadow-lg hover:shadow-blue-600/25 hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center mt-2">
          <span id="forgotBtnText">Lanjutkan</span>
          <i id="forgotBtnSpinner" class="fas fa-spinner fa-spin text-[13.5px] hidden ml-2"></i>
        </button>
      </form>

      <!-- Link Kembali ke Login -->
      <p class="text-center text-[13.5px] font-medium text-gray-700">
        Ingat password Anda? 
        <a href="/login" class="text-blue-500 font-medium hover:underline transition-colors">Masuk di sini</a>
      </p>
    </div>

    <!-- Link bawah -->
    <div class="mt-8 text-center flex flex-col gap-6">
      <a href="/" class="text-[13.5px] font-medium text-blue-600 transition-colors flex items-center justify-center gap-1">
        <i class="fas fa-arrow-left text-[13.5px]"></i> Ke Beranda
      </a>
      
      <div class="text-center flex gap-1">
        <p class="text-[13.5px] text-gray-800 font-medium">Butuh bantuan?</p>
        <a href="<%= settings.contactDeveloper || '#' %>" class="text-[13.5px] font-medium text-blue-600 underline transition-colors flex items-center justify-center gap-1">
          Hubungi tim Support
        </a>
      </div>
    </div>

  </div>

  <!-- Script untuk mencegah double submit -->
  <%- include('partials/credit') %>

  <script>
    (function() {
      const form = document.getElementById('forgotPasswordForm');
      const btn = document.getElementById('forgotPasswordBtn');
      const btnText = document.getElementById('forgotBtnText');
      const btnSpinner = document.getElementById('forgotBtnSpinner');

      if (!form || !btn) return;

      let isSubmitting = false;

      form.addEventListener('submit', function(e) {
        // Jika sedang dalam proses, cegah submit lagi
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }

        // Tandai sedang mengirim
        isSubmitting = true;

        // Disable tombol dan ubah tampilannya
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');
        btnText.textContent = 'Memproses...';
        btnSpinner.classList.remove('hidden');
      });

      // Jika pengguna kembali ke halaman (misal dari cache), reset tombol
      window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
          isSubmitting = false;
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
          btnText.textContent = 'Lanjutkan';
          btnSpinner.classList.add('hidden');
        }
      });
    })();
  </script>

</body>
</html>