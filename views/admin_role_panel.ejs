<%- include('partials/header', { title: 'Setting Role Panel' }) %>

<div class="max-w-3xl mx-auto px-6 mt-1 pb-10">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-medium text-gray-800">Setting Role Panel</h1>
    <span class="text-[12px] font-semibold text-gray-500">Reseller &amp; Admin Panel</span>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <%
    const pkgMap = {};
    (resellerSetting.packages || []).forEach(p => { pkgMap[p.key] = p; });
    const p1 = pkgMap['1bulan'] || { price: 0, durationDays: 30 };
    const p5 = pkgMap['5bulan'] || { price: 0, durationDays: 150 };
    const pP = pkgMap['permanen'] || { price: 0 };
    const isSeparate = resellerSetting.mode === 'separate';
  %>

  <!-- ===== HARGA & MODE ROLE RESELLER PANEL ===== -->
  <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-5 mb-6">
    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
      <i class="fa-solid fa-tags text-gray-700 text-sm"></i>
      <h2 class="text-sm font-medium text-gray-800">Harga Role Reseller Panel</h2>
    </div>

    <form method="POST" action="/admin/role-panel/pricing" class="flex flex-col gap-3" id="roleModeForm">
      <label class="block text-xs font-medium text-gray-700 mb-1">Mode Penjualan</label>
      <div class="flex items-center gap-2 mb-1 bg-gray-50 border border-gray-100 rounded-2xl p-1">
        <button type="button" id="tabBtnPermanent" onclick="roleSwitchMode('permanent')"
          class="flex-1 text-center px-3 py-2 rounded-xl text-[12.5px] font-bold transition-colors <%= !isSeparate ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500' %>">
          <i class="fa-solid fa-infinity"></i> Permanen Saja
        </button>
        <button type="button" id="tabBtnSeparate" onclick="roleSwitchMode('separate')"
          class="flex-1 text-center px-3 py-2 rounded-xl text-[12.5px] font-bold transition-colors <%= isSeparate ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500' %>">
          <i class="fa-solid fa-layer-group"></i> Paket Terpisah
        </button>
      </div>
      <input type="hidden" name="mode" id="roleModeInput" value="<%= resellerSetting.mode %>">
      <p class="text-[11px] text-gray-400 -mt-1">
        <b>Permanen Saja</b>: user cuma bisa beli 1 harga, langsung permanen (tidak ada pilihan paket / expired).<br>
        <b>Paket Terpisah</b>: user pilih salah satu dari 3 paket (1 Bulan / 5 Bulan / Permanen), masing-masing punya harga & masa aktif sendiri.
      </p>

      <!-- MODE PERMANEN -->
      <div id="roleModePermanentBox" class="<%= isSeparate ? 'hidden' : '' %> mt-2">
        <label class="block text-xs font-medium text-gray-700 mb-2">Harga Reseller Panel Permanen (Rp)</label>
        <input name="permanentPrice" type="number" value="<%= resellerSetting.permanentPrice %>" placeholder="100000"
          class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
      </div>

      <!-- MODE PAKET TERPISAH -->
      <div id="roleModeSeparateBox" class="<%= !isSeparate ? 'hidden' : '' %> mt-2 flex flex-col gap-3">

        <div class="border border-gray-100 rounded-2xl p-3 bg-gray-50">
          <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-calendar-day text-blue-500 mr-1"></i> Paket 1 Bulan</p>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Harga (Rp)</label>
              <input name="price_1bulan" type="number" value="<%= p1.price %>" placeholder="15000"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Masa Aktif (hari)</label>
              <input name="durasi_1bulan" type="number" value="<%= p1.durationDays %>" placeholder="30"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
          </div>
        </div>

        <div class="border border-gray-100 rounded-2xl p-3 bg-gray-50">
          <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-calendar-days text-purple-500 mr-1"></i> Paket 5 Bulan</p>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Harga (Rp)</label>
              <input name="price_5bulan" type="number" value="<%= p5.price %>" placeholder="60000"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Masa Aktif (hari)</label>
              <input name="durasi_5bulan" type="number" value="<%= p5.durationDays %>" placeholder="150"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
          </div>
        </div>

        <div class="border border-gray-100 rounded-2xl p-3 bg-gray-50">
          <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-infinity text-green-500 mr-1"></i> Paket Permanen</p>
          <label class="block text-xs font-medium text-gray-700 mb-2">Harga (Rp)</label>
          <input name="price_permanen" type="number" value="<%= pP.price %>" placeholder="100000"
            class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
          <p class="text-[11px] text-gray-400 mt-1.5">Paket Permanen tidak punya masa aktif (tidak akan expired).</p>
        </div>

      </div>

      <button type="submit" class="comic-btn-primary mt-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-[13.5px] font-bold">
        <i class="fa-solid fa-floppy-disk"></i> Simpan Harga &amp; Mode
      </button>
    </form>
  </div>

  <!-- ===== ROLE ADMIN PANEL ===== -->
  <%
    const apPkg = {};
    (adminRoleSetting.packages || []).forEach(p => { apPkg[p.key] = p; });
    const a1 = apPkg['1bulan'] || { price: 0, durationDays: 30 };
    const a5 = apPkg['5bulan'] || { price: 0, durationDays: 150 };
    const aP = apPkg['permanen'] || { price: 0 };
    const apSep = adminRoleSetting.mode === 'separate';
    const apSale = adminRoleSetting.saleMode || 'tutup';
    const saleBtn = (val) => apSale === val ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500';
  %>
  <div id="admin-role" class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-5 mb-6">
    <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-gray-200">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-user-shield text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Role Admin Panel</h2>
      </div>
      <span class="text-[11px] font-bold px-2.5 py-1 rounded-full border-2 border-black <%= apSale === 'tutup' ? 'bg-red-100 text-red-700' : (apSale === 'terbatas' ? 'bg-orange-100 text-orange-700' : 'bg-green-100 text-green-700') %>">
        <%= apSale === 'tutup' ? 'DITUTUP' : (apSale === 'terbatas' ? 'TERBATAS' : 'BEBAS') %>
      </span>
    </div>

    <p class="text-[11px] text-gray-400 mb-3">Pemegang role ini bisa membuat <b>1 akun Admin Pterodactyl</b> (1x saja) di salah satu Server di bawah, lengkap dengan PTLA &amp; PTLC otomatis. Pemegang role saat ini: <b><%= adminRoleAvail.holders %></b><%= apSale === 'terbatas' ? ' dari kuota ' + adminRoleSetting.limitQuota : '' %>.</p>

    <form method="POST" action="/admin/role-panel/admin-role" class="flex flex-col gap-3">

      <label class="block text-xs font-medium text-gray-700">Status Penjualan Role</label>
      <div class="flex items-center gap-1 bg-gray-50 border border-gray-100 rounded-2xl p-1">
        <button type="button" data-sale="terbatas" onclick="apSetSale('terbatas')" class="ap-sale-btn flex-1 text-center px-2 py-2 rounded-xl text-[12px] font-bold transition-colors <%= saleBtn('terbatas') %>"><i class="fa-solid fa-hourglass-half"></i> Terbatas</button>
        <button type="button" data-sale="bebas" onclick="apSetSale('bebas')" class="ap-sale-btn flex-1 text-center px-2 py-2 rounded-xl text-[12px] font-bold transition-colors <%= saleBtn('bebas') %>"><i class="fa-solid fa-lock-open"></i> Bebas</button>
        <button type="button" data-sale="tutup" onclick="apSetSale('tutup')" class="ap-sale-btn flex-1 text-center px-2 py-2 rounded-xl text-[12px] font-bold transition-colors <%= saleBtn('tutup') %>"><i class="fa-solid fa-lock"></i> Tutup</button>
      </div>
      <input type="hidden" name="saleMode" id="apSaleInput" value="<%= apSale %>">
      <p class="text-[11px] text-gray-400 -mt-1">
        <b>Terbatas</b>: dijual sampai kuota total pemegang role terpenuhi.<br>
        <b>Bebas</b>: dijual tanpa batas kuota.<br>
        <b>Tutup</b>: semua pembelian role Admin Panel ditutup (termasuk dari menu Role Panel user). Admin tetap bisa memberi role manual lewat Kelola User.
      </p>

      <div id="apQuotaBox" class="<%= apSale === 'terbatas' ? '' : 'hidden' %>">
        <label class="block text-xs font-medium text-gray-700 mb-2">Kuota Total Pemegang Role</label>
        <input name="limitQuota" type="number" min="0" value="<%= adminRoleSetting.limitQuota %>" placeholder="10"
          class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-2">Maks. Akun Admin Panel per Server</label>
        <input name="maxPerServer" type="number" min="0" value="<%= adminRoleSetting.maxPerServer %>" placeholder="0"
          class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
        <p class="text-[11px] text-gray-400 mt-1.5">Isi <b>1</b> kalau 1 server hanya boleh punya 1 akun admin panel. Isi <b>0</b> = tanpa batas (tiap user tetap hanya 1 akun).</p>
      </div>

      <div class="border-t border-gray-100 pt-3">
        <label class="block text-xs font-medium text-gray-700 mb-1">Mode Harga</label>
        <div class="flex items-center gap-2 mb-1 bg-gray-50 border border-gray-100 rounded-2xl p-1">
          <button type="button" id="apBtnPermanent" onclick="apSwitchMode('permanent')" class="flex-1 text-center px-3 py-2 rounded-xl text-[12.5px] font-bold transition-colors <%= !apSep ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500' %>"><i class="fa-solid fa-infinity"></i> Permanen Saja</button>
          <button type="button" id="apBtnSeparate" onclick="apSwitchMode('separate')" class="flex-1 text-center px-3 py-2 rounded-xl text-[12.5px] font-bold transition-colors <%= apSep ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500' %>"><i class="fa-solid fa-layer-group"></i> Paket Terpisah</button>
        </div>
        <input type="hidden" name="mode" id="apModeInput" value="<%= adminRoleSetting.mode %>">
      </div>

      <div id="apPermBox" class="<%= apSep ? 'hidden' : '' %>">
        <label class="block text-xs font-medium text-gray-700 mb-2">Harga Admin Panel Permanen (Rp)</label>
        <input name="permanentPrice" type="number" min="0" value="<%= adminRoleSetting.permanentPrice %>" placeholder="150000"
          class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
      </div>

      <div id="apSepBox" class="<%= !apSep ? 'hidden' : '' %> flex flex-col gap-3">
        <div class="border border-gray-100 rounded-2xl p-3 bg-gray-50">
          <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-calendar-day text-blue-500 mr-1"></i> Paket 1 Bulan</p>
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-gray-700 mb-2">Harga (Rp)</label>
              <input name="price_1bulan" type="number" min="0" value="<%= a1.price %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none"></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-2">Masa Aktif (hari)</label>
              <input name="durasi_1bulan" type="number" min="1" value="<%= a1.durationDays %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none"></div>
          </div>
        </div>
        <div class="border border-gray-100 rounded-2xl p-3 bg-gray-50">
          <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-calendar-days text-purple-500 mr-1"></i> Paket 5 Bulan</p>
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-gray-700 mb-2">Harga (Rp)</label>
              <input name="price_5bulan" type="number" min="0" value="<%= a5.price %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none"></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-2">Masa Aktif (hari)</label>
              <input name="durasi_5bulan" type="number" min="1" value="<%= a5.durationDays %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none"></div>
          </div>
        </div>
        <div class="border border-gray-100 rounded-2xl p-3 bg-gray-50">
          <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-infinity text-green-500 mr-1"></i> Paket Permanen</p>
          <label class="block text-xs font-medium text-gray-700 mb-2">Harga (Rp)</label>
          <input name="price_permanen" type="number" min="0" value="<%= aP.price %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
        </div>
      </div>

      <button type="submit" class="comic-btn-primary mt-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-[13.5px] font-bold">
        <i class="fa-solid fa-floppy-disk"></i> Simpan Role Admin Panel
      </button>
    </form>

    <% if (adminPanelAccounts.length) { %>
      <div class="mt-5 pt-4 border-t border-gray-100">
        <p class="text-[12.5px] font-bold text-gray-800 mb-2"><i class="fa-solid fa-users-gear mr-1 text-gray-500"></i> Akun Admin Panel yang Sudah Dibuat (<%= adminPanelAccounts.length %>)</p>
        <div class="flex flex-col gap-2">
          <% adminPanelAccounts.forEach(function(a) { %>
            <div class="border border-gray-100 rounded-xl px-3 py-2 bg-gray-50 text-[11.5px]">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-gray-800 truncate"><%= a.username %> <span class="font-normal text-gray-400">(user: <%= a.siteUsername %>)</span></span>
                <span class="shrink-0 text-[10px] font-bold px-2 py-0.5 rounded-full border border-black <%= a.keyStatus === 'ok' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-800' %>"><%= a.status === 'creating' ? 'PROSES' : ('KEY ' + (a.keyStatus === 'ok' ? 'OK' : (a.keyStatus === 'partial' ? 'SEBAGIAN' : 'GAGAL'))) %></span>
              </div>
              <p class="text-gray-500 truncate"><%= a.serverName %> · <%= a.domain %> · <%= new Date(a.createdAt).toLocaleDateString('id-ID') %></p>
              <form method="POST" action="/admin/role-panel/account/<%= a._id %>/hapus" class="mt-1.5" onsubmit="return confirm('Hapus akun <%= a.username %>? Slot server dikosongkan.');">
                <button type="submit" class="px-3 py-1.5 rounded-lg border-2 border-black bg-red-100 text-red-700 text-[11px] font-bold"><i class="fa-solid fa-trash"></i> Hapus</button>
              </form>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- ===== SERVER 1-3 (API) ===== -->
  <div class="flex items-center gap-2 mb-3 px-1">
    <i class="fas fa-server text-gray-700 text-sm"></i>
    <h2 class="text-sm font-medium text-gray-800">Setting Server (API)</h2>
  </div>
  <p class="text-[11px] text-gray-400 px-1 mb-3">Kredensial API terpisah dari Server Panel Pterodactyl biasa, dipakai untuk fitur Reseller Panel dan Admin Panel. Tersedia 3 slot server. Untuk Admin Panel, PTLA server harus dari akun admin utama (bisa membuat user root admin).</p>

  <div class="flex flex-col gap-3 mb-6">
    <% resellerServers.forEach(function(s) { %>
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-4">
        <div class="flex items-center justify-between gap-2 mb-3 pb-3 border-b border-gray-100">
          <p class="text-[13.5px] font-bold text-gray-800">Server <%= s.slot %><%= s.name ? ' — ' + s.name : '' %></p>
          <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full border-2 border-black <%= s.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
            <%= s.active ? 'Aktif' : 'Nonaktif' %>
          </span>
        </div>
        <% if (s.domain) { %>
          <p class="text-[12px] text-blue-500 font-medium truncate mb-3"><i class="fa-solid fa-link text-[10px] mr-1"></i><%= s.domain %></p>
        <% } %>
        <div class="flex items-center justify-between gap-2 mb-3 text-[11.5px]">
          <span class="font-bold text-gray-700">Akun Admin Panel: <%= slotCounts[s.slot] || 0 %><%= adminRoleSetting.maxPerServer > 0 ? ' / ' + adminRoleSetting.maxPerServer : ' (tanpa batas)' %></span>
          <% if ((slotCounts[s.slot] || 0) > 0) { %>
            <form method="POST" action="/admin/role-panel/server/<%= s.slot %>/reset-akun" onsubmit="return confirm('Reset SEMUA akun Admin Panel di Server <%= s.slot %>? Hanya data di website, akun di Pterodactyl tidak dihapus.');">
              <button type="submit" class="px-3 py-1.5 rounded-lg border-2 border-black bg-red-100 text-red-700 text-[11px] font-bold"><i class="fa-solid fa-rotate-left"></i> Reset Akun</button>
            </form>
          <% } %>
        </div>

        <form method="POST" action="/admin/role-panel/server/<%= s.slot %>" class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Nama Server</label>
              <input name="name" type="text" value="<%= s.name %>" placeholder="cth: Reseller Node 1"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Domain Panel</label>
              <input name="domain" type="url" value="<%= s.domain %>" placeholder="https://panel.domainkamu.com"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">PTLA (kosongkan jika tidak ganti)</label>
              <input name="ptla" type="text" placeholder="ptla_xxxxxxxxxxxx"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">PTLC (opsional)</label>
              <input name="ptlc" type="text" value="<%= s.ptlc %>" placeholder="ptlc_xxxxxxxxxxxx"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Location ID</label>
              <input name="locationId" type="number" value="<%= s.locationId %>"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-2">Nest ID</label>
              <input name="nestId" type="number" value="<%= s.nestId %>"
                class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
            </div>
          </div>
          <p class="text-[11px] text-gray-400 -mt-1">Pemilihan Egg dilakukan lewat dropdown dinamis berdasarkan Nest ID di atas (sama seperti fitur Pterodactyl), jadi tidak perlu diisi manual di sini.</p>

          <details class="text-xs">
            <summary class="cursor-pointer font-medium text-gray-600 select-none">Pengaturan lanjutan (docker image, startup, environment)</summary>
            <div class="flex flex-col gap-3 mt-3">
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-2">Docker Image (opsional)</label>
                <input name="dockerImage" type="text" value="<%= s.dockerImage %>" placeholder="kosongkan = pakai default egg"
                  class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-2">Startup Command (opsional)</label>
                <input name="startupCommand" type="text" value="<%= s.startupCommand %>" placeholder="kosongkan = pakai default egg"
                  class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-2">Environment Variables</label>
                <textarea name="environment" rows="3" placeholder="KEY=VALUE&#10;SATU_LAGI=VALUE"
                  class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm p-2.5 text-xs font-medium outline-none"><%= s.environment %></textarea>
                <p class="text-[11px] text-gray-400 mt-1.5">Satu baris untuk satu variabel, format KEY=VALUE.</p>
              </div>
            </div>
          </details>

          <label class="flex items-center gap-2 text-xs font-medium text-gray-700">
            <input type="checkbox" name="active" <%= s.active ? 'checked' : '' %> class="w-4 h-4">
            Aktifkan server ini
          </label>

          <button type="submit" class="comic-btn-primary mt-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-[13.5px] font-bold">
            <i class="fa-solid fa-floppy-disk"></i> Simpan Server <%= s.slot %>
          </button>
        </form>
      </div>
    <% }); %>
  </div>

</div>

<script>
  function roleSwitchMode(mode) {
    const permBox = document.getElementById('roleModePermanentBox');
    const sepBox = document.getElementById('roleModeSeparateBox');
    const btnPerm = document.getElementById('tabBtnPermanent');
    const btnSep = document.getElementById('tabBtnSeparate');
    const input = document.getElementById('roleModeInput');
    if (!permBox || !sepBox || !input) return;

    const activeCls = ['bg-white', 'shadow-sm', 'text-gray-800'];
    input.value = mode;
    if (mode === 'separate') {
      permBox.classList.add('hidden');
      sepBox.classList.remove('hidden');
      btnSep.classList.add(...activeCls);
      btnSep.classList.remove('text-gray-500');
      btnPerm.classList.remove(...activeCls);
      btnPerm.classList.add('text-gray-500');
    } else {
      sepBox.classList.add('hidden');
      permBox.classList.remove('hidden');
      btnPerm.classList.add(...activeCls);
      btnPerm.classList.remove('text-gray-500');
      btnSep.classList.remove(...activeCls);
      btnSep.classList.add('text-gray-500');
    }
  }
</script>

<script>
  function apSetSale(v) {
    document.getElementById('apSaleInput').value = v;
    const on = ['bg-white', 'shadow-sm', 'text-gray-800'];
    document.querySelectorAll('.ap-sale-btn').forEach(b => {
      const active = b.dataset.sale === v;
      on.forEach(c => b.classList.toggle(c, active));
      b.classList.toggle('text-gray-500', !active);
    });
    document.getElementById('apQuotaBox').classList.toggle('hidden', v !== 'terbatas');
  }
  function apSwitchMode(mode) {
    const sep = mode === 'separate';
    document.getElementById('apModeInput').value = mode;
    document.getElementById('apPermBox').classList.toggle('hidden', sep);
    document.getElementById('apSepBox').classList.toggle('hidden', !sep);
    const on = ['bg-white', 'shadow-sm', 'text-gray-800'];
    const bp = document.getElementById('apBtnPermanent'), bs = document.getElementById('apBtnSeparate');
    on.forEach(c => { bp.classList.toggle(c, !sep); bs.classList.toggle(c, sep); });
    bp.classList.toggle('text-gray-500', sep); bs.classList.toggle('text-gray-500', !sep);
  }
</script>

