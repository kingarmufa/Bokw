<%- include('partials/header', { title: 'Tiket CS Bantuan' }) %>

<div class="app-container pb-6 mt-1 px-6 sm:px-6 max-w-full overflow-x-hidden">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-medium text-gray-800 mb-0">🎫 Tiket CS Bantuan</h1>
  </div>

  <div class="flex items-center gap-2 mb-4">
    <a href="/admin/tickets" class="px-3 py-1.5 rounded-full text-[12px] font-bold border-2 border-black <%= statusFilter === 'all' ? 'bg-[var(--comic-blue)] text-white' : 'bg-white text-gray-700' %>">Semua</a>
    <a href="/admin/tickets?status=open" class="px-3 py-1.5 rounded-full text-[12px] font-bold border-2 border-black <%= statusFilter === 'open' ? 'bg-[var(--comic-blue)] text-white' : 'bg-white text-gray-700' %>">Terbuka</a>
    <a href="/admin/tickets?status=closed" class="px-3 py-1.5 rounded-full text-[12px] font-bold border-2 border-black <%= statusFilter === 'closed' ? 'bg-[var(--comic-blue)] text-white' : 'bg-white text-gray-700' %>">Ditutup</a>
  </div>

  <% if (!tickets || tickets.length === 0) { %>
    <div class="bg-white comic-anim border border-gray-100 rounded-2xl px-5 py-10 text-center">
      <i class="fa-solid fa-inbox text-3xl text-gray-300 mb-3"></i>
      <p class="text-sm font-medium text-gray-600 mb-0">Belum ada tiket bantuan.</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% tickets.forEach(function(t) { %>
        <% const lastMsg = t.messages && t.messages.length ? t.messages[t.messages.length - 1] : null; %>
        <a href="/admin/tickets/<%= t._id %>" class="comic-anim block bg-white border border-gray-100 rounded-2xl px-4 py-3.5 shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300">
          <div class="flex items-start justify-between gap-2 mb-1">
            <h2 class="text-[14px] font-bold text-gray-800 leading-snug break-words"><%= t.title %></h2>
            <% if (t.unreadForAdmin) { %>
              <span class="shrink-0 text-[9px] font-extrabold uppercase bg-[var(--comic-red)] text-white px-2 py-1 rounded-full border-2 border-black">Baru</span>
            <% } %>
          </div>
          <p class="text-[12px] text-gray-500 font-medium mb-2">
            <i class="fa-solid fa-circle-user"></i>
            <%= t.user ? t.user.username : '(user dihapus)' %>
            <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded border border-gray-300 ml-1">
              <%= t.user && t.user.role === 'merchant' ? 'Merchant' : 'User' %>
            </span>
          </p>
          <p class="text-[12px] text-gray-500 font-medium truncate mb-2">
            <% if (lastMsg) { %>
              <%= lastMsg.sender === 'admin' ? 'CS: ' : 'User: ' %><%= lastMsg.image && !lastMsg.message ? '📷 Mengirim gambar' : lastMsg.message %>
            <% } else { %>
              Belum ada pesan.
            <% } %>
          </p>
          <div class="flex items-center justify-between">
            <span class="text-[10.5px] font-bold uppercase px-2 py-1 rounded-full border-2 border-black <%= t.status === 'closed' ? 'bg-gray-200 text-gray-600' : 'bg-[var(--comic-yellow)] text-black' %>">
              <%= t.status === 'closed' ? 'Ditutup' : (t.lastSender === 'user' ? 'Perlu Dibalas' : 'Menunggu User') %>
            </span>
            <span class="text-[10.5px] text-gray-400 font-medium">
              <%= new Date(t.updatedAt).toLocaleString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
