<!DOCTYPE html>
<html <%- include('partials/htmlattrs') %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff" />
  <title><%= settings.name %></title>

  <% if (settings.description) { %>
  <meta name="description" content="<%= settings.description %>">
  <% } %>

  <% if (settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/comic-theme.css">
  <script src="/comic-fx.js" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'sans': ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --cream-top: #f8e3e0;
      --blue-500: #3b82f6;
      --green-600: #16a34a;
    }
    body {
      color: #1f2937;
      margin: 0;
    }
    .method-option { cursor: pointer; }
    .method-option input { display: none; }
    .method-option .box {
      border: 1.5px solid #e5e7eb;
      transition: all .15s ease;
    }
    .method-option input:checked + .box {
      border-color: #3b82f6;
      background-color: #eff6ff;
      box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
    }
    .method-option.disabled { cursor: not-allowed; opacity: .5; }
  </style>
  <link rel="stylesheet" href="/auth-anime.css">
  <meta name="theme-color" content="#070b1f">
</head>
<body class="min-h-screen flex flex-col auth-anime" id="authAnime" data-auth="forgot">

  <div class="flex-1 flex flex-col justify-center items-center px-6 py-16">

    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-6 py-10 w-full max-w-md flex flex-col gap-6 shadow-sm">

      <% if (settings.logoUrl) { %>
        <div class="text-center">
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto object-contain mx-auto mb-2">
          <h2 class="text-base font-medium text-gray-800">Pilih Metode Kirim OTP</h2>
        </div>
      <% } else { %>
        <div class="text-center">
          <h2 class="text-base font-medium text-gray-800">Pilih Metode Kirim OTP</h2>
        </div>
      <% } %>

      <p class="text-center text-[13px] text-gray-500 -mt-2">Kami akan mengirimkan kode OTP untuk memverifikasi bahwa ini benar akun kamu.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-[#fef2f2] border border-[#fecaca] text-[#dc2626] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/forgot-password/method" class="flex flex-col gap-3" id="methodForm">

        <label class="method-option <%= fp.emailAvailable ? '' : 'disabled' %>">
          <input type="radio" name="method" value="email" <%= fp.emailAvailable ? '' : 'disabled' %> <%= fp.emailAvailable ? 'checked' : '' %>>
          <div class="box rounded-2xl px-4 py-3.5 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500 flex items-center justify-center shrink-0">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div class="flex-1">
              <p class="text-[13.5px] font-semibold text-gray-800">OTP via Email (Gmail)</p>
              <p class="text-[12px] text-gray-500">
                <% if (fp.emailAvailable) { %>Kode OTP dikirim ke email yang terdaftar<% } else { %>Tidak tersedia untuk akun ini<% } %>
              </p>
            </div>
          </div>
        </label>

        <label class="method-option <%= fp.telegramAvailable ? '' : 'disabled' %>">
          <input type="radio" name="method" value="telegram" <%= fp.telegramAvailable ? '' : 'disabled' %> <%= (!fp.emailAvailable && fp.telegramAvailable) ? 'checked' : '' %>>
          <div class="box rounded-2xl px-4 py-3.5 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500 flex items-center justify-center shrink-0">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="#ffffff"><path d="M21.94 4.12a1.4 1.4 0 0 0-1.42-.24L2.7 10.6a1.36 1.36 0 0 0 .07 2.55l4.62 1.5 1.78 5.75c.1.34.36.6.68.7.09.03.19.04.28.04.24 0 .48-.09.66-.26l2.58-2.4 4.77 3.53c.24.18.54.27.83.24a1.35 1.35 0 0 0 1.13-1.01L22.4 5.5a1.4 1.4 0 0 0-.46-1.38ZM9.4 14.3l-.7 3.5-1.28-4.13 10.4-6.9L9.4 14.3Zm2.15 4.44-.98-3.16 1.9-1.68.02 2.9-.94 1.94Z"/></svg>
            </div>
            <div class="flex-1">
              <p class="text-[13.5px] font-semibold text-gray-800">OTP via Bot Telegram</p>
              <p class="text-[12px] text-gray-500">
                <% if (fp.telegramAvailable) { %>Kode OTP dikirim ke ID Telegram akun ini<% } else { %>ID Telegram belum diatur / bot nonaktif<% } %>
              </p>
            </div>
          </div>
        </label>

        <button type="submit" id="methodBtn" class="bg-blue-600 hover:bg-blue-700 text-white w-full py-3 rounded-xl text-[13.5px] font-semibold shadow-md shadow-blue-600/20 hover:shadow-lg hover:shadow-blue-600/25 hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center mt-2">
          <span id="methodBtnText">Kirim Kode OTP</span>
          <i id="methodBtnSpinner" class="fas fa-spinner fa-spin text-[13.5px] hidden ml-2"></i>
        </button>
      </form>

      <p class="text-center text-[13.5px] font-medium text-gray-700">
        <a href="/forgot-password" class="text-blue-500 font-medium hover:underline transition-colors">
          <i class="fas fa-arrow-left text-[11px] mr-1"></i>Kembali
        </a>
      </p>
    </div>

    <div class="mt-8 text-center flex flex-col gap-6">
      <div class="text-center flex gap-1 justify-center">
        <p class="text-[13.5px] text-gray-800 font-medium">Butuh bantuan?</p>
        <a href="<%= settings.contactDeveloper || '#' %>" class="text-[13.5px] font-medium text-blue-600 underline transition-colors flex items-center justify-center gap-1">
          Hubungi tim Support
        </a>
      </div>
    </div>

  </div>

  <%- include('partials/credit') %>

  <script>
    (function() {
      const form = document.getElementById('methodForm');
      const btn = document.getElementById('methodBtn');
      const btnText = document.getElementById('methodBtnText');
      const btnSpinner = document.getElementById('methodBtnSpinner');
      if (!form || !btn) return;
      let isSubmitting = false;
      form.addEventListener('submit', function(e) {
        const checked = form.querySelector('input[name="method"]:checked');
        if (!checked) {
          e.preventDefault();
          alert('Silakan pilih salah satu metode OTP.');
          return false;
        }
        if (isSubmitting) { e.preventDefault(); return false; }
        isSubmitting = true;
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');
        btnText.textContent = 'Mengirim...';
        btnSpinner.classList.remove('hidden');
      });
      window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
          isSubmitting = false;
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
          btnText.textContent = 'Kirim Kode OTP';
          btnSpinner.classList.add('hidden');
        }
      });
    })();
  </script>

</body>
</html>
