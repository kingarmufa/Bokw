<!DOCTYPE html>
<html <%- include('partials/htmlattrs') %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff" />
  <title><%= settings.name %></title>

  <% if (settings.description) { %>
  <meta name="description" content="<%= settings.description %>">
  <% } %>

  <% if (settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'sans': ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --cream-top: #f8e3e0;
      --blue-500: #3b82f6;
      --green-600: #16a34a;
    }
    body {
      color: #1f2937;
      margin: 0;
    }
    #otpInput {
      letter-spacing: 10px;
      text-align: center;
      font-size: 22px;
      font-weight: 700;
    }
  </style>
  <style>
    /* Tampilan register: polos & bersih (tanpa tema kuning/komik) */
    html, body { background: #f1f5f9 !important; }
    body { font-family: 'Inter', system-ui, sans-serif; color: #1f2937; }
    button[type=submit] { background: #1d4ed8 !important; color: #fff !important; }
    button[type=submit]:hover { background: #1e40af !important; }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <div class="flex-1 flex flex-col justify-center items-center px-6 py-16">

    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 shadow-md transition-shadow duration-300 px-6 py-10 w-full max-w-md flex flex-col gap-6 shadow-sm">

      <% const isWa = (reg.method === 'whatsapp'); %>
      <% const isTg = (reg.method === 'telegram'); %>
      <% const vTitle = isWa ? 'Verifikasi WhatsApp' : (isTg ? 'Verifikasi Telegram' : 'Verifikasi Gmail'); %>
      <% if (settings.logoUrl) { %>
        <div class="text-center">
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto object-contain mx-auto mb-2">
          <h2 class="text-base font-medium text-gray-800"><%= vTitle %></h2>
        </div>
      <% } else { %>
        <div class="text-center">
          <h2 class="text-base font-medium text-gray-800"><%= vTitle %></h2>
        </div>
      <% } %>

      <p class="text-center text-[13px] text-gray-500 -mt-2">
        Kode OTP 6 digit telah dikirim ke <%= isWa ? 'WhatsApp' : (isTg ? 'Telegram' : 'email') %>
        <span class="font-semibold text-gray-700"><%= reg.target %></span>.
        Berlaku 5 menit. Akun Anda baru dibuat setelah kode ini diverifikasi.
      </p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-[#fef2f2] border border-[#fecaca] text-[#dc2626] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-[#f0fdf4] border border-[#bbf7d0] text-[#16a34a] px-5 py-4 rounded-xl text-[13.5px] font-medium">
          <%= success %>
        </div>
      <% } %>

      <form method="POST" action="/register/verify-otp" class="flex flex-col gap-4" id="otpForm">
        <div>
          <label class="block text-[13.5px] font-medium text-gray-800 mb-2 px-1">Kode OTP</label>
          <input name="otp" id="otpInput" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="------"
                 class="w-full bg-[#f9f9f9] border border-gray-100 rounded-2xl shadow-sm px-4 py-3 outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder:text-gray-300"
                 required autocomplete="one-time-code">
        </div>

        <button type="submit" id="otpBtn" class="bg-blue-600 hover:bg-blue-700 text-white w-full py-3 rounded-xl text-[13.5px] font-semibold shadow-md shadow-blue-600/20 hover:shadow-lg hover:shadow-blue-600/25 hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center mt-2">
          <span id="otpBtnText">Verifikasi &amp; Buat Akun</span>
          <i id="otpBtnSpinner" class="fas fa-spinner fa-spin text-[13.5px] hidden ml-2"></i>
        </button>
      </form>

      <p class="text-center text-[13.5px] font-medium text-gray-700">
        Tidak menerima kode?
        <a href="/register" class="text-blue-500 font-medium hover:underline transition-colors">Daftar ulang untuk kirim kode baru</a>
      </p>
    </div>

    <div class="mt-8 text-center flex flex-col gap-6">
      <a href="/" class="text-[13.5px] font-medium text-blue-600 transition-colors flex items-center justify-center gap-1">
        <i class="fas fa-arrow-left text-[13.5px]"></i> Ke Beranda
      </a>

      <div class="text-center flex gap-1 justify-center">
        <p class="text-[13.5px] text-gray-800 font-medium">Butuh bantuan?</p>
        <a href="<%= settings.contactDeveloper || '#' %>" class="text-[13.5px] font-medium text-blue-600 underline transition-colors flex items-center justify-center gap-1">
          Hubungi tim Support
        </a>
      </div>
    </div>

  </div>

  <%- include('partials/credit') %>

  <script>
    (function() {
      const otpInput = document.getElementById('otpInput');
      otpInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
      });
      otpInput.focus();

      const form = document.getElementById('otpForm');
      const btn = document.getElementById('otpBtn');
      const btnText = document.getElementById('otpBtnText');
      const btnSpinner = document.getElementById('otpBtnSpinner');
      if (!form || !btn) return;
      let isSubmitting = false;
      form.addEventListener('submit', function(e) {
        if (isSubmitting) { e.preventDefault(); return false; }
        isSubmitting = true;
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');
        btnText.textContent = 'Memverifikasi...';
        btnSpinner.classList.remove('hidden');
      });
      window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
          isSubmitting = false;
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
          btnText.textContent = 'Verifikasi & Buat Akun';
          btnSpinner.classList.add('hidden');
        }
      });
    })();
  </script>

</body>
</html>
