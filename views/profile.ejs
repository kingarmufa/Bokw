              <span class="pf-val muted">-</span>
              <span class="pf-tag no">Belum Terhubung</span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="pf-row">
        <span class="pf-ico"><i class="fa-brands fa-whatsapp"></i></span>
        <div class="pf-rc"><span class="pf-lbl">Nomor WhatsApp</span>
          <div class="pf-line">
            <% if (user.whatsappNumber && user.whatsappNumber.trim() !== '') { %>
              <span class="pf-val">+<%= user.whatsappNumber %></span>
              <span class="pf-tag ok"><i class="fa-solid fa-check"></i> Terverifikasi</span>
            <% } else { %>
              <span class="pf-val muted">-</span>
              <span class="pf-tag no">Belum Terhubung</span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="pf-row">
        <span class="pf-ico"><i class="fa-solid fa-key"></i></span>
        <div class="pf-rc"><span class="pf-lbl">API Key</span>
          <div class="pf-line" style="flex-wrap:nowrap">
            <span id="tableApiKeyDisplay" class="pf-val" style="min-width:0"><%= maskedApiKey %></span>
            <% if (rawApiKey) { %>
              <button type="button" onclick="toggleTableApiKey()" class="pf-eye" title="Tampilkan/Sembunyikan API Key">
                <i id="tableApiKeyToggleIcon" class="far fa-eye"></i>
              </button>
              <button type="button" onclick="copyTableApiKey()" class="pf-eye" style="margin-left:0" title="Salin API Key">
                <i class="far fa-copy"></i>
              </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>


<style>
