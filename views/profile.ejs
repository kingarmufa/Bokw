      </div>
      <div class="pf-row">
        <span class="pf-ico"><i class="fa-brands fa-telegram"></i></span>
        <div class="pf-rc"><span class="pf-lbl">ID Telegram</span>
          <div class="pf-line">
            <% if (user.telegramId && user.telegramId.trim() !== '') { %>
              <span class="pf-val"><%= user.telegramId %></span>
              <span class="pf-tag ok"><i class="fa-solid fa-check"></i> Terhubung</span>
