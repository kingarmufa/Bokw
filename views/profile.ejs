<%- include('partials/header', { title: 'Profil' }) %>

<%
  let rawApiKey = '';
  if (typeof apiKeys !== 'undefined' && apiKeys.length > 0) {
    rawApiKey = apiKeys[0].key;
  } else if (user.apiKey) {
    rawApiKey = user.apiKey;
  }
  let maskedApiKey = rawApiKey ? '••••••••' : 'Belum ada API Key';
  const avatarSrc = user.avatarUrl && user.avatarUrl.trim() ? user.avatarUrl : 'https://api.dicebear.com/7.x/identicon/svg?seed=' + user.username;
  const joinDate = new Date(user.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  const roleClass = user.role === 'merchant' ? 'r-merchant' : (user.role === 'vip' ? 'r-vip' : 'r-user');
%>

<style data-comic-owned>
  /* ============ PROFIL — TAMPILAN KOMIK (garis luar transparan, bayangan keras) ============ */
  .custom-scroll::-webkit-scrollbar { width: 2px; height: 2px; }
  .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 4px; }

  .pf-wrap { max-width: 44rem; margin: 0 auto; padding: 4px 16px 12px; }

  /* Judul stiker */
  .pf-title-row { display: flex; align-items: center; gap: 10px; margin: 6px 0 18px; }
  .pf-title { display: inline-block; margin: 0; padding: 6px 18px 4px; font-size: 2rem; line-height: 1; text-transform: uppercase;
    background: var(--cm-white); --cm-fg: var(--cm-ink); border-radius: 10px; transform: rotate(-2deg);
    box-shadow: 4px 4px 0 var(--cm-shadow); }
  .pf-title-tag { font-family: Bangers, Impact, sans-serif; font-size: 1.05rem; letter-spacing: .08em; padding: 3px 10px 1px; border-radius: 6px;
    background: var(--cm-ink); --cm-fg: var(--cm-yellow); transform: rotate(3deg); }
  html[data-theme=black] .pf-title-tag { background: var(--cm-yellow); --cm-fg: var(--cm-ink); }

  /* Kartu dasar: garis luar TRANSPARAN, tegas lewat bayangan keras */
  .pf-card { position: relative; background: var(--cm-white) !important; --cm-fg: var(--cm-ink) !important; --cm-edge: var(--cm-ink) !important;
    border: 3px solid transparent !important; border-radius: 16px !important; box-shadow: 6px 6px 0 var(--cm-shadow) !important;
    margin-bottom: 22px; overflow: hidden; }
  .pf-card-head { display: flex; align-items: center; gap: 10px; padding: 11px 16px 8px; background: var(--cm-ink); --cm-fg: var(--cm-yellow);
    font-family: Bangers, Impact, sans-serif; font-size: 1.3rem; letter-spacing: .07em; text-transform: uppercase; }
  .pf-card-head i { font-size: 1rem; }
  .pf-card-body { padding: 16px; background-image: radial-gradient(circle, rgba(23,23,23,.08) 1px, transparent 1.2px); background-size: 12px 12px; }

  /* Hero */
  .pf-hero-top { position: relative; height: 104px; background: var(--cm-yellow);
    background-image: radial-gradient(circle, rgba(23,23,23,.28) 1.6px, transparent 1.8px), repeating-linear-gradient(115deg, transparent 0 22px, rgba(255,255,255,.35) 22px 34px);
    background-size: 12px 12px, auto; }
  .pf-hero-top::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 22px; background: var(--cm-white);
    clip-path: polygon(0 100%, 0 60%, 6% 30%, 12% 65%, 19% 25%, 26% 62%, 33% 28%, 40% 64%, 47% 24%, 54% 62%, 61% 28%, 68% 64%, 75% 26%, 82% 62%, 89% 30%, 95% 62%, 100% 40%, 100% 100%); }
  .pf-hero-top.has-banner { height: auto; aspect-ratio: 3 / 1; background-image: none; background-color: var(--cm-ink); }
  .pf-banner-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .pf-pow { position: absolute; top: 12px; right: 14px; font-family: Bangers, Impact, sans-serif; font-size: 1.5rem; letter-spacing: .06em; padding: 4px 12px 1px;
    background: var(--cm-white); --cm-fg: var(--cm-ink); border-radius: 8px; transform: rotate(6deg); box-shadow: 3px 3px 0 var(--cm-ink); }
  .pf-hero-main { position: relative; margin-top: -58px; padding: 0 18px 20px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pf-av-wrap { position: relative; width: 118px; height: 118px; display: grid; place-items: center; }
  .pf-burst { position: absolute; inset: -6px; background: var(--cm-ink); clip-path: polygon(50% 0, 60% 14%, 76% 6%, 78% 23%, 94% 24%, 88% 40%, 100% 50%, 88% 60%, 94% 76%, 78% 77%, 76% 94%, 60% 86%, 50% 100%, 40% 86%, 24% 94%, 22% 77%, 6% 76%, 12% 60%, 0 50%, 12% 40%, 6% 24%, 22% 23%, 24% 6%, 40% 14%); animation: pfSpin 24s linear infinite; }
  .pf-avatar { position: relative; width: 92px; height: 92px; border-radius: 50%; object-fit: cover; background: var(--cm-white);
    box-shadow: 0 0 0 4px var(--cm-yellow), 4px 4px 0 4px var(--cm-ink); }
  @keyframes pfSpin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .pf-burst { animation: none; } }
  .pf-name { margin: 12px 0 2px; font-size: 1.9rem; line-height: 1.05; word-break: break-word; }
  .pf-mail { margin: 0 0 10px; font-size: 13px; opacity: .8; word-break: break-all; }
  .pf-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: 14px; }
  .pf-role { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px 3px; border-radius: 999px; font-family: Bangers, Impact, sans-serif; font-size: .95rem; letter-spacing: .08em; text-transform: uppercase; border: 2px solid transparent; box-shadow: 2px 2px 0 var(--cm-ink); }
  .pf-role.r-user { background: var(--cm-yellow); --cm-fg: var(--cm-ink); }
  .pf-role.r-vip { background: #d4af37; --cm-fg: var(--cm-ink); }
  .pf-role.r-merchant { background: var(--cm-ink); --cm-fg: var(--cm-white); }
  .pf-role.r-admin { background: #dc2626; --cm-fg: #fff; }
  .pf-role.r-seller { background: #1d4ed8; --cm-fg: #fff; }
  .pf-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; margin-bottom: 14px; }
  .pf-stat { padding: 8px 10px 7px; border-radius: 10px; background: #f6f0d2; border: 2px dashed transparent; box-shadow: 3px 3px 0 rgba(23,23,23,.9); text-align: left; min-width: 0; }
  .pf-stat small { display: block; font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .pf-stat b { display: block; font-size: 13.5px; overflow-wrap: anywhere; }
  .pf-upload { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 100%; }
  .pf-hint { font-size: 11px; opacity: .65; }

  /* Tombol komik: garis luar transparan */
  button.pf-btn, button.pf-cta { border-color: transparent !important; background: var(--cm-yellow) !important; --cm-fg: var(--cm-ink) !important;
    box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  button.pf-btn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px 6px; border-radius: 9px; font-family: Bangers, Impact, sans-serif; font-size: 1.05rem; letter-spacing: .06em; }
  button.pf-cta { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 12px 16px 9px; border-radius: 12px;
    font-family: Bangers, Impact, sans-serif; font-size: 1.5rem; letter-spacing: .08em; text-transform: uppercase; box-shadow: 5px 5px 0 var(--cm-shadow) !important; }
  button.pf-cta:not(:disabled):hover, button.pf-btn:not(:disabled):hover { transform: translate(-1px,-1px); }
  button.pf-cta:not(:disabled):active, button.pf-btn:not(:disabled):active { transform: translate(3px,3px); box-shadow: 1px 1px 0 var(--cm-ink) !important; }
  button.pf-icon { display: inline-grid; place-items: center; width: 40px; min-height: 40px; padding: 0; border-radius: 9px; border-color: transparent !important;
    background: var(--cm-ink) !important; --cm-fg: var(--cm-yellow) !important; box-shadow: 3px 3px 0 var(--cm-yellow), 3px 3px 0 1px var(--cm-ink) !important; flex-shrink: 0; }
  button.pf-eye { display: inline-grid; place-items: center; width: 30px; height: 30px; min-height: 0; padding: 0; margin-left: 6px; border-radius: 8px; border-color: transparent !important;
    background: var(--cm-ink) !important; --cm-fg: var(--cm-yellow) !important; box-shadow: 2px 2px 0 rgba(23,23,23,.35) !important; flex-shrink: 0; }
  button.pf-eye i { font-size: 12px; }

  /* Daftar info (pengganti tabel) */
  .pf-row { display: flex; align-items: center; gap: 12px; padding: 11px 16px; border-bottom: 2px dashed rgba(23,23,23,.28); }
  .pf-row:last-child { border-bottom: 0; }
  .pf-row:nth-child(even) { background: rgba(237,197,49,.16); }
  .pf-ico { width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center; border-radius: 10px; background: var(--cm-ink); --cm-fg: var(--cm-yellow); transform: rotate(-4deg); box-shadow: 2px 2px 0 var(--cm-yellow), 2px 2px 0 1px rgba(23,23,23,.9); }
  .pf-ico i { font-size: 14px; }
  .pf-rc { min-width: 0; flex: 1; display: flex; flex-direction: column; }
  .pf-lbl { font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; opacity: .62; line-height: 1.2; }
  .pf-val { font-size: 14px; font-weight: 700; overflow-wrap: anywhere; line-height: 1.35; }
  .pf-val.muted { opacity: .55; }
  .pf-line { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .pf-tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px 1px; border-radius: 999px; font-size: 10.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .pf-tag.ok { background: var(--cm-ink); --cm-fg: var(--cm-yellow); }
  .pf-tag.no { background: transparent; border: 2px dashed rgba(23,23,23,.55); }

  /* Alert */
  .pf-alert { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; padding: 12px 14px; border-radius: 12px; border: 3px solid transparent; font-size: 13.5px; font-weight: 800; box-shadow: 4px 4px 0 var(--cm-shadow); }
  .pf-alert.ok { background: var(--cm-yellow); --cm-fg: var(--cm-ink); }
  .pf-alert.err { background: var(--cm-ink); --cm-fg: var(--cm-white); }
  .pf-alert .pf-alert-ico { width: 32px; height: 32px; flex-shrink: 0; display: grid; place-items: center; border-radius: 9px; background: var(--cm-white); --cm-fg: var(--cm-ink); }

  /* Referral */
  .pf-field { display: flex; gap: 8px; align-items: center; margin-bottom: 14px; }
  .pf-field:last-child { margin-bottom: 0; }
  .pf-field input { flex: 1; min-width: 0; }
  .pf-sublbl { display: block; margin: 0 0 5px 2px; font-size: 11px; letter-spacing: .07em; text-transform: uppercase; opacity: .7; }

  /* Popup Edit Informasi — kartu tanpa garis luar */
  #editInfoModal .cp-card { max-width: 28rem; border-color: transparent !important; border-radius: 16px; box-shadow: 6px 6px 0 var(--cm-yellow), 10px 10px 0 var(--cm-ink); }
  #editInfoModal .pf-mhead { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-shrink: 0; padding: 12px 16px 9px; background: var(--cm-yellow); --cm-fg: var(--cm-ink);
    background-image: radial-gradient(circle, rgba(23,23,23,.22) 1.4px, transparent 1.6px); background-size: 11px 11px; }
  #editInfoModal .pf-mhead h3 { margin: 0; font-size: 1.7rem; line-height: 1; text-transform: uppercase; }
  #editInfoModal .pf-mhead h3 i { margin-right: 8px; font-size: 1.2rem; }
  #editInfoModal button.pf-x { display: grid; place-items: center; width: 38px; min-height: 38px; padding: 0; border-radius: 9px; border-color: transparent !important; background: var(--cm-white) !important; --cm-fg: var(--cm-ink) !important; box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  #editInfoModal .pf-mbody { padding: 16px 16px 0; overflow-y: auto; -webkit-overflow-scrolling: touch; flex: 1; background-image: radial-gradient(circle, rgba(23,23,23,.09) 1px, transparent 1.2px); background-size: 12px 12px; }
  #editInfoModal .pf-form label { font-family: Bangers, Impact, sans-serif; font-weight: 400 !important; font-size: 1.05rem !important; letter-spacing: .05em; }
  #editInfoModal .pf-form label span, #editInfoModal .pf-form label b { font-family: 'Comic Neue', Arial, sans-serif; letter-spacing: 0; }
  #editInfoModal .pf-form input:not([type=hidden]) { border-radius: 9px !important; }
  #editInfoModal .pf-form .bg-amber-50 { background: var(--cm-yellow) !important; border-color: transparent !important; box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  #editInfoModal .pf-form .border-t { border-top: 3px dashed rgba(23,23,23,.4) !important; }


  /* ===== Edit Informasi — kuning dibedakan dari latar halaman (soft, tidak terlalu kuning) ===== */
  button.pf-cta { background: color-mix(in srgb, var(--cm-yellow) 45%, #fff) !important; border: 3px solid var(--cm-ink) !important; box-shadow: 5px 5px 0 var(--cm-ink) !important; }
  button.pf-btn { background: color-mix(in srgb, var(--cm-yellow) 45%, #fff) !important; border: 2.5px solid var(--cm-ink) !important; }
  html body #editInfoModal.cp-overlay .cp-card { background: color-mix(in srgb, var(--cm-yellow) 12%, #fff) !important; border: 3px solid var(--cm-ink) !important; box-shadow: 6px 6px 0 color-mix(in srgb, var(--cm-yellow) 75%, #fff), 9px 9px 0 var(--cm-ink); }
  #editInfoModal .pf-mhead { background: color-mix(in srgb, var(--cm-yellow) 45%, #fff); border-bottom: 3px solid var(--cm-ink);
    background-image: radial-gradient(circle, rgba(23,23,23,.16) 1.2px, transparent 1.4px); background-size: 11px 11px; }
  #editInfoModal .pf-mbody { background-color: color-mix(in srgb, var(--cm-yellow) 12%, #fff); }
  #editInfoModal .pf-form input:not([type=hidden]) { background: #fff !important; border: 2.5px solid var(--cm-ink) !important; border-radius: 10px !important;
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--cm-yellow) 75%, #fff) !important; }
  #editInfoModal .pf-form input:not([type=hidden]):focus { box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  #editInfoModal button.pf-x { background: #fff !important; border: 2.5px solid var(--cm-ink) !important; }

  /* Pilih provider merchant */
  .pf-prov-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
  @media (max-width: 420px) { .pf-prov-grid { grid-template-columns: 1fr 1fr; } }
  .pf-prov { display: block; cursor: pointer; }
  .pf-prov-box { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 11px 8px; text-align: center; font-family: Bangers, Impact, sans-serif; font-size: 1.05rem; letter-spacing: .05em;
    background: #fff; --cm-fg: var(--cm-ink); border: 2.5px solid var(--cm-ink); border-radius: 10px; box-shadow: 3px 3px 0 var(--cm-ink); transition: transform .12s, box-shadow .12s, background .12s; }
  .pf-prov input:checked + .pf-prov-box { background: var(--cm-yellow); --cm-fg: var(--cm-ink); transform: translate(2px,2px); box-shadow: 1px 1px 0 var(--cm-ink); }
  .pf-prov input:focus-visible + .pf-prov-box { outline: 3px dashed var(--cm-ink); outline-offset: 3px; }
  #editInfoModal .pf-form .hidden { display: none !important; }

  /* FIX: bar simpan tidak lagi sticky/gradasi (tema meratakan gradasi jadi kuning solid & menutupi kolom terakhir) */
  #editInfoModal .pf-save-bar { position: static; margin: 18px 0 0; padding: 0 0 18px; }
  #editInfoModal .pf-mbody { padding-bottom: 8px; }
  #editInfoModal .pf-form { min-height: min-content; }

  /* FIX popup: kartu tidak bisa ter-scroll sendiri (bikin area kosong/buram), tanpa blur di dalam kartu */
  html body #editInfoModal.cp-overlay .cp-card { overflow: hidden; overflow: clip; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
  #editInfoModal .pf-mbody { overscroll-behavior: contain; min-height: 0; }
  /* FIX tema hitam: kartu popup berwarna krem, jadi semua teks di dalamnya harus tinta gelap (bukan putih ikut tema) */
  html body #editInfoModal .cp-card, html body #editInfoModal .cp-card * { --cm-fg: var(--cm-ink) !important; --cm-edge: var(--cm-ink) !important; }
  html body #editInfoModal .cp-card label, html body #editInfoModal .cp-card h3, html body #editInfoModal .cp-card p, html body #editInfoModal .cp-card small,
  html body #editInfoModal .cp-card span, html body #editInfoModal .cp-card i, html body #editInfoModal .cp-card code, html body #editInfoModal .cp-card .pf-sublbl { color: #171717 !important; -webkit-text-fill-color: #171717 !important; }
  html body #editInfoModal .cp-card .pf-form p, html body #editInfoModal .cp-card .pf-form small, html body #editInfoModal .cp-card label span { opacity: .8; }
  html body #editInfoModal .cp-card a { color: #0b6b1d !important; -webkit-text-fill-color: #0b6b1d !important; text-decoration: underline; font-weight: 800; }
  html body #editInfoModal .cp-card #togglePassword { background: #fff !important; border: 2px solid #171717 !important; border-radius: 8px; box-shadow: 2px 2px 0 #171717; }
  html body #editInfoModal .cp-card #togglePassword i { color: #171717 !important; -webkit-text-fill-color: #171717 !important; opacity: 1; }
  @media (max-width: 380px) { .pf-title { font-size: 1.7rem; } .pf-name { font-size: 1.6rem; } }
</style>

<div class="pf-wrap">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="pf-alert ok">
      <span class="pf-alert-ico"><i class="fas fa-check"></i></span>
      <p><%= success %></p>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="pf-alert err">
      <span class="pf-alert-ico"><i class="fas fa-exclamation"></i></span>
      <p><%= error %></p>
    </div>
  <% } %>

  <!-- Judul -->
  <div class="pf-title-row">
    <h2 class="pf-title">Profil</h2>
    <span class="pf-title-tag">User</span>
  </div>

  <!-- ===== HERO: foto + identitas (tampil di Room Chat Publik) ===== -->
  <section class="pf-card">
    <div class="pf-hero-top<%= (user.bannerUrl && user.bannerUrl.trim()) ? ' has-banner' : '' %>">
      <% if (user.bannerUrl && user.bannerUrl.trim()) { %>
        <img src="<%= user.bannerUrl %>" alt="banner profil" class="pf-banner-img">
      <% } else { %>
        <span class="pf-pow">WOW!</span>
      <% } %>
    </div>
    <div class="pf-hero-main">
      <div class="pf-av-wrap">
        <span class="pf-burst" aria-hidden="true"></span>
        <img src="<%= avatarSrc %>" alt="avatar" class="pf-avatar">
      </div>
      <h3 class="pf-name"><%= (user.firstName && user.firstName.trim()) ? user.firstName : user.username %></h3>
      <% if (user.firstName && user.firstName.trim()) { %><p class="pf-mail" style="margin-bottom:2px">@<%= user.username %></p><% } %>
      <% if (user.bio) { %><p class="pf-mail" style="opacity:1;font-weight:700"><%= user.bio %></p><% } %>
      <p class="pf-mail"><%= user.email %></p>

      <div class="pf-badges">
        <span class="pf-role <%= roleClass %>"><i class="fa-solid fa-star"></i> <%= user.role %></span>
        <% if (user.panelRole && user.panelRole !== 'user') { %>
          <span class="pf-role <%= user.panelRole === 'adminpanel' ? 'r-admin' : 'r-seller' %>"><i class="fa-solid fa-server"></i> <%= user.panelRole === 'adminpanel' ? 'admin panel' : 'seller' %></span>
        <% } %>
      </div>

      <div class="pf-stats">
        <div class="pf-stat"><small>ID User</small><b><%= (user._id.toString()).slice(10) %></b></div>
        <div class="pf-stat"><small>Bergabung</small><b><%= joinDate %></b></div>
      </div>

      <form id="avatarUploadForm" action="/profile/avatar" method="POST" enctype="multipart/form-data" class="pf-upload">
        <input id="avatarFileInput" type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden">
        <button type="button" onclick="document.getElementById('avatarFileInput').click()" class="pf-btn">
          <i class="fa-solid fa-camera"></i> Ganti Foto
        </button>
        <span class="pf-hint">Foto bisa dipotong (crop) dulu sebelum diunggah</span>
      </form>

      <form id="bannerUploadForm" action="/profile/banner" method="POST" enctype="multipart/form-data" class="pf-upload" style="margin-top:14px">
        <input id="bannerFileInput" type="file" name="banner" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden">
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
          <button type="button" onclick="document.getElementById('bannerFileInput').click()" class="pf-btn">
            <i class="fa-solid fa-image"></i> <%= (user.bannerUrl && user.bannerUrl.trim()) ? 'Ganti Banner' : 'Upload Banner' %>
          </button>
          <% if (user.bannerUrl && user.bannerUrl.trim()) { %>
            <button type="submit" formaction="/profile/banner/remove" formnovalidate class="pf-btn" onclick="return confirm('Hapus banner profil?')">
              <i class="fa-solid fa-trash"></i> Hapus
            </button>
          <% } %>
        </div>
        <span class="pf-hint">Banner bisa digeser &amp; di-zoom (crop 3:1) dulu sebelum diunggah</span>
      </form>
    </div>
  </section>

  <%- include('partials/avatar_crop_modal') %>
<%- include('partials/banner_crop_modal') %>
<script>initBannerCropUpload('bannerFileInput', 'bannerUploadForm');</script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      initAvatarCropUpload('avatarFileInput', 'avatarUploadForm');
    });
  </script>

  <!-- ===== Tentang Saya (nama depan + bio) & Story Saya ===== -->
  <%- include('partials/profile_about', { person: user }) %>

  <!-- ===== Kode Referral ===== -->
  <% if (settings.referralEnabled && user.referralCode) { %>
  <section class="pf-card">
    <div class="pf-card-head"><i class="fa-solid fa-user-plus"></i> Kode Referral Kamu</div>
    <div class="pf-card-body">
      <p style="font-size:12px;margin:0 0 14px;opacity:.8">Bagikan kode atau link ini. Kalau ada yang daftar lewat kode kamu, kalian berdua bisa dapat saldo bonus.</p>

      <label class="pf-sublbl">Kode Kamu</label>
      <div class="pf-field">
        <input id="refCodeDisplay" type="text" readonly value="<%= user.referralCode %>" style="letter-spacing:.14em;font-weight:800">
        <button type="button" onclick="copyRefText('refCodeDisplay')" class="pf-icon" title="Salin Kode"><i class="far fa-copy"></i></button>
      </div>

      <label class="pf-sublbl">Link Referral (otomatis terpakai kalau diklik)</label>
      <div class="pf-field">
        <input id="refLinkDisplay" type="text" readonly value="<%= siteUrl || '' %>/register?ref=<%= user.referralCode %>" style="font-size:13px">
        <button type="button" onclick="copyRefText('refLinkDisplay')" class="pf-icon" title="Salin Link"><i class="far fa-copy"></i></button>
      </div>
    </div>
  </section>
  <script>
    function copyRefText(id) {
      const el = document.getElementById(id);
      el.select();
      el.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(el.value).then(() => {
        alert('Tersalin ke clipboard');
      }).catch(() => {
        document.execCommand('copy');
        alert('Tersalin ke clipboard');
      });
    }
  </script>
  <% } %>

