    html body #pinCard,html body #pinCard *{--cm-fg:#171717!important}
    html body #pinCard .pf-pin-title,html body #pinCard .pf-pin-desc,html body #pinCard .pf-pin-state,html body #pinCard .pf-pin-lock,html body #pinCard .pf-pin-ic i,html body #pinCard button.pf-pin-link,html body #pinCard button.pf-pin-btn.g,html body #pinCard button.pf-pin-btn.y{color:#171717!important;-webkit-text-fill-color:#171717!important}
    html body #pinCard button.pf-pin-btn.k{color:#facc15!important;-webkit-text-fill-color:#facc15!important}
