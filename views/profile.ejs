    html body #editInfoModal .cp-card button.pf-gen { background: #ffffff !important; border: 2px solid #171717 !important; border-radius: 10px !important; padding: 4px 12px !important; box-shadow: 2px 2px 0 #171717 !important; text-decoration: none !important; }
    html body #editInfoModal .cp-card button.pf-gen, html body #editInfoModal .cp-card button.pf-gen * { color: #171717 !important; -webkit-text-fill-color: #171717 !important; }
    html body #editInfoModal .cp-card button.pf-copy { background: #2ecc40 !important; border: 2px solid #171717 !important; border-radius: 12px !important; box-shadow: 3px 3px 0 #171717 !important; min-width: 48px; }
    html body #editInfoModal .cp-card button.pf-copy, html body #editInfoModal .cp-card button.pf-copy * { color: #171717 !important; -webkit-text-fill-color: #171717 !important; }
    html body #editInfoModal .cp-card #toggleModalApiKey, html body #editInfoModal .cp-card #toggleModalApiKey *, html body #editInfoModal .cp-card #togglePassword * { color: #171717 !important; -webkit-text-fill-color: #171717 !important; }
  </style>

  <button type="button" onclick="openEditInfoModal()" class="pf-cta" style="margin-bottom:28px">
    <i class="fas fa-pen-to-square"></i> Edit Informasi
  </button>

  </div>

  <!-- Popup Edit Informasi (ComicPopup: selalu di depan layar) -->
  <div id="editInfoModal" class="cp-overlay hidden" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="cp-card">
      <div class="pf-mhead">
        <h3 class="font-comic"><i class="fas fa-pen-to-square"></i>Edit Informasi</h3>
        <button type="button" class="pf-x" data-cp-close aria-label="Tutup"><i class="fas fa-times"></i></button>
      </div>
      <div class="pf-mbody">
        <form method="POST" action="/profile" id="editProfileForm" class="pf-form flex flex-col gap-4">
          <!-- Email -->
          <div>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Alamat Email</label>
            <input name="email" type="email" value="<%= user.email %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required>
          </div>

          <!-- Password -->
          <div>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Password Baru <span class="text-xs text-gray-500">(opsional)</span></label>
            <div class="relative">
              <input id="newPassword" name="newPassword" type="password" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 pr-10 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="••••••••">
              <button type="button" id="togglePassword" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 text-gray-500 hover:text-gray-800 flex items-center justify-center">
                <i id="toggleIcon" class="far fa-eye text-[13.5px]"></i>
              </button>
            </div>
          </div>

          <!-- Nama Project -->
          <div>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Nama Project</label>
            <input 
              name="projectName" 
              type="text" 
              id="projectNameInput"
              value="<%= user.projectName || '' %>" 
              placeholder="Nama aplikasi/website Anda" 
              class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
          </div>

          <!-- Callback URL -->
          <div>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Callback URL</label>
            <input 
              name="callbackUrl" 
              type="url" 
              id="callbackUrlInput"
              value="<%= user.callbackUrl || '' %>" 
              placeholder="https://contoh.com/webhook" 
              class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
            <p class="text-[11px] text-gray-500 mt-1">URL akan dipanggil saat status invoice paid.</p>
            <p id="callbackUrlError" class="text-[11px] text-red-500 mt-1 hidden">Format URL tidak valid. Harap gunakan URL lengkap (https://...)</p>
          </div>

          <!-- Logo URL (Merchant) -->
          <div>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">
              URL Logo Merchant
              <span class="text-xs text-gray-500">(opsional)</span>
            </label>
            <input 
              name="merchantLogoUrl" 
              type="url" 
              id="merchantLogoUrlInput"
              value="<%= user.merchantLogoUrl || '' %>" 
              placeholder="https://example.com/logo.png" 
              class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
            <p class="text-[11px] text-gray-500 mt-1">URL logo ditampilkan di halaman pembayaran</p>
            <p id="merchantLogoUrlError" class="text-[11px] text-red-500 mt-1 hidden">Format URL tidak valid. Harap gunakan URL lengkap (https://...).</p>
          </div>

          <!-- ID Telegram -->
          <div>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">
              ID Telegram
              <span class="text-xs text-gray-500">(untuk akses Bot)</span>
            </label>
            <input
              name="telegramId"
              type="text"
              inputmode="numeric"
              id="telegramIdInput"
              value="<%= user.telegramId || '' %>"
              placeholder="Contoh: 123456789"
              class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
            <p class="text-[11px] text-gray-500 mt-1">
              Masukkan ID Telegram lalu simpan, agar bisa mengakses fitur Bot (Cek Profil, Cek Saldo, Tarik Dana, dll) serta menerima pengumuman dari admin lewat Bot.
              Belum tahu ID Telegram kamu? Chat <a href="https://t.me/userinfobot" target="_blank" rel="noopener" class="text-blue-500 hover:underline">@userinfobot</a> untuk mendapatkannya.
              <strong class="text-gray-600">Kirim <code>/start</code> ke bot terlebih dahulu sebelum menyimpan ID di sini</strong>, karena setelah disimpan sistem akan mengirim kode OTP verifikasi ke Telegram tersebut — ID baru aktif setelah OTP dikonfirmasi, supaya tidak ada orang lain yang bisa memasukkan ID Telegram milikmu tanpa izin.
              Kolom ini opsional, tapi sangat disarankan diisi — jika suatu saat kamu lupa password, ID Telegram ini bisa dipakai sebagai metode alternatif untuk menerima kode OTP lewat Bot Telegram di halaman Lupa Password.
            </p>
            <p id="telegramIdError" class="text-[11px] text-red-500 mt-1 hidden">ID Telegram harus berupa angka.</p>
          </div>

          <!-- Nomor WhatsApp -->
          <div>
            <% const waIsEmpty = !user.whatsappNumber || user.whatsappNumber.trim() === ''; %>
            <% if (waIsEmpty) { %>
              <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-3.5 py-2.5 mb-2 text-[11.5px] font-medium flex items-start gap-2">
                <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0"></i>
                <span>Akun kamu belum punya Nomor WhatsApp. <b>Wajib diisi</b> supaya bisa lanjut pakai akun ini — cukup isi & simpan, <b>tanpa perlu kode OTP</b> untuk pengisian pertama kali.</span>
              </div>
            <% } %>
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">
              Nomor WhatsApp <% if (waIsEmpty) { %><span class="text-red-500">*</span><% } %>
              <span class="text-xs text-gray-500">(untuk bukti transaksi)</span>
            </label>
            <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 transition-all focus-within:border-green-500 focus-within:ring-1 focus-within:ring-green-500">
              <% const waSplit = splitWaNumber(user.whatsappNumber); %>
              <i class="fa-brands fa-whatsapp pl-3 pr-1" style="color:#25D366"></i>
              <select id="whatsappCcSelect" name="whatsappCc" class="bg-transparent text-[13.5px] font-medium text-gray-700 outline-none pl-1 pr-1 py-3 max-w-[112px] cursor-pointer" aria-label="Kode negara">
                <%- include('partials/wa_country_options', { sel: waSplit.cc }) %>
              </select>
              <span class="w-px h-5 bg-gray-200 mx-1"></span>
              <input
                name="whatsappNumber"
                type="tel"
                inputmode="numeric"
                id="whatsappNumberInput"
                value="<%= waSplit.national %>"
                placeholder="81234567890"
                <%= waIsEmpty ? 'required' : '' %>
                class="flex-1 bg-transparent pr-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none w-full"
              >
            </div>
            <p class="text-[11px] text-gray-500 mt-1">
              Pilih kode negara lalu isi nomor tanpa angka 0 di depan (atau ketik nomor lengkap diawali +).
              <% if (waIsEmpty) { %>
                Karena ini pengisian pertama, nomor langsung tersimpan tanpa perlu OTP.
              <% } else { %>
                Kalau diganti ke nomor lain, sistem akan mengirim kode OTP ke WhatsApp nomor baru itu dulu — nomor baru aktif setelah OTP dikonfirmasi.
              <% } %>
              Setelah terhubung, bukti transaksi (deposit, withdraw, beli panel, OTP, dll) dikirim otomatis ke WhatsApp ini.<% if (!waIsEmpty) { %> Kosongkan lalu simpan untuk melepas nomor.<% } %>
            </p>
            <p id="whatsappNumberError" class="text-[11px] text-red-500 mt-1 hidden">Nomor WhatsApp tidak valid, cek kode negara & nomornya.</p>
          </div>

          <!-- API Key Field -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-[13.5px] font-medium text-gray-700">API Key</label>
              <button type="button" onclick="regenerateApiKeyFromModal(event)" class="pf-gen text-[13.5px] font-medium text-blue-500 hover:text-blue-600 transition-colors bg-transparent border-0 cursor-pointer">
                Generate Ulang
              </button>
            </div>
            <div class="flex gap-2">
              <div class="relative flex-1">
                <input id="modalApiKeyInput" type="password" readonly value="<%= rawApiKey %>" class="w-full border border-gray-100 rounded-2xl shadow-sm px-3 py-3 pr-10 text-[13.5px] font-medium text-gray-800 outline-none">
                <button type="button" id="toggleModalApiKey" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 text-gray-500 hover:text-gray-800 flex items-center justify-center">
                  <i id="modalApiKeyToggleIcon" class="far fa-eye text-[13.5px]"></i>
                </button>
              </div>
              <button type="button" onclick="copyApiKeyFromModal()" class="pf-copy bg-blue-500 hover:bg-blue-600 text-white px-3 py-3 rounded-xl text-[13.5px] font-medium transition-colors whitespace-nowrap" title="Salin API Key">
                <i class="far fa-copy text-[13.5px]"></i>
              </button>
            </div>
          </div>

          <% if (user.role === 'merchant') { %>
          <!-- ===== QRIS Pribadi (khusus role Merchant) ===== -->
          <div class="border-t border-gray-200 pt-4 mt-1">
            <h4 class="text-[13.5px] font-semibold text-gray-800 mb-1">
              <i class="fa-solid fa-qrcode text-blue-500 mr-1"></i> QRIS Pribadi
            </h4>
            <% const _isShopee = user.merchantProvider === 'shopeepay'; const _isDana = user.merchantProvider === 'dana'; %>
            <p class="text-[11px] text-gray-500 mb-2">Konfigurasi QRIS pribadi kamu (khusus akun kamu). Withdraw manual/instan otomatis nonaktif karena dana masuk langsung lewat QRIS pribadi ini.</p>

            <!-- Pilih provider sendiri (tidak lagi diatur admin) -->
            <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Provider Pembayaran</label>
            <div class="pf-prov-grid">
              <label class="pf-prov">
                <input type="radio" name="merchantProvider" value="gopaymerchant" class="sr-only" <%= (_isShopee || _isDana) ? '' : 'checked' %> onchange="pfApplyProvider()">
                <span class="pf-prov-box gp"><i class="fa-solid fa-motorcycle"></i> GoPay Merchant</span>
              </label>
              <label class="pf-prov">
                <input type="radio" name="merchantProvider" value="shopeepay" class="sr-only" <%= _isShopee ? 'checked' : '' %> onchange="pfApplyProvider()">
                <span class="pf-prov-box sp"><img src="https://img3.pixhost.to/images/6091/776776751_356980.jpg" alt="" style="width:22px;height:22px;border-radius:6px;object-fit:cover"> ShopeePay</span>
              </label>
              <label class="pf-prov">
                <input type="radio" name="merchantProvider" value="dana" class="sr-only" <%= _isDana ? 'checked' : '' %> onchange="pfApplyProvider()">
                <span class="pf-prov-box dn"><img src="https://img3.pixhost.to/images/6091/776776856_356979.jpg" alt="" style="width:22px;height:22px;border-radius:6px;object-fit:cover"> DANA</span>
              </label>
            </div>
            <p class="text-[11px] text-gray-500 mt-1 mb-3">Pilih sendiri provider yang dipakai untuk QRIS pribadi kamu. Ganti pilihan tidak menghapus API provider lainnya.</p>

            <div id="pfShopeeFields" class="<%= _isShopee ? '' : 'hidden' %>">
              <div class="mb-3">
                <label class="block text-[13.5px] font-medium text-gray-700 mb-2">API Key ShopeePay</label>
                <input name="merchantShopeeApiKey" type="text" value="<%= user.merchantShopeeApiKey || '' %>" placeholder="API key kamu" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                <p class="text-[11px] text-gray-500 mt-1">Deposit QRIS kamu dibuat &amp; dicek memakai API ini. Saldo ShopeePay mengikuti aturan tahan saldo (hold) yang berlaku.</p>
              </div>
            </div>

            <div id="pfDanaFields" class="<%= _isDana ? '' : 'hidden' %>">
              <div class="mb-3">
                <label class="block text-[13.5px] font-medium text-gray-700 mb-2">API Key DANA</label>
                <input name="merchantDanaApiKey" type="text" value="<%= user.merchantDanaApiKey || '' %>" placeholder="API key kamu" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                <p class="text-[11px] text-gray-500 mt-1">Deposit QRIS kamu dibuat &amp; dicek memakai API ini. Saldo DANA langsung masuk tanpa hold.</p>
              </div>
            </div>

            <div id="pfGopayFields" class="<%= (_isShopee || _isDana) ? 'hidden' : '' %>">
              <div class="mb-3">
                <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Domain Gopay Merchant</label>
                <input name="merchantGopayDomain" type="text" value="<%= user.merchantGopayDomain || 'pian-gomerch.vercel.app' %>" placeholder="pian-gomerch.vercel.app" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              </div>
              <div class="mb-3">
                <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Static QR (Kode QRIS Statis)</label>
                <input name="merchantGopayStaticQr" type="text" value="<%= user.merchantGopayStaticQr || '' %>" placeholder="Isi string QRIS statis kamu" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              </div>
              <div class="mb-3">
                <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Access Token</label>
                <input name="merchantGopayToken" type="text" value="<%= user.merchantGopayToken || '' %>" placeholder="Access token dari akun gomerch kamu" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Refresh Token <span class="text-xs text-gray-500">(opsional, untuk auto-refresh token)</span></label>
                <input name="merchantGopayRefreshToken" type="text" value="<%= user.merchantGopayRefreshToken || '' %>" placeholder="Refresh token dari akun gomerch kamu" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              </div>
            </div>
            <div class="mt-3">
              <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Biaya Admin (Rp)</label>
              <input name="merchantAdminFee" type="number" min="0" step="1" value="<%= user.merchantAdminFee || 0 %>" placeholder="0" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              <p class="text-[11px] text-gray-500 mt-1">Biaya tetap yang ditambahkan ke setiap deposit QRIS pribadi kamu (bukan kode unik acak seperti QRIS gateway admin).</p>
            </div>
          </div>
          <% } %>

          <% if (user.role === 'vip') { %>
          <div class="border-t border-gray-200 pt-4 mt-1">
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 flex items-start gap-2.5 mb-3">
              <i class="fa-solid fa-crown text-amber-500 mt-0.5"></i>
              <p class="text-[12px] text-amber-800 font-medium leading-relaxed">Kamu VIP — withdraw (manual & instan) otomatis <span class="font-semibold">bebas biaya admin</span>. Biaya admin deposit QRIS bisa kamu atur sendiri di bawah ini.</p>
            </div>
            <div>
              <label class="block text-[13.5px] font-medium text-gray-700 mb-2">Biaya Admin Deposit QRIS (Rp)</label>
              <input name="vipDepositFee" type="number" min="0" step="1" value="<%= user.vipDepositFee || 0 %>" placeholder="0" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm px-3 py-3 text-[13.5px] font-medium text-gray-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              <p class="text-[11px] text-gray-500 mt-1">Nominal tetap yang ditambahkan ke setiap deposit QRIS kamu (bukan kode unik acak). Isi 0 kalau tidak mau dikenakan biaya admin.</p>
            </div>
          </div>
          <% } %>

          <!-- Submit -->
          <div class="pf-save-bar">
            <button type="submit" class="pf-cta pf-cta-save">
              <i class="fas fa-bolt"></i> Simpan Profil
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // ================== GLOBAL VARIABEL ==================
  window.rawApiKeyValue = '<%= rawApiKey.replace(/'/g, "\\'") %>';
  let isTableApiKeyVisible = false;

  // ================== PILIH PROVIDER MERCHANT ==================
  function pfApplyProvider() {
    var c = document.querySelector('input[name="merchantProvider"]:checked');
    var v = c ? c.value : 'gopaymerchant';
    var sp = document.getElementById('pfShopeeFields'), gp = document.getElementById('pfGopayFields'), dn = document.getElementById('pfDanaFields');
    if (sp) sp.classList.toggle('hidden', v !== 'shopeepay');
    if (dn) dn.classList.toggle('hidden', v !== 'dana');
    if (gp) gp.classList.toggle('hidden', v !== 'gopaymerchant');
  }

  // ================== MODAL EDIT INFORMASI ==================
  function openEditInfoModal() {
    var m = document.getElementById('editInfoModal');
    if (window.ComicPopup) ComicPopup.open(m); else m.classList.remove('hidden');
    document.getElementById('modalApiKeyInput').value = window.rawApiKeyValue;
    document.getElementById('modalApiKeyInput').type = 'password';
    document.getElementById('modalApiKeyToggleIcon').className = 'far fa-eye text-[13.5px]';
  }
  function closeEditInfoModal() {
    var m = document.getElementById('editInfoModal');
    if (window.ComicPopup) ComicPopup.close(m); else m.classList.add('hidden');
  }

  // ================== TOGGLE PASSWORD ==================
  document.addEventListener('DOMContentLoaded', function() {
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('newPassword');
    const toggleIcon = document.getElementById('toggleIcon');

    if (togglePassword && passwordInput) {
      togglePassword.addEventListener('click', function (e) {
        e.preventDefault();
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        if (type === 'text') {
          toggleIcon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
          toggleIcon.classList.replace('fa-eye-slash', 'fa-eye');
        }
      });
    }

    // TOGGLE API KEY DI MODAL
    const toggleModalApiKey = document.getElementById('toggleModalApiKey');
    const modalApiKeyInput = document.getElementById('modalApiKeyInput');
    const modalApiKeyToggleIcon = document.getElementById('modalApiKeyToggleIcon');

    if (toggleModalApiKey && modalApiKeyInput) {
      toggleModalApiKey.addEventListener('click', function (e) {
        e.preventDefault();
        const type = modalApiKeyInput.getAttribute('type') === 'password' ? 'text' : 'password';
        modalApiKeyInput.setAttribute('type', type);
        if (type === 'text') {
          modalApiKeyToggleIcon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
          modalApiKeyToggleIcon.classList.replace('fa-eye-slash', 'fa-eye');
        }
      });
    }

    // ================== VALIDASI CALLBACK URL & LOGO URL ==================
    const editForm = document.getElementById('editProfileForm');
    if (editForm) {
      editForm.addEventListener('submit', function(e) {
        const callbackInput = document.getElementById('callbackUrlInput');
        const callbackErrorEl = document.getElementById('callbackUrlError');
        const merchantLogoInput = document.getElementById('merchantLogoUrlInput');
        const merchantLogoErrorEl = document.getElementById('merchantLogoUrlError');
        const telegramIdInput = document.getElementById('telegramIdInput');
        const telegramIdErrorEl = document.getElementById('telegramIdError');

        // Reset error
        callbackErrorEl.classList.add('hidden');
        merchantLogoErrorEl.classList.add('hidden');
        if (telegramIdErrorEl) telegramIdErrorEl.classList.add('hidden');

        // Validasi ID Telegram jika diisi
        if (telegramIdInput && telegramIdInput.value.trim() !== '') {
          if (!/^[0-9]{5,15}$/.test(telegramIdInput.value.trim())) {
            e.preventDefault();
            telegramIdErrorEl.classList.remove('hidden');
            telegramIdInput.focus();
            return;
          }
        }

        // Validasi nomor WhatsApp jika diisi
        const waInputEl = document.getElementById('whatsappNumberInput');
        const waErrEl = document.getElementById('whatsappNumberError');
        if (waErrEl) waErrEl.classList.add('hidden');
        if (waInputEl && waInputEl.value.trim() !== '') {
          const ccEl = document.getElementById('whatsappCcSelect');
          const cc = ccEl ? ccEl.value : '62';
          const raw = waInputEl.value.trim();
          let n = raw.replace(/[^0-9]/g, '');
          let full;
          if (raw.startsWith('+')) full = n;
          else { n = n.replace(/^0+/, ''); full = (cc === '62' && n.startsWith('62')) ? n : cc + n; }
          const ok = full.startsWith('62') ? /^628\d{8,12}$/.test(full) : /^[1-9]\d{7,14}$/.test(full);
          if (!ok) {
            e.preventDefault();
            waErrEl.classList.remove('hidden');
            waInputEl.focus();
            return;
          }
        }

        // Validasi callback URL jika diisi
        if (callbackInput && callbackInput.value.trim() !== '') {
          try {
            const url = new URL(callbackInput.value.trim());
            if (!['http:', 'https:'].includes(url.protocol)) {
              throw new Error('Invalid protocol');
            }
          } catch (err) {
            e.preventDefault();
            callbackErrorEl.classList.remove('hidden');
            callbackInput.focus();
            return;
          }
        }

        // Validasi logo URL jika diisi
        if (merchantLogoInput && merchantLogoInput.value.trim() !== '') {
          try {
            new URL(merchantLogoInput.value.trim());
          } catch (err) {
            e.preventDefault();
            merchantLogoErrorEl.classList.remove('hidden');
            merchantLogoInput.focus();
            return;
          }
        }
      });
    }
  });

  // ================== TOGGLE API KEY DI TABEL UTAMA ==================
  function toggleTableApiKey() {
    const displayEl = document.getElementById('tableApiKeyDisplay');
    const toggleIcon = document.getElementById('tableApiKeyToggleIcon');
    if (!displayEl || !toggleIcon) return;
    if (isTableApiKeyVisible) {
      displayEl.innerText = '••••••••';
      toggleIcon.className = 'far fa-eye text-[13.5px]';
    } else {
      displayEl.innerText = window.rawApiKeyValue;
      toggleIcon.className = 'far fa-eye-slash text-[13.5px]';
    }
    isTableApiKeyVisible = !isTableApiKeyVisible;
  }

  // ================== SALIN API KEY DARI TABEL UTAMA ==================
  function copyTableApiKey() {
    if (!window.rawApiKeyValue) {
      alert('Tidak ada API Key untuk disalin.');
      return;
    }
    navigator.clipboard.writeText(window.rawApiKeyValue).then(() => {
      alert('API Key disalin ke clipboard');
    }).catch(() => {
      alert('Gagal menyalin');
    });
  }

  // ================== REGENERATE API KEY ==================
  async function regenerateApiKeyFromModal(event) {
    const btn = event.target;
    if (!confirm('Apakah Anda yakin ingin membuat kunci API baru? Kunci yang lama tidak akan bisa digunakan lagi dan transaksi yang berjalan bisa terhenti.')) {
      return;
    }
    const originalText = btn.innerText;
    btn.disabled = true;
    btn.innerText = '...';
    try {
      const res = await fetch('/api/user/api-key/regenerate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include'
      });
      const data = await res.json();
      if (data.apiKey) {
        window.rawApiKeyValue = data.apiKey;
        document.getElementById('modalApiKeyInput').value = data.apiKey;
        const displayEl = document.getElementById('tableApiKeyDisplay');
        const toggleIcon = document.getElementById('tableApiKeyToggleIcon');
        if (displayEl) displayEl.innerText = '••••••••';
        if (toggleIcon) toggleIcon.className = 'far fa-eye text-[13.5px]';
        isTableApiKeyVisible = false;
        alert('API Key berhasil diperbarui!');
        window.location.reload();
      } else {
        alert(data.error || 'Gagal generate ulang API key');
      }
    } catch (err) {
      alert('Terjadi kesalahan saat generate ulang API key');
    } finally {
      btn.disabled = false;
      btn.innerText = originalText;
    }
  }

  // ================== COPY API KEY DARI MODAL ==================
  function copyApiKeyFromModal() {
    const input = document.getElementById('modalApiKeyInput');
    if (!input.value) return;
    navigator.clipboard.writeText(input.value).then(() => {
      alert('API Key disalin ke clipboard');
    }).catch(() => {
      alert('Gagal menyalin');
    });
  }
</script>


<%- include('partials/footer') %>