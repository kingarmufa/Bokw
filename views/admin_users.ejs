<%- include('partials/header', { title: 'Kelola User' }) %>
<%
  const paketList = (typeof pakets !== 'undefined' && pakets) ? pakets : [];
  const paketNameById = {};
  paketList.forEach(function(pk) { paketNameById[String(pk._id)] = pk.name; });
%>

<style data-comic-owned>
  /* ============ KELOLA USER — TAMPILAN KOMIK ============ */
  .au-wrap { max-width: 44rem; margin: 0 auto; padding: 4px 16px 40px; }
  .au-scroll::-webkit-scrollbar { width: 4px; height: 4px; }
  .au-scroll::-webkit-scrollbar-thumb { background: var(--cm-ink); border-radius: 4px; }

  /* Judul stiker */
  .au-title-row { display: flex; align-items: center; gap: 10px; margin: 6px 0 16px; flex-wrap: wrap; }
  .au-title { display: inline-block; margin: 0; padding: 6px 18px 4px; font-size: 2rem; line-height: 1; text-transform: uppercase;
    background: var(--cm-white); --cm-fg: var(--cm-ink); border-radius: 10px; transform: rotate(-2deg); box-shadow: 4px 4px 0 var(--cm-shadow); }
  .au-count { font-family: Bangers, Impact, sans-serif; font-size: 1.05rem; letter-spacing: .08em; padding: 3px 10px 1px; border-radius: 6px;
    background: color-mix(in srgb, var(--cm-yellow) 45%, #fff); --cm-fg: var(--cm-ink); border: 2.5px solid var(--cm-ink); box-shadow: 2px 2px 0 var(--cm-ink); transform: rotate(3deg); }

  /* Kotak cari */
  .au-search { position: relative; margin-bottom: 16px; }
  .au-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); z-index: 1; pointer-events: none; color: var(--cm-ink) !important; }
  .au-search input { width: 100%; padding: 12px 14px 12px 40px !important; font-size: 15px; background: #fff !important; border: 3px solid var(--cm-ink) !important;
    border-radius: 12px !important; box-shadow: 4px 4px 0 var(--cm-shadow) !important; }
  .au-search input:focus { transform: translate(2px,2px); box-shadow: 2px 2px 0 var(--cm-shadow) !important; outline: none; }

  /* Bar aksi massal */
  #bulkActionBar { display: none; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; padding: 12px; background: var(--cm-yellow); --cm-fg: var(--cm-ink);
    border: 3px solid var(--cm-ink); border-radius: 12px; box-shadow: 4px 4px 0 var(--cm-ink); animation: auPop .18s ease-out; }
  #bulkActionBar.flex { display: flex; }
  #bulkActionBar .au-bulk-n { font-family: Bangers, Impact, sans-serif; font-size: 1.2rem; letter-spacing: .06em; color: var(--cm-ink) !important; }
  #bulkActionBar select { flex: 1; min-width: 150px; padding: 8px 10px; font-size: 13.5px; border-radius: 9px !important; }
  #bulkActionBar button { padding: 8px 12px; font-size: 13px; border-radius: 9px; }
  #bulkActionBar button.au-b-go { background: color-mix(in srgb, var(--cm-yellow) 45%, #fff) !important; --cm-fg: var(--cm-ink) !important; border-color: var(--cm-ink) !important; box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  #bulkActionBar button.au-b-no { background: #fff !important; --cm-fg: var(--cm-ink) !important; border-color: var(--cm-ink) !important; box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  @keyframes auPop { from { transform: scale(.96); opacity: 0; } to { transform: none; opacity: 1; } }

  /* Daftar user (kartu komik) */
  .au-list { background: var(--cm-white) !important; --cm-fg: var(--cm-ink) !important; border: 3px solid var(--cm-ink); border-radius: 14px; box-shadow: 5px 5px 0 var(--cm-shadow); overflow: hidden; }
  .au-head { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: var(--cm-yellow); --cm-fg: var(--cm-ink); border-bottom: 3px solid var(--cm-ink); background-image: radial-gradient(circle, rgba(23,23,23,.16) 1.2px, transparent 1.4px); background-size: 11px 11px; }
  .au-head span { font-family: Bangers, Impact, sans-serif; font-size: 1.3rem; letter-spacing: .07em; color: var(--cm-ink) !important; }
  .au-body { max-height: 62vh; overflow-y: auto; -webkit-overflow-scrolling: touch;
    background-color: color-mix(in srgb, var(--cm-yellow) 12%, #fff); background-image: radial-gradient(circle, rgba(23,23,23,.09) 1px, transparent 1.2px); background-size: 12px 12px; }
  .user-row { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-bottom: 2.5px dashed rgba(23,23,23,.4); transition: background .12s; }
  .user-row:last-child { border-bottom: 0; }
  .user-row:hover { background: color-mix(in srgb, var(--cm-yellow) 45%, #fff); }
  .au-chk { width: 22px; height: 22px; margin-top: 3px; flex-shrink: 0; cursor: pointer; accent-color: var(--cm-ink); }
  .au-main { flex: 1; min-width: 0; }
  .au-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .au-name { font-family: Bangers, Impact, sans-serif; font-size: 1.45rem; line-height: 1.05; letter-spacing: .04em; word-break: break-all; }
  button.au-edit { flex-shrink: 0; display: grid; place-items: center; width: 38px; min-height: 38px; padding: 0; border-radius: 10px;
    background: color-mix(in srgb, var(--cm-yellow) 45%, #fff) !important; --cm-fg: var(--cm-ink) !important; border: 2.5px solid var(--cm-ink) !important; box-shadow: 3px 3px 0 var(--cm-ink) !important; }
  .au-badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 8px; }
  .role-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px 1px; border-radius: 999px; font-family: Bangers, Impact, sans-serif; font-size: .9rem; letter-spacing: .08em;
    text-transform: uppercase; border: 2px solid var(--cm-ink); box-shadow: 2px 2px 0 var(--cm-ink); }
  .role-badge.role-merchant { background: var(--cm-yellow); --cm-fg: var(--cm-ink); }
  .role-badge.role-vip { background: #d4af37; --cm-fg: var(--cm-ink); }
  .role-badge.role-seller { background: #1d4ed8; --cm-fg: #fff; }
  .role-badge.role-adminpanel { background: #dc2626; --cm-fg: #fff; }
  .role-badge.role-paket { background: #22c55e; --cm-fg: var(--cm-ink); }
  .role-badge.role-user { background: #fff; --cm-fg: var(--cm-ink); }
  .role-badge.role-prov { background: color-mix(in srgb, var(--cm-yellow) 45%, #fff); --cm-fg: var(--cm-ink); }
  .role-badge.role-susp { background: #fff; --cm-fg: var(--cm-ink); border-style: dashed; }
  .au-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: 13px; }
  .au-saldo { display: inline-block; padding: 1px 9px; background: color-mix(in srgb, var(--cm-yellow) 45%, #fff); --cm-fg: var(--cm-ink); border: 2px solid var(--cm-ink); box-shadow: 2px 2px 0 var(--cm-ink); border-radius: 6px; font-weight: 800; }
  .au-date { opacity: .75; font-size: 12px; }
  .au-hold { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 6px; font-size: 12px; }
  .au-hold b { padding: 1px 8px; background: #fb923c; --cm-fg: var(--cm-ink); border: 2px solid var(--cm-ink); border-radius: 6px; }
  .au-hold button { padding: 2px 10px; min-height: 0; font-size: 12px; background: #fff !important; box-shadow: 2px 2px 0 var(--cm-ink) !important; border-radius: 6px; }
  .au-empty { padding: 32px 16px; text-align: center; background: var(--cm-white); --cm-fg: var(--cm-ink); border: 3px solid var(--cm-ink); border-radius: 14px; box-shadow: 5px 5px 0 var(--cm-shadow); }
  .au-empty .em { font-family: Bangers, Impact, sans-serif; font-size: 1.6rem; letter-spacing: .05em; }

  /* ===== POPUP EDIT / HAPUS (ukuran sedang) ===== */
  html body #editUserModal.cp-overlay .cp-card, html body #deleteConfirmModal.cp-overlay .cp-card { --cm-fg: var(--cm-ink) !important; --cm-edge: var(--cm-ink) !important; color: var(--cm-ink) !important; background: color-mix(in srgb, var(--cm-yellow) 12%, #fff) !important; border: 3px solid var(--cm-ink) !important; border-radius: 16px;
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--cm-yellow) 75%, #fff), 9px 9px 0 var(--cm-ink); }
  html body #editUserModal.cp-overlay .cp-card, html body #deleteConfirmModal.cp-overlay .cp-card { overflow: hidden; overflow: clip; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
  .au-mbody { overscroll-behavior: contain; min-height: 0; }
  #editUserModal .cp-card { max-width: 27rem; }
  #deleteConfirmModal .cp-card { max-width: 23rem; }
  .au-mhead { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-shrink: 0; padding: 12px 16px 9px; background: color-mix(in srgb, var(--cm-yellow) 45%, #fff); --cm-fg: var(--cm-ink);
    border-bottom: 3px solid var(--cm-ink); background-image: radial-gradient(circle, rgba(23,23,23,.16) 1.2px, transparent 1.4px); background-size: 11px 11px; }
  .au-mhead.danger { background-color: var(--cm-yellow); --cm-fg: var(--cm-ink); }
  .au-mhead h3 { margin: 0; font-size: 1.65rem; line-height: 1; text-transform: uppercase; }
  .au-mhead h3 i { margin-right: 8px; font-size: 1.15rem; }
  .au-mhead.danger h3, .au-mhead.danger h3 i { color: var(--cm-ink) !important; }
  .au-mhead small { display: block; margin-top: 3px; font-size: 12px; font-weight: 700; opacity: .8; }
  button.au-x { display: grid; place-items: center; width: 38px; min-height: 38px; padding: 0; border-radius: 9px; background: #fff !important; --cm-fg: var(--cm-ink) !important;
    border: 2.5px solid var(--cm-ink) !important; box-shadow: 3px 3px 0 var(--cm-ink) !important; flex-shrink: 0; }
  .au-mbody { padding: 16px 16px 16px; overflow-y: auto; -webkit-overflow-scrolling: touch; flex: 1; background-color: color-mix(in srgb, var(--cm-yellow) 12%, #fff);
    background-image: radial-gradient(circle, rgba(23,23,23,.09) 1px, transparent 1.2px); background-size: 12px 12px; }
  .au-form { display: flex; flex-direction: column; gap: 14px; }
  .au-form label.au-l, .au-form .au-hint, .au-form .au-l span { --cm-fg: var(--cm-ink) !important; color: var(--cm-ink) !important; }
  .au-form label.au-l { display: block; margin-bottom: 5px; font-family: Bangers, Impact, sans-serif; font-weight: 400 !important; font-size: 1.05rem; letter-spacing: .05em; }
  .au-form label.au-l span { font-family: 'Comic Neue', Arial, sans-serif; font-size: 12px; letter-spacing: 0; opacity: .7; font-weight: 700; }
  .au-form input:not([type=hidden]):not([type=checkbox]), .au-form select { width: 100%; padding: 10px 12px; font-size: 14.5px; background: #fff !important; border: 2.5px solid var(--cm-ink) !important;
    border-radius: 10px !important; box-shadow: 3px 3px 0 color-mix(in srgb, var(--cm-yellow) 75%, #fff) !important; }
  .au-form input:focus, .au-form select:focus { box-shadow: 3px 3px 0 var(--cm-ink) !important; outline: none; background: #fffbe6 !important; }
  .au-hint { margin: 5px 0 0; font-size: 12px; line-height: 1.45; font-weight: 700; opacity: .75; }
  .au-sec { margin: 2px 0 -4px; padding: 3px 12px 1px; align-self: flex-start; font-family: Bangers, Impact, sans-serif; font-size: 1rem; letter-spacing: .08em; text-transform: uppercase;
    background: var(--cm-yellow); --cm-fg: var(--cm-ink); border: 2px solid var(--cm-ink); box-shadow: 2px 2px 0 var(--cm-ink); border-radius: 6px; transform: rotate(-1.5deg); }
  .au-check { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #fff; --cm-fg: var(--cm-ink); border: 2.5px dashed var(--cm-ink); border-radius: 10px; cursor: pointer; }
  .au-check input { width: 22px; height: 22px; accent-color: var(--cm-ink); flex-shrink: 0; }
  .au-note { padding: 10px 12px; font-size: 12.5px; line-height: 1.5; font-weight: 700; background: var(--cm-yellow); --cm-fg: var(--cm-ink); border: 2.5px solid var(--cm-ink); border-radius: 10px; box-shadow: 3px 3px 0 var(--cm-ink); }
  .au-savebar { position: static; margin: 6px 0 0; padding: 0; }
  button.au-cta { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 12px 14px; font-family: Bangers, Impact, sans-serif; font-size: 1.4rem; letter-spacing: .06em;
    background: color-mix(in srgb, var(--cm-yellow) 45%, #fff) !important; --cm-fg: var(--cm-ink) !important; border: 3px solid var(--cm-ink) !important; border-radius: 12px; box-shadow: 5px 5px 0 var(--cm-ink) !important; }
  button.au-cta:not(:disabled):hover { box-shadow: 2px 2px 0 var(--cm-ink) !important; transform: translate(3px,3px); }
  button.au-cta.danger { background: var(--cm-yellow) !important; --cm-fg: var(--cm-ink) !important; border-color: var(--cm-ink) !important; box-shadow: 5px 5px 0 var(--cm-ink) !important; }
  button.au-cta.ghost { background: #fff !important; }
  .au-del { margin-top: 16px; padding-top: 14px; border-top: 3px dashed rgba(23,23,23,.4); }
  .au-btnrow { display: flex; gap: 12px; }
  .au-btnrow > * { flex: 1; margin: 0; }
  @media (max-width: 380px) { .au-title { font-size: 1.7rem; } }
</style>

<div class="au-wrap">

  <div class="au-title-row">
    <h1 class="au-title font-comic">Kelola User</h1>
    <span class="au-count"><%= users.length %> USER</span>
  </div>

  <!-- Search -->
  <div class="au-search">
    <i class="fas fa-magnifying-glass"></i>
    <input id="searchInput" type="text" placeholder="Cari username atau email..." value="<%= typeof search !== 'undefined' ? search : '' %>" autocomplete="off">
  </div>

  <!-- Bulk Action Bar (muncul saat ada user yang dicentang) -->
  <div id="bulkActionBar">
    <span id="bulkSelectedCount" class="au-bulk-n">0 dipilih</span>
    <select id="bulkRoleSelect">
      <option value="user">User (Biasa)</option>
      <option value="vip">VIP</option>
      <option value="merchant">Merchant (QRIS Pribadi)</option>
      <option value="panel:user">Role Panel: User</option>
      <option value="panel:reseller">Role Panel: Seller (Reseller Panel)</option>
      <option value="panel:adminpanel">Role Panel: Admin Panel</option>
      <% if (paketList.length) { %>
      <optgroup label="Paket">
        <% paketList.forEach(function(pk) { %>
        <option value="paket:<%= pk._id %>">Pasang Paket: <%= pk.name %></option>
        <% }); %>
        <option value="paket:none">Lepas Paket</option>
      </optgroup>
      <% } %>
    </select>
    <button type="button" onclick="applyBulkRole()" id="bulkApplyBtn" class="au-b-go">Terapkan</button>
    <button type="button" onclick="clearBulkSelection()" class="au-b-no">Batal</button>
  </div>

  <% if (users.length === 0) { %>
    <div class="au-empty"><div class="em">Belum ada pengguna!</div><div>Belum ada pengguna terdaftar.</div></div>
  <% } else { %>
    <div class="au-list" id="userTableContainer">
      <div class="au-head">
        <input type="checkbox" id="selectAllUsers" onchange="toggleSelectAllUsers(this)" class="au-chk" style="margin-top:0" aria-label="Pilih semua">
        <span>Username</span>
      </div>
      <div class="au-body au-scroll" id="userTableBody">
        <% users.forEach(u => { %>
        <div class="user-row"
            data-id="<%= u._id %>"
            data-username="<%= u.username %>"
            data-email="<%= u.email %>"
            data-balance="<%= u.balance %>"
            data-suspended="<%= u.suspended %>"
            data-role="<%= u.role %>"
            data-panel-role="<%= u.panelRole || 'user' %>"
            data-paket-id="<%= u.paketId && paketNameById[String(u.paketId)] ? u.paketId : '' %>"
            data-paket-expires-at="<%= u.paketExpiresAt ? new Date(u.paketExpiresAt).toISOString().slice(0, 10) : '' %>"
            data-project-name="<%= u.projectName || '' %>"
            data-callback-url="<%= u.callbackUrl || '' %>"
            data-merchant-logo-url="<%= u.merchantLogoUrl || '' %>"
            data-created="<%= u.createdAt.toISOString() %>">
          <input type="checkbox" class="user-select-checkbox au-chk" data-id="<%= u._id %>" onchange="updateBulkBar()" aria-label="Pilih <%= u.username %>">
          <div class="au-main">
            <div class="au-top">
              <span class="au-name"><%= u.username %></span>
              <button type="button" class="au-edit" aria-label="Edit <%= u.username %>" onclick="event.stopPropagation(); window.location.hash = 'edit-user-' + this.closest('.user-row').dataset.id;"><i class="fas fa-pen-to-square"></i></button>
            </div>
            <div class="au-badges">
              <% if (u.role === 'merchant') { %>
                <span class="role-badge role-merchant">Merchant</span>
                <span class="role-badge role-prov"><%= u.merchantProvider === 'shopeepay' ? 'ShopeePay' : (u.merchantProvider === 'dana' ? 'DANA' : 'GoPay') %></span>
              <% } else if (u.role === 'vip') { %>
                <span class="role-badge role-vip"><i class="fas fa-crown" style="font-size:.7rem"></i> VIP</span>
              <% } else { %>
                <span class="role-badge role-user">User</span>
              <% } %>
              <% if (u.panelRole === 'reseller') { %>
                <span class="role-badge role-seller">Seller</span>
              <% } else if (u.panelRole === 'adminpanel') { %>
                <span class="role-badge role-adminpanel">Admin Panel</span>
              <% } %>
              <% if (u.paketId && paketNameById[String(u.paketId)]) { %>
                <span class="role-badge role-paket"><%= paketNameById[String(u.paketId)] %></span>
              <% } %>
              <% if (u.suspended) { %><span class="role-badge role-susp">Suspend</span><% } %>
            </div>
            <div class="au-meta">
              <span class="au-saldo">Rp <%= u.balance.toLocaleString('id-ID') %></span>
              <span class="au-date date-cell" data-timestamp="<%= u.createdAt.toISOString() %>"></span>
            </div>
            <% if (u.heldBalance > 0) { %>
            <div class="au-hold">
              <b title="Saldo tertahan dari deposit ShopeePay"><i class="fas fa-lock" style="font-size:10px"></i> Tertahan Rp <%= u.heldBalance.toLocaleString('id-ID') %></b>
              <% if (u.role !== 'merchant') { %>
              <form method="POST" action="/admin/users/<%= u._id %>/release-hold" onsubmit="return confirm('Cairkan Rp<%= u.heldBalance.toLocaleString('id-ID') %> saldo tertahan milik <%= u.username %> ke saldo utama?');" style="margin:0">
                <button type="submit">Cairkan</button>
              </form>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <div id="emptyState" class="au-empty hidden" style="margin-top:0">
      <div class="em">Nggak ketemu!</div><div>Pengguna tidak ditemukan.</div>
    </div>
  <% } %>
</div>

<!-- ===================== POPUP EDIT USER (ComicPopup, ukuran sedang) ===================== -->
<div id="editUserModal" class="cp-overlay hidden" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="cp-card">
    <div class="au-mhead">
      <div>
        <h3 class="font-comic"><i class="fas fa-user-pen"></i>Edit Pengguna</h3>
      </div>
      <button type="button" class="au-x" data-cp-close aria-label="Tutup"><i class="fas fa-times"></i></button>
    </div>
    <div class="au-mbody au-scroll">
      <form id="editUserForm" method="POST" action="" class="au-form">
        <span class="au-sec">Akun</span>
        <div>
          <label class="au-l">Username</label>
          <input name="username" id="editUsername" required>
        </div>
        <div>
          <label class="au-l">Email</label>
          <input name="email" type="email" id="editEmail" required>
        </div>
        <div>
          <label class="au-l">Password Baru <span>(opsional)</span></label>
          <input name="password" type="password" id="editPassword" placeholder="••••••••">
        </div>
        <div>
          <label class="au-l">Saldo (Rp)</label>
          <input type="text" id="editBalanceDisplay" inputmode="numeric" oninput="formatEditBalance(this)">
          <input type="hidden" name="balance" id="editBalanceReal">
        </div>
        <label class="au-check" for="editSuspended">
          <input type="checkbox" name="suspended" id="editSuspended">
          <span>Suspend (Tangguhkan) Akun</span>
        </label>

        <span class="au-sec">Project</span>
        <div>
          <label class="au-l">Nama Project <span>(opsional, maks. 15 karakter)</span></label>
          <input name="projectName" id="editProjectName" maxlength="15" placeholder="Nama Project">
        </div>
        <div>
          <label class="au-l">Callback URL <span>(opsional)</span></label>
          <input name="callbackUrl" id="editCallbackUrl" placeholder="https://example.com/callback">
        </div>
        <div>
          <label class="au-l">URL Logo Merchant <span>(opsional)</span></label>
          <input name="merchantLogoUrl" id="editMerchantLogoUrl" placeholder="https://example.com/logo.png">
        </div>

        <span class="au-sec">Role &amp; Paket</span>
        <div>
          <label class="au-l">Role</label>
          <select name="role" id="editRole" onchange="toggleMerchantSection()">
            <option value="user">User (biasa)</option>
            <option value="vip">VIP</option>
            <option value="merchant">Merchant (QRIS Pribadi)</option>
          </select>
          <p class="au-hint">Merchant = user bisa memakai QRIS pribadi sendiri. Tarik saldo otomatis nonaktif untuk Merchant. VIP otomatis bebas biaya admin (withdraw &amp; deposit QRIS).</p>
        </div>
        <!-- Info provider merchant: provider & API diatur merchant sendiri di Profil -->
        <div id="merchantProviderSection" class="au-note hidden">
          <i class="fas fa-circle-info"></i> Provider pembayaran (GoPay Merchant / ShopeePay / DANA) &amp; API-nya <b>dipilih &amp; diisi sendiri oleh merchant</b> di halaman Profil mereka. Admin tidak mengaturnya dari sini.
        </div>
        <div>
          <label class="au-l">Role Panel</label>
          <select name="panelRole" id="editPanelRole">
            <option value="user">User (harus beli Seller/Admin Panel)</option>
            <option value="reseller">Seller (Reseller Panel)</option>
            <option value="adminpanel">Admin Panel</option>
          </select>
          <p class="au-hint">User = tanpa akses Create Panel &amp; Add Server. Terpisah dari role di atas. Diberikan dari sini bersifat permanen. Harga &amp; status penjualan diatur di menu Setting Role Panel.</p>
        </div>
        <div>
          <label class="au-l">Paket</label>
          <select name="paketId" id="editPaket">
            <option value="">Tanpa paket (ikut Paket Default / biaya bawaan)</option>
            <% paketList.forEach(function(pk) { %>
            <option value="<%= pk._id %>"><%= pk.name %><%= pk.isDefault ? ' (Default)' : '' %><%= pk.active ? '' : ' (nonaktif)' %></option>
            <% }); %>
          </select>
          <p class="au-hint">Paket mengatur biaya admin tiap layanan. Kalau paket punya role payment / panel yang di-ON-kan, role user ikut berubah saat paket dipasang.</p>
        </div>
        <div>
          <label class="au-l">Tanggal Expired Paket</label>
          <input type="date" name="paketExpiresAt" id="editPaketExpiresAt">
          <p class="au-hint">Kosongkan = permanen. Kalau lewat tanggal, paket otomatis dilepas ke Paket Default.</p>
        </div>

        <div class="au-savebar">
          <button type="submit" class="au-cta"><i class="fas fa-bolt"></i> Simpan Perubahan</button>
        </div>
      </form>
      <div class="au-del">
        <button type="button" onclick="confirmDeleteUser()" class="au-cta danger"><i class="fas fa-trash-can"></i> Hapus Pengguna</button>
      </div>
    </div>
  </div>
</div>

<!-- ===================== POPUP KONFIRMASI HAPUS ===================== -->
<div id="deleteConfirmModal" class="cp-overlay hidden" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="cp-card">
    <div class="au-mhead danger">
      <h3 class="font-comic"><i class="fas fa-triangle-exclamation"></i>Yakin Hapus?</h3>
      <button type="button" class="au-x" data-cp-close aria-label="Tutup"><i class="fas fa-times"></i></button>
    </div>
    <div class="au-mbody">
      <div class="au-note" style="margin-bottom:16px">Pengguna ini akan dihapus <b>permanen</b> beserta datanya. Aksi ini tidak bisa dibatalkan.</div>
      <div class="au-btnrow">
        <button type="button" data-cp-close class="au-cta ghost" style="font-size:1.2rem">Batal</button>
        <form id="deleteUserForm" method="POST" action="">
          <button type="submit" class="au-cta danger" style="font-size:1.2rem">Ya, Hapus</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // ===================== FORMAT TANGGAL DI SISI KLIEN =====================
  function formatDateCell(cell) {
    const timestamp = cell.dataset.timestamp;
    if (!timestamp) return;
    const d = new Date(timestamp);
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const dateNum = String(d.getDate()).padStart(2, '0');
    const timeStr = d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }).replace('.', ':');
    cell.textContent = `${year}-${month}-${dateNum} ${timeStr}`;
  }

  // ===================== HELPER =====================
  function getUserDataFromRow(row) {
    return {
      id: row.dataset.id,
      username: row.dataset.username,
      email: row.dataset.email,
      balance: row.dataset.balance,
      suspended: row.dataset.suspended === 'true',
      role: row.dataset.role || 'user',
      panelRole: row.dataset.panelRole || 'user',
      paketId: row.dataset.paketId || '',
      paketExpiresAt: row.dataset.paketExpiresAt || '',
      projectName: row.dataset.projectName || '',
      callbackUrl: row.dataset.callbackUrl || '',
      merchantLogoUrl: row.dataset.merchantLogoUrl || '',
      created: row.dataset.created
    };
  }

  function formatEditBalance(input) {
    let raw = input.value.replace(/\D/g, '');
    document.getElementById('editBalanceReal').value = raw;
    input.value = raw ? Number(raw).toLocaleString('id-ID') : '';
  }

  // Info merchant (provider diatur merchant sendiri di Profil)
  function toggleMerchantSection() {
    const isMerchant = document.getElementById('editRole').value === 'merchant';
    document.getElementById('merchantProviderSection').classList.toggle('hidden', !isMerchant);
  }

  // ===================== POPUP EDIT (ComicPopup + Hash Router) =====================
  function openEditModalWithData(user) {
    document.getElementById('editUsername').value = user.username;
    document.getElementById('editEmail').value = user.email;
    document.getElementById('editProjectName').value = user.projectName || '';
    document.getElementById('editCallbackUrl').value = user.callbackUrl || '';
    document.getElementById('editMerchantLogoUrl').value = user.merchantLogoUrl || '';
    document.getElementById('editBalanceDisplay').value = Number(user.balance).toLocaleString('id-ID');
    document.getElementById('editBalanceReal').value = user.balance;
    document.getElementById('editSuspended').checked = user.suspended;
    document.getElementById('editRole').value = user.role || 'user';
    document.getElementById('editPanelRole').value = user.panelRole || 'user';
    document.getElementById('editPaket').value = user.paketId || '';
    document.getElementById('editPaketExpiresAt').value = user.paketExpiresAt || '';
    document.getElementById('editUserForm').action = '/admin/users/' + user.id + '/edit';
    toggleMerchantSection();
    ComicPopup.open('editUserModal');
  }

  function closeEditUserModal() { ComicPopup.close('editUserModal'); }

  // ===================== POPUP KONFIRMASI HAPUS =====================
  function confirmDeleteUser() {
    const parts = document.getElementById('editUserForm').action.split('/').filter(Boolean);
    const userId = parts[parts.length - 2];
    if (!userId) return;
    document.getElementById('deleteUserForm').action = '/admin/users/' + userId + '/delete';
    ComicPopup.open('deleteConfirmModal');
  }
  function closeDeleteConfirmModal() { ComicPopup.close('deleteConfirmModal'); }

  // ===================== HASH ROUTER =====================
  function handleHashChange() {
    const hash = window.location.hash;
    if (hash.startsWith('#edit-user-')) {
      const userId = hash.replace('#edit-user-', '');
      const row = document.querySelector(`.user-row[data-id="${userId}"]`);
      if (row) {
        closeDeleteConfirmModal();
        openEditModalWithData(getUserDataFromRow(row));
      } else {
        history.replaceState(null, null, window.location.pathname + window.location.search);
      }
    } else {
      closeDeleteConfirmModal();
      closeEditUserModal();
    }
  }
  window.addEventListener('hashchange', handleHashChange);
  // Popup edit ditutup (X / klik latar / Esc) -> bersihkan hash supaya tombol edit bisa dipakai lagi.
  document.addEventListener('comicpopup:close', function (e) {
    if (e.detail && e.detail.id === 'editUserModal' && window.location.hash.startsWith('#edit-user-')) {
      history.replaceState(null, null, window.location.pathname + window.location.search);
    }
  });

  // ===================== PILIH SEMUA / BULK UBAH ROLE =====================
  function getVisibleCheckboxes() {
    return Array.from(document.querySelectorAll('#userTableBody .user-row'))
      .filter(row => row.style.display !== 'none')
      .map(row => row.querySelector('.user-select-checkbox'))
      .filter(Boolean);
  }

  function toggleSelectAllUsers(checkbox) {
    getVisibleCheckboxes().forEach(cb => { cb.checked = checkbox.checked; });
    updateBulkBar();
  }

  function updateBulkBar() {
    const visible = getVisibleCheckboxes();
    const checked = visible.filter(cb => cb.checked);
    const bar = document.getElementById('bulkActionBar');
    const countLabel = document.getElementById('bulkSelectedCount');
    const selectAll = document.getElementById('selectAllUsers');
    bar.classList.toggle('flex', checked.length > 0);
    countLabel.textContent = checked.length + ' dipilih';
    if (selectAll) {
      selectAll.checked = visible.length > 0 && checked.length === visible.length;
      selectAll.indeterminate = checked.length > 0 && checked.length < visible.length;
    }
  }

  function clearBulkSelection() {
    document.querySelectorAll('.user-select-checkbox').forEach(cb => { cb.checked = false; });
    updateBulkBar();
  }

  async function applyBulkRole() {
    const checked = getVisibleCheckboxes().filter(cb => cb.checked);
    const ids = checked.map(cb => cb.dataset.id);
    const role = document.getElementById('bulkRoleSelect').value;
    if (ids.length === 0) return;

    const applyBtn = document.getElementById('bulkApplyBtn');
    const originalText = applyBtn.textContent;
    applyBtn.disabled = true;
    applyBtn.textContent = 'Menyimpan...';

    try {
      const res = await fetch('/admin/users/bulk-role', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(role.startsWith('paket:') ? { ids, paketId: role.slice(6) } : (role.startsWith('panel:') ? { ids, panelRole: role.slice(6) } : { ids, role }))
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Gagal mengubah role. Silakan coba lagi.');
        applyBtn.disabled = false;
        applyBtn.textContent = originalText;
      }
    } catch (err) {
      alert('Terjadi kesalahan jaringan. Silakan coba lagi.');
      applyBtn.disabled = false;
      applyBtn.textContent = originalText;
    }
  }

  // ===================== CLIENT-SIDE SEARCH =====================
  function applyUserFilter() {
    const searchText = document.getElementById('searchInput').value.trim().toLowerCase();
    const rows = document.querySelectorAll('#userTableBody .user-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const username = (row.dataset.username || '').toLowerCase();
      const email = (row.dataset.email || '').toLowerCase();
      const match = searchText === '' || username.includes(searchText) || email.includes(searchText);
      row.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    const emptyState = document.getElementById('emptyState');
    const tableContainer = document.getElementById('userTableContainer');
    if (emptyState) {
      const none = visibleCount === 0 && rows.length > 0;
      emptyState.classList.toggle('hidden', !none);
      if (tableContainer) tableContainer.classList.toggle('hidden', none);
    }
    updateBulkBar();
  }

  const searchInput = document.getElementById('searchInput');
  if (searchInput) searchInput.addEventListener('input', applyUserFilter);

  // ===================== INISIALISASI =====================
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.date-cell').forEach(formatDateCell);
    if (window.location.hash.startsWith('#edit-user-')) handleHashChange();
    applyUserFilter();
  });
</script>

<%- include('partials/footer') %>
