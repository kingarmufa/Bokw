<%- include('partials/header', { title: 'Transfer Saldo' }) %>
<style>
.tf-wrap{max-width:560px;margin:0 auto;padding:12px 16px 90px;color:#111}
.tf-hero{position:relative;overflow:hidden;background:#22c55e;border:4px solid #111;border-radius:20px;box-shadow:6px 6px 0 #111;padding:18px 18px 16px;margin-bottom:16px}
.tf-hero h1{font-family:'Bangers',cursive;font-size:34px;letter-spacing:1px;line-height:1;margin:0;position:relative}
.tf-bal{position:relative;display:inline-block;margin-top:10px;background:#facc15;border:3px solid #111;border-radius:12px;padding:6px 12px;font-weight:900;font-size:14px;box-shadow:3px 3px 0 #111;transform:rotate(-1.5deg)}
.tf-tabs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:16px}
.tf-tab{border:3px solid #111;border-radius:12px;padding:10px 4px;background:#fff;font-family:'Bangers',cursive;font-size:16px;letter-spacing:.5px;line-height:1.1;box-shadow:3px 3px 0 #111;color:#111!important;cursor:pointer;transition:transform .1s,box-shadow .1s}
.tf-tab:active{transform:translate(2px,2px);box-shadow:1px 1px 0 #111}
.tf-tab.active{background:#facc15}
.tf-tab[data-mode=qr].active{background:#22c55e}
.tf-tab[data-mode=my].active{background:#111;color:#facc15!important}
.tf-card{background:#fff;border:3px solid #111;border-radius:18px;box-shadow:5px 5px 0 #111;padding:16px;margin-bottom:16px}
.tf-card h2{font-family:'Bangers',cursive;font-size:24px;letter-spacing:.5px;margin:0 0 10px;color:#111!important}
.tf-card label{font-size:11px;font-weight:900;letter-spacing:.4px;color:#111!important}
.tf-input{box-sizing:border-box;width:100%;border:3px solid #111;border-radius:12px;padding:12px 14px;font-weight:800;outline:none;background:#fff!important;color:#111!important;margin-top:4px}
.tf-input:focus{box-shadow:0 0 0 3px #22c55e}
.tf-btn{box-sizing:border-box;display:block;width:100%;border:3px solid #111;border-radius:12px;padding:12px;margin-top:12px;font-family:'Bangers',cursive;font-size:19px;letter-spacing:.8px;box-shadow:3px 3px 0 #111;color:#111!important;background:#22c55e;cursor:pointer;text-align:center;text-decoration:none}
.tf-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 #111}
.tf-btn.y{background:#facc15}.tf-btn.k{background:#111;color:#facc15!important}
.tf-btn[disabled]{opacity:.55;pointer-events:none}
.tf-note{font-size:11.5px;font-weight:700;color:#3f3f46!important;margin-top:6px;line-height:1.4}
.tf-profile{border:3px dashed #111;border-radius:14px;padding:12px;background:#fefce8;color:#111;margin-top:14px;font-weight:700;font-size:13px;line-height:1.5}
.tf-profile.ok{border-style:solid;background:#dcfce7}.tf-profile.bad{border-style:solid;background:#fee2e2}
.tf-profile b.big{font-family:'Bangers',cursive;font-size:22px;letter-spacing:.5px;font-weight:400}
.tf-summary{border:3px solid #111;border-radius:14px;background:#facc15;padding:10px 12px;margin-top:12px;color:#111}
.tf-row{display:flex;justify-content:space-between;gap:12px;padding:3px 0;font-size:13px;font-weight:800}
.tf-row.total{border-top:3px dashed #111;margin-top:4px;padding-top:6px;font-size:15px}
.qr-preview{max-width:240px;max-height:240px;object-fit:contain;margin:12px auto 0;border:4px solid #111;border-radius:16px;display:block;background:#fff}
.my-qris{max-width:340px;margin:0 auto;border-radius:18px;overflow:hidden;box-shadow:5px 5px 0 #111;border:3px solid #111;line-height:0;background:#facc15}
.my-qris img{width:100%;height:auto;display:block}
.tf-hist{display:flex;justify-content:space-between;gap:10px;border-bottom:2px dashed #d4d4d8;padding:8px 0;font-size:13px}
.tf-hist:last-child{border-bottom:0}.tf-hist small{display:block;color:#52525b;font-weight:700;font-size:11px}
.tf-in{color:#16a34a}.tf-out{color:#dc2626}
.hidden{display:none!important}
.tf-modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:18px;z-index:9999}
.tf-modal .box{width:100%;max-width:380px;background:#facc15;border:4px solid #111;border-radius:20px;box-shadow:7px 7px 0 #111;padding:18px;color:#111}
.tf-modal h3{font-family:'Bangers',cursive;font-size:28px;margin:0 0 8px;letter-spacing:1px;color:#111}
.tf-modal .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tf-ok-ic{width:62px;height:62px;border:4px solid #111;border-radius:50%;background:#22c55e;display:flex;align-items:center;justify-content:center;font-size:30px;margin:0 auto 8px;box-shadow:3px 3px 0 #111}
</style>

<div class="tf-wrap">
  <div class="tf-hero">
    <h1>TRANSFER SALDO</h1>
    <div class="tf-bal">SALDO AKTIF: Rp <span id="liveBal"><%= Number(user.balance||0).toLocaleString('id-ID') %></span></div>
  </div>

  <div class="tf-tabs">
    <button type="button" class="tf-tab <%= mode==='qr'?'active':'' %>" data-mode="qr">TRANSFER<br>QRIS</button>
    <button type="button" class="tf-tab <%= mode==='username'?'active':'' %>" data-mode="username">TRANSFER<br>USERNAME</button>
    <button type="button" class="tf-tab <%= mode==='my'?'active':'' %>" data-mode="my">QRIS<br>SAYA</button>
  </div>

  <!-- ===== KIRIM (username / qris) ===== -->
  <div id="sendCard" class="tf-card <%= mode==='my'?'hidden':'' %>">
    <h2 id="modeTitle"><%= mode==='qr' ? 'TRANSFER QRIS' : 'TRANSFER USERNAME' %></h2>

    <div id="usernameMode" class="<%= mode==='qr'?'hidden':'' %>">
      <label for="username">USERNAME PENERIMA</label>
      <input id="username" class="tf-input" autocomplete="off" autocapitalize="none" placeholder="Masukkan username dengan benar">
      <button type="button" id="checkBtn" class="tf-btn y">CEK PROFIL</button>
    </div>

    <div id="qrMode" class="<%= mode==='qr'?'':'hidden' %>">
      <label for="qrFile">FOTO QRIS PENERIMA</label>
      <p class="tf-note">Kirim file foto QRIS Transfer AVERPAY milik penerima (hasil download dari menu <b>QRIS SAYA</b>). Foto tidak disimpan.</p>
      <input id="qrFile" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="tf-input">
      <img id="qrPreview" class="qr-preview hidden" alt="Preview QRIS">
      <button type="button" id="scanBtn" class="tf-btn y">BACA QRIS &amp; CEK PEMILIK</button>
    </div>

    <div id="profileBox" class="tf-profile hidden"></div>

    <div id="amountBox" class="hidden" style="margin-top:14px">
      <label for="amount">NOMINAL TRANSFER (BEBAS)</label>
      <input id="amount" type="number" inputmode="numeric" min="<%= settings.minTransfer || 1000 %>" class="tf-input" placeholder="Contoh: 25000">
      <p class="tf-note">Minimal Rp <%= Number(settings.minTransfer||1000).toLocaleString('id-ID') %> • Biaya admin Rp <span id="feeLabel"><%= Number(feeUsername).toLocaleString('id-ID') %></span></p>
      <div id="confirmSummary" class="tf-summary hidden">
        <div class="tf-row"><span id="sumNameLabel">Penerima</span><strong id="sumName">-</strong></div>
        <div class="tf-row"><span>Nominal</span><strong id="sumAmount">Rp 0</strong></div>
        <div class="tf-row"><span>Biaya Admin</span><strong id="sumFee">Rp 0</strong></div>
        <div class="tf-row total"><span>Total Potong Saldo</span><strong id="sumTotal">Rp 0</strong></div>
      </div>
      <button type="button" id="sendBtn" class="tf-btn">TRANSFER SEKARANG</button>
    </div>
  </div>

  <!-- ===== QRIS SAYA ===== -->
  <div id="myCard" class="tf-card <%= mode==='my'?'':'hidden' %>">
    <h2>QRIS SAYA</h2>
    <p class="tf-note" style="margin:0 0 12px">Bagikan QRIS ini ke user lain. Mereka tinggal upload fotonya di menu <b>TRANSFER QRIS</b> untuk mengirim saldo ke kamu.</p>
    <% if (qrisSvg) { %>
      <div class="my-qris" id="myQrisBox"><img src="/transfer/qris-saya.svg?v=<%= Date.now() %>" alt="QRIS Transfer <%= user.username %>" onerror="this.outerHTML='<div style=&quot;padding:24px;line-height:1.4;font-weight:800;color:#111&quot;>QRIS gagal dimuat. Muat ulang halaman atau pakai tombol download SVG.</div>'" style="width:100%;height:auto;display:block"></div>
      <button type="button" id="dlPng" class="tf-btn">DOWNLOAD QRIS (PNG)</button>
      <a class="tf-btn y" href="/transfer/qris-saya.svg?download=1">DOWNLOAD QRIS (SVG)</a>
      <p class="tf-note">QRIS ini khusus transfer antar user AVERPAY, tidak bisa dibayar lewat aplikasi bank/e-wallet.</p>
    <% } else { %>
      <div class="tf-profile bad">QRIS belum bisa dibuat. Coba muat ulang halaman.</div>
    <% } %>
  </div>

  <% if (history && history.length) { %>
  <div class="tf-card">
    <h2>RIWAYAT TRANSFER</h2>
    <% history.forEach(function(t){ const sent = String(t.senderId)===String(user._id); %>
      <div class="tf-hist">
        <div><b><%= sent ? 'Ke @'+t.receiverUsername : 'Dari @'+t.senderUsername %></b>
          <small><%= new Date(t.createdAt).toLocaleString('id-ID') %> • <%= t.method==='qr' ? 'QRIS' : 'USERNAME' %><%= sent && t.fee ? ' • fee Rp '+Number(t.fee).toLocaleString('id-ID') : '' %></small></div>
        <b class="<%= sent?'tf-out':'tf-in' %>"><%= sent?'-':'+' %>Rp <%= Number(t.amount).toLocaleString('id-ID') %></b>
      </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div id="confirmModal" class="tf-modal hidden"><div class="box">
  <h3>KONFIRMASI TRANSFER</h3>
  <div id="confirmBody" class="tf-row" style="display:block;font-size:14px"></div>
  <div class="two" style="margin-top:12px"><button type="button" id="cNo" class="tf-btn y" style="margin:0">BATAL</button><button type="button" id="cYes" class="tf-btn" style="margin:0">KIRIM</button></div>
</div></div>
<div id="doneModal" class="tf-modal hidden"><div class="box" style="text-align:center">
  <div class="tf-ok-ic">✓</div><h3>TRANSFER BERHASIL!</h3>
  <div id="doneBody" style="font-weight:800;font-size:14px;line-height:1.6"></div>
  <button type="button" id="doneBtn" class="tf-btn k">OK</button>
</div></div>

<script src="/vendor/jsqr.js" onerror="void 0"></script>
<script>window.PIN_ENABLED = <%= (typeof pinEnabled !== 'undefined' && pinEnabled) ? 'true' : 'false' %>;</script>
<script src="/pin-guard.js?v=3"></script>
<script>
(function(){
const FEE={username:<%= Number(feeUsername) %>,qr:<%= Number(feeQris) %>};
let mode=<%- JSON.stringify(mode) %>,checked='',qrOwner='',busy=false;
const $=id=>document.getElementById(id);
const rp=n=>'Rp '+Math.max(0,Math.floor(n)).toLocaleString('id-ID');
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fee=()=>FEE[mode==='qr'?'qr':'username']||0;

function resetState(){checked='';qrOwner='';$('profileBox').className='tf-profile hidden';$('profileBox').innerHTML='';$('amountBox').classList.add('hidden');$('confirmSummary').classList.add('hidden');$('amount').value=''}
function showProfile(html,cls){const b=$('profileBox');b.className='tf-profile '+(cls||'');b.innerHTML=html}
function updateSummary(){
  const amount=Math.floor(Number($('amount').value)||0);
  $('feeLabel').textContent=fee().toLocaleString('id-ID');
  $('sumNameLabel').textContent=mode==='qr'?'Pemilik QRIS':'Penerima';
  $('sumName').textContent=checked?(mode==='qr'?qrOwner+' (@'+checked+')':'@'+checked):'-';
  $('sumAmount').textContent=rp(amount);$('sumFee').textContent=rp(fee());$('sumTotal').textContent=rp(amount+fee());
  $('confirmSummary').classList.toggle('hidden',!checked||amount<=0);
}
$('amount').addEventListener('input',updateSummary);

function setMode(m){
  mode=m;resetState();
  document.querySelectorAll('.tf-tab').forEach(x=>x.classList.toggle('active',x.dataset.mode===m));
  $('sendCard').classList.toggle('hidden',m==='my');$('myCard').classList.toggle('hidden',m!=='my');
  $('usernameMode').classList.toggle('hidden',m!=='username');$('qrMode').classList.toggle('hidden',m!=='qr');
  $('modeTitle').textContent=m==='qr'?'TRANSFER QRIS':'TRANSFER USERNAME';
  if(history.replaceState)history.replaceState(null,'','/transfer?mode='+m);
}
document.querySelectorAll('.tf-tab').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.mode)));

// ---- Transfer Username: cek profil dulu ----
$('checkBtn').addEventListener('click',async()=>{
  const u=$('username').value.trim();resetState();
  if(!u){showProfile('Isi username penerima dulu.','bad');return}
  showProfile('Mengecek profil...');
  try{
    const r=await fetch('/api/transfer/check/'+encodeURIComponent(u));const d=await r.json();
    if(!d.success){showProfile(esc(d.error),'bad');return}
    checked=d.profile.username;
    showProfile('<b class="big">PROFIL DITEMUKAN ✓</b><br>Username: <b>@'+esc(d.profile.username)+'</b><br>Nama: <b>'+esc(d.profile.firstName)+'</b><br>Role: '+esc(String(d.profile.role).toUpperCase())+'<br><span class="tf-note">Pastikan nama &amp; username sudah benar sebelum kirim.</span>','ok');
    $('amountBox').classList.remove('hidden');updateSummary();
  }catch(e){showProfile('Gagal mengecek profil.','bad')}
});

// ---- Transfer QRIS: baca foto QRIS ----
async function decodeQr(file){
  let bmp;
  if(file.type==='image/svg+xml'){
    const url=URL.createObjectURL(file);
    bmp=await new Promise((ok,no)=>{const i=new Image();i.onload=()=>ok(i);i.onerror=()=>no(new Error('SVG tidak bisa dibuka.'));i.src=url});
  }else if(window.createImageBitmap){bmp=await createImageBitmap(file)}
  else{const url=URL.createObjectURL(file);bmp=await new Promise((ok,no)=>{const i=new Image();i.onload=()=>ok(i);i.onerror=()=>no(new Error('Foto tidak bisa dibuka.'));i.src=url})}
  if('BarcodeDetector' in window){
    try{const codes=await new BarcodeDetector({formats:['qr_code']}).detect(bmp);if(codes.length)return codes[0].rawValue}catch(e){}
  }
  if(typeof window.jsQR==='function'){
    const w0=bmp.width||bmp.naturalWidth,h0=bmp.height||bmp.naturalHeight;
    for(const maxSide of [1000,700,1500]){
      const sc=Math.min(1,maxSide/Math.max(w0,h0)),w=Math.round(w0*sc),h=Math.round(h0*sc);
      const cv=document.createElement('canvas');cv.width=w;cv.height=h;const cx=cv.getContext('2d',{willReadFrequently:true});
      cx.fillStyle='#fff';cx.fillRect(0,0,w,h);cx.drawImage(bmp,0,0,w,h);
      const res=window.jsQR(cx.getImageData(0,0,w,h).data,w,h,{inversionAttempts:'attemptBoth'});
      if(res&&res.data)return res.data;
    }
  }
  return null;
}
async function scanQr(){
  const f=$('qrFile').files[0];resetState();
  if(!f){showProfile('Pilih foto QRIS penerima dulu.','bad');return}
  showProfile('Membaca QRIS...');
  try{
    const raw=await decodeQr(f);
    if(!raw)throw new Error('QRIS tidak terbaca. Pakai foto yang jelas, tidak terpotong, dan tidak buram.');
    const r=await fetch('/api/transfer/qris/resolve',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({qrData:raw})});
    const d=await r.json();
    if(!d.success){showProfile('<b>QRIS TIDAK BISA DIPAKAI</b><br>'+esc(d.error),'bad');return}
    checked=d.profile.username;qrOwner=d.qrisName;
    showProfile('<b class="big">QRIS VALID ✓</b><br>Pemilik QRIS: <b>'+esc(d.qrisName)+'</b><br>Akun AVERPAY: <b>@'+esc(d.profile.username)+'</b>','ok');
    $('amountBox').classList.remove('hidden');updateSummary();
  }catch(e){showProfile(esc(e.message||'QRIS gagal dibaca.'),'bad')}
}
$('qrFile').addEventListener('change',()=>{
  const f=$('qrFile').files[0];resetState();
  if(!f){$('qrPreview').classList.add('hidden');return}
  $('qrPreview').src=URL.createObjectURL(f);$('qrPreview').classList.remove('hidden');scanQr();
});
$('scanBtn').addEventListener('click',scanQr);

// ---- Kirim ----
$('sendBtn').addEventListener('click',()=>{
  if(!checked)return showProfile(mode==='qr'?'Upload dan baca QRIS dulu.':'Cek profil penerima dulu.','bad');
  const amount=Math.floor(Number($('amount').value));
  if(!amount||amount<=0)return alert('Isi nominal transfer.');
  const who=mode==='qr'?esc(qrOwner)+' (@'+esc(checked)+')':'@'+esc(checked);
  $('confirmBody').innerHTML='Kirim <b>'+rp(amount)+'</b> ke <b>'+who+'</b>?<br>Biaya admin '+rp(fee())+'<br>Total potong saldo <b>'+rp(amount+fee())+'</b>';
  $('confirmModal').classList.remove('hidden');
});
$('cNo').addEventListener('click',()=>$('confirmModal').classList.add('hidden'));
$('cYes').addEventListener('click',async()=>{
  if(busy)return;
  if(window.PIN_ENABLED){ $('confirmModal').classList.add('hidden'); const okPin=await PinGuard.ask('transfer'); if(!okPin){ $('confirmModal').classList.remove('hidden'); return; } }
  busy=true;$('cYes').disabled=true;
  const amount=Math.floor(Number($('amount').value));
  try{
    const r=await fetch('/api/transfer/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:checked,amount,method:mode==='qr'?'qr':'username'})});
    const d=await r.json();$('confirmModal').classList.add('hidden');
    if(!d.success){alert(d.error||'Transfer gagal.');return}
    $('liveBal').textContent=Number(d.balance).toLocaleString('id-ID');
    $('doneBody').innerHTML='Ke: <b>'+esc(d.receiverName)+'</b> (@'+esc(d.receiver)+')<br>Nominal: <b>'+rp(d.amount)+'</b><br>Biaya admin: '+rp(d.fee)+'<br>ID: '+esc(d.transferId);
    $('doneModal').classList.remove('hidden');
  }catch(e){$('confirmModal').classList.add('hidden');alert('Koneksi bermasalah. Cek riwayat sebelum mengulang.')}
  finally{busy=false;$('cYes').disabled=false}
});
$('doneBtn').addEventListener('click',()=>location.href='/transfer?mode='+mode);

// ---- Download QRIS saya sebagai PNG ----
const dl=$('dlPng');
if(dl)dl.addEventListener('click',async()=>{
  dl.disabled=true;const old=dl.textContent;dl.textContent='MEMBUAT PNG...';
  try{
    const txt=await (await fetch('/transfer/qris-saya.svg',{credentials:'same-origin'})).text();
    const url=URL.createObjectURL(new Blob([txt],{type:'image/svg+xml;charset=utf-8'}));
    const img=await new Promise((ok,no)=>{const i=new Image();i.onload=()=>ok(i);i.onerror=no;i.src=url});
    const cv=document.createElement('canvas');cv.width=1200;cv.height=1720;cv.getContext('2d').drawImage(img,0,0,1200,1720);
    URL.revokeObjectURL(url);
    cv.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='QRIS-AVERPAY-<%= user.username %>.png';document.body.appendChild(a);a.click();a.remove()},'image/png');
  }catch(e){alert('Gagal membuat PNG, pakai tombol download SVG.')}
  finally{dl.disabled=false;dl.textContent=old}
});
})();
</script>
<%- include('partials/footer') %>
