<%- include('partials/header', { title: 'Admin Dashboard' }) %>

<div class="app-container pb-6 mt-1 px-6 sm:px-6 max-w-full overflow-x-hidden">

  <%
    // Hitung jumlah request withdraw yang masih pending
    // Pastikan variabel 'withdrawals' sudah dikirim dari controller
    const pendingWithdrawals = withdrawals.filter(w => w.status === 'pending');
    const pendingWithdrawCount = pendingWithdrawals.length;
    // Opsional: total nominal pending, bisa diaktifkan jika ingin menampilkan nominal
    // const pendingWithdrawAmount = pendingWithdrawals.reduce((sum, w) => sum + w.amount, 0);
  %>

  <!-- ===== JAM & TANGGAL ===== -->
  <%- include('partials/clock_widget', { user: (typeof user !== 'undefined' ? user : null) }) %>

  <!-- ===== SALDO PENGGUNA (besar, samain dengan dashboard member) ===== -->
  <div class="comic-balance-card comic-anim rounded-2xl mb-6 px-6 py-7 relative">
    <div class="relative flex items-center justify-between">
      <span class="text-[13px] font-bold uppercase tracking-wide text-white/90">Total Saldo Pengguna</span>
      <i class="fa-solid fa-vault text-2xl text-white/80"></i>
    </div>
    <div class="relative flex items-center gap-3 mt-2">
      <h2 class="font-comic text-4xl md:text-5xl text-white mb-0 leading-none" style="text-shadow:2px 2px 0 var(--comic-black);">
        Rp <%= stats.totalUserBalance.toLocaleString('id-ID') %>
      </h2>
    </div>
  </div>

  <!-- ===== LIVE COMIC ANALYTICS ===== -->
  <section class="live-comic-board comic-anim mb-6" id="liveComicAnalytics">
    <div class="live-comic-head">
      <div>
        <span class="live-kicker"><i class="fa-solid fa-bolt"></i> LIVE DATA</span>
        <h3>Comic Analytics Center</h3>
        <p>Ringkasan bisnis otomatis diperbarui tanpa reload halaman.</p>
      </div>
      <div class="live-indicator"><span></span><b>LIVE</b></div>
    </div>
    <div class="live-comic-grid">
      <article class="live-stat live-yellow"><small>Total Penjualan</small><strong id="liveSales">Rp <%= stats.totalDepositAmount.toLocaleString('id-ID') %></strong><em><i class="fa-solid fa-chart-line"></i> Deposit sukses</em></article>
      <article class="live-stat live-green"><small>Total Semua Saldo User</small><strong id="liveFunds">Memuat...</strong><em><i class="fa-solid fa-wallet"></i> Aktif + tertahan + top up</em></article>
      <article class="live-stat live-white"><small>Total User</small><strong id="liveUsers"><%= stats.totalUsers.toLocaleString('id-ID') %></strong><em id="liveRoles"><i class="fa-solid fa-users"></i> Semua role</em></article>
      <article class="live-stat live-yellow"><small>Total Transaksi</small><strong id="liveTrx"><%= stats.totalTransactions.toLocaleString('id-ID') %></strong><em id="livePaid"><i class="fa-solid fa-receipt"></i> Memuat status...</em></article>
      <article class="live-stat live-white"><small>Saldo Aktif</small><strong id="liveBalance">Rp <%= stats.totalUserBalance.toLocaleString('id-ID') %></strong><em><i class="fa-solid fa-coins"></i> Wallet balance</em></article>
      <article class="live-stat live-green"><small>Saldo Tertahan</small><strong id="liveHeld">Rp <%= (stats.totalHeldBalance || 0).toLocaleString('id-ID') %></strong><em><i class="fa-solid fa-hourglass-half"></i> Dana hold</em></article>
      <article class="live-stat live-yellow"><small>Saldo Top Up</small><strong id="liveTopup">Memuat...</strong><em><i class="fa-solid fa-circle-plus"></i> Wallet layanan</em></article>
      <article class="live-stat live-white"><small>Withdraw Sukses</small><strong id="liveWithdraw">Rp <%= stats.totalWithdrawAmount.toLocaleString('id-ID') %></strong><em id="livePending"><i class="fa-solid fa-clock"></i> Pending: ...</em></article>
    </div>
    <div class="live-comic-foot"><span id="liveUpdated">Menghubungkan data live...</span><span>Auto refresh 5 detik</span></div>
  </section>

  <!-- ===== STORY (ala IG, tampilan komik) ===== -->
  <%- include('partials/social_card') %>
  <%- include('partials/story_bar') %>

  <!-- ===== HUD STATUS (di bawah Total Saldo Pengguna) ===== -->
  <div class="mb-6 hud-wide">
    <%- include('partials/hud_status') %>
  </div>

  <!-- ===== ANALISIS PENJUALAN (Harian / Bulanan / Tahunan) ===== -->
  <div class="bg-white comic-anim border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-4 mb-8">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
      <h3 class="text-[15px] font-bold text-gray-800 mb-0"><i class="fa-solid fa-chart-line mr-1"></i> Analisis Penjualan</h3>
      <div class="flex items-center gap-2">
        <button type="button" class="salesTab px-3.5 py-1.5 rounded-full text-[12px] font-bold bg-blue-600 text-white" data-range="daily">Harian</button>
        <button type="button" class="salesTab px-3.5 py-1.5 rounded-full text-[12px] font-bold bg-gray-100 text-gray-600" data-range="monthly">Bulanan</button>
        <button type="button" class="salesTab px-3.5 py-1.5 rounded-full text-[12px] font-bold bg-gray-100 text-gray-600" data-range="yearly">Tahunan</button>
      </div>
    </div>

    <!-- Chip ringkas: pengguna & request withdraw -->
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gray-100 text-[12px] font-bold text-gray-700">
        <i class="fa-solid fa-users"></i> Pengguna: <%= stats.totalUsers.toLocaleString('id-ID') %>
      </span>
      <a href="/admin/withdraw" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gray-100 text-[12px] font-bold text-gray-700">
        <i class="fa-solid fa-hand-holding-dollar"></i> Request Withdraw: <%= pendingWithdrawCount %>
      </a>
    </div>

    <!-- Kartu ringkasan periode berjalan vs periode sebelumnya -->
    <p id="salesPeriodLabel" class="text-[12px] font-bold uppercase tracking-wide text-gray-500 mb-2">Hari ini</p>
    <div class="grid grid-cols-2 gap-3 mb-4">
      <div class="rounded-xl border border-gray-200 bg-[#f9f9f9] px-3 py-3">
        <p class="text-[11.5px] font-semibold text-gray-500 mb-1">Omzet Penjualan</p>
        <p id="sOmzet" class="text-[15px] font-bold text-gray-800 mb-0">Rp 0</p>
        <p id="sOmzetD" class="text-[11px] font-semibold mb-0"></p>
      </div>
      <div class="rounded-xl border border-gray-200 bg-[#f9f9f9] px-3 py-3">
        <p class="text-[11.5px] font-semibold text-gray-500 mb-1">Fee TRX Masuk</p>
        <p id="sFee" class="text-[15px] font-bold text-gray-800 mb-0">Rp 0</p>
        <p id="sFeeD" class="text-[11px] font-semibold mb-0"></p>
      </div>
      <div class="rounded-xl border border-gray-200 bg-[#f9f9f9] px-3 py-3">
        <p class="text-[11.5px] font-semibold text-gray-500 mb-1">Jumlah Transaksi</p>
        <p id="sTrx" class="text-[15px] font-bold text-gray-800 mb-0">0</p>
        <p id="sTrxD" class="text-[11px] font-semibold mb-0"></p>
      </div>
      <div class="rounded-xl border border-gray-200 bg-[#f9f9f9] px-3 py-3">
        <p class="text-[11.5px] font-semibold text-gray-500 mb-1">Withdraw</p>
        <p id="sWd" class="text-[15px] font-bold text-gray-800 mb-0">Rp 0</p>
        <p id="sWdD" class="text-[11px] font-semibold mb-0"></p>
      </div>
    </div>

    <!-- Grafik -->
    <div class="flex items-center flex-wrap gap-x-4 gap-y-1 text-[11.5px] font-semibold mb-2">
      <span class="flex items-center gap-1.5 text-gray-600"><span class="w-2.5 h-2.5 rounded-full" style="background:#22c55e"></span> Omzet</span>
      <span class="flex items-center gap-1.5 text-gray-600"><span class="w-2.5 h-2.5 rounded-full" style="background:#ef4444"></span> Withdraw</span>
      <span class="flex items-center gap-1.5 text-gray-600"><span class="w-2.5 h-2.5 rounded-full" style="background:#f59e0b"></span> Fee</span>
    </div>
    <div style="position:relative;height:250px;">
      <canvas id="salesChart"></canvas>
    </div>

    <!-- Total untuk rentang yang tampil -->
    <div class="mt-3 rounded-xl border border-gray-200 bg-[#f9f9f9] px-3 py-3">
      <p id="sRangeLabel" class="text-[11.5px] font-semibold text-gray-500 mb-1">Total 30 hari terakhir</p>
      <p class="text-[12.5px] font-bold text-gray-800 mb-0">
        Omzet <span id="rOmzet">Rp 0</span> · Fee <span id="rFee">Rp 0</span><br>
        <span id="rTrx">0</span> transaksi · Rata-rata <span id="rAvg">Rp 0</span> · Withdraw <span id="rWd">Rp 0</span>
      </p>
    </div>

    <!-- Tabel rincian -->
    <div class="mt-3 overflow-x-auto" style="max-height:320px;overflow-y:auto;">
      <table class="w-full text-[12px] text-left">
        <thead class="sticky top-0 bg-white">
          <tr class="text-gray-500 border-b border-gray-200">
            <th class="py-2 pr-3 font-bold whitespace-nowrap">Periode</th>
            <th class="py-2 pr-3 font-bold text-right whitespace-nowrap">Trx</th>
            <th class="py-2 pr-3 font-bold text-right whitespace-nowrap">Omzet</th>
            <th class="py-2 pr-3 font-bold text-right whitespace-nowrap">Fee</th>
            <th class="py-2 font-bold text-right whitespace-nowrap">Withdraw</th>
          </tr>
        </thead>
        <tbody id="salesTbody"></tbody>
      </table>
    </div>

    <!-- Sepanjang waktu -->
    <div class="mt-3 pt-3 border-t border-dashed border-gray-300 text-[11.5px] font-semibold text-gray-600">
      Sepanjang waktu: Deposit Rp <%= stats.totalDepositAmount.toLocaleString('id-ID') %> ·
      Fee TRX Rp <%= stats.totalDepositFee.toLocaleString('id-ID') %> ·
      Withdraw Rp <%= stats.totalWithdrawAmount.toLocaleString('id-ID') %> ·
      Fee WD Rp <%= stats.totalWithdrawFee.toLocaleString('id-ID') %> ·
      <%= stats.totalTransactions.toLocaleString('id-ID') %> transaksi
    </div>
  </div>
</div>

<style>
.live-comic-board{background:#111827;border:3px solid #111;border-radius:22px;padding:16px;box-shadow:6px 6px 0 #facc15;overflow:hidden;position:relative}.live-comic-board:before{content:"";position:absolute;inset:0;opacity:.12;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:14px 14px;pointer-events:none}.live-comic-head,.live-comic-grid,.live-comic-foot{position:relative}.live-comic-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px;color:#fff}.live-kicker{display:inline-flex;gap:6px;align-items:center;background:#facc15;color:#111;padding:4px 9px;border:2px solid #111;border-radius:999px;font-size:10px;font-weight:900}.live-comic-head h3{font-size:20px;font-weight:1000;margin:7px 0 1px;text-transform:uppercase;letter-spacing:-.4px}.live-comic-head p{font-size:11px;color:#d1d5db;margin:0}.live-indicator{display:flex;align-items:center;gap:6px;background:#fff;color:#111;border:2px solid #111;border-radius:999px;padding:5px 9px;font-size:10px}.live-indicator span{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18);animation:livePulse 1.3s infinite}.live-comic-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.live-stat{min-height:112px;border:3px solid #111;border-radius:15px;padding:12px;box-shadow:3px 3px 0 #000;display:flex;flex-direction:column;justify-content:space-between;color:#111;transition:transform .18s ease}.live-stat:hover{transform:translate(-1px,-2px)}.live-yellow{background:#facc15}.live-green{background:#4ade80}.live-white{background:#fff}.live-stat small{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.3px}.live-stat strong{font-size:18px;font-weight:1000;line-height:1.05;word-break:break-word}.live-stat em{font-size:9.5px;font-weight:800;font-style:normal;opacity:.72}.live-comic-foot{display:flex;justify-content:space-between;gap:10px;color:#9ca3af;font-size:9.5px;font-weight:700;margin-top:12px}.live-flash{animation:liveFlash .45s ease}@keyframes livePulse{50%{opacity:.35;transform:scale(.8)}}@keyframes liveFlash{50%{transform:scale(1.025)}}@media(max-width:900px){.live-comic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:430px){.live-comic-board{padding:12px;box-shadow:4px 4px 0 #facc15}.live-comic-head h3{font-size:16px}.live-comic-head p{max-width:220px}.live-stat{min-height:102px;padding:10px}.live-stat strong{font-size:15px}.live-comic-foot{flex-direction:column;gap:2px}}
</style>
<script>
(function(){
  const rp=n=>'Rp '+Math.round(Number(n)||0).toLocaleString('id-ID'), num=n=>Math.round(Number(n)||0).toLocaleString('id-ID');
  const set=(id,val)=>{const el=document.getElementById(id);if(!el||el.textContent===val)return;if(el.textContent!==val){el.textContent=val;el.classList.remove('live-flash');void el.offsetWidth;el.classList.add('live-flash')}};
  async function refreshLiveAnalytics(){
    try{
      const r=await fetch('/admin/api/live-analytics',{cache:'no-store',headers:{Accept:'application/json'}}); if(!r.ok) throw new Error('HTTP '+r.status); const d=await r.json(); if(!d.ok) throw new Error(d.error||'error');
      set('liveSales',rp(d.totalSales));set('liveFunds',rp(d.totalAllUserFunds));set('liveUsers',num(d.totalUsers));set('liveTrx',num(d.totalTransactions));set('liveBalance',rp(d.balance));set('liveHeld',rp(d.heldBalance));set('liveTopup',rp(d.topupBalance));set('liveWithdraw',rp(d.totalWithdraw));set('livePaid','✓ '+num(d.paidTransactions)+' deposit sukses');set('livePending','⏱ Pending: '+num(d.pendingTransactions));
      const roles=d.roleMap||{}; set('liveRoles','User '+num(roles.user||0)+' · VIP '+num(roles.vip||0)+' · Merchant '+num(roles.merchant||0));
      const dt=new Date(d.updatedAt); set('liveUpdated','Terakhir update '+dt.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',second:'2-digit'}));
    }catch(e){set('liveUpdated','Koneksi live terputus — mencoba lagi...')}
  }
  refreshLiveAnalytics(); setInterval(refreshLiveAnalytics,5000); document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshLiveAnalytics()});
})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script type="application/json" id="salesData"><%- JSON.stringify(salesSeries || { daily: [], monthly: [], yearly: [] }) %></script>
<script>
  (function () {
    const canvas = document.getElementById('salesChart');
    if (!canvas || typeof Chart === 'undefined') return;
    let data = { daily: [], monthly: [], yearly: [] };
    try { data = JSON.parse(document.getElementById('salesData').textContent) || data; } catch (e) {}

    const META = {
      daily:   { cur: 'Hari ini',  prev: 'kemarin',    range: 'Total 30 hari terakhir' },
      monthly: { cur: 'Bulan ini', prev: 'bulan lalu', range: 'Total 12 bulan terakhir' },
      yearly:  { cur: 'Tahun ini', prev: 'tahun lalu', range: 'Total 5 tahun terakhir' }
    };
    const rp = (n) => 'Rp ' + Math.round(n || 0).toLocaleString('id-ID');
    const num = (n) => Math.round(n || 0).toLocaleString('id-ID');
    const $ = (id) => document.getElementById(id);

    const chart = new Chart(canvas.getContext('2d'), {
      data: {
        labels: [],
        datasets: [
          { type: 'bar',  label: 'Omzet',    data: [], backgroundColor: 'rgba(34,197,94,.75)',  borderRadius: 4 },
          { type: 'bar',  label: 'Withdraw', data: [], backgroundColor: 'rgba(239,68,68,.70)',  borderRadius: 4 },
          { type: 'line', label: 'Fee',      data: [], borderColor: '#f59e0b', backgroundColor: '#f59e0b', tension: 0.35, pointRadius: 2 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => c.dataset.label + ': ' + rp(c.parsed.y) } } },
        scales: {
          y: { beginAtZero: true, ticks: { callback: (v) => rp(v) } },
          x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 7 } }
        }
      }
    });

    function delta(elId, cur, prev, prevLabel) {
      const el = $(elId);
      if (!prev) {
        el.textContent = cur > 0 ? 'Baru (belum ada data ' + prevLabel + ')' : '— sama seperti ' + prevLabel;
        el.style.color = cur > 0 ? '#16a34a' : '#6b7280';
        return;
      }
      const pct = ((cur - prev) / prev) * 100;
      const up = pct >= 0;
      el.textContent = (up ? '▲ ' : '▼ ') + Math.abs(pct).toFixed(1) + '% vs ' + prevLabel;
      el.style.color = up ? '#16a34a' : '#dc2626';
    }

    function render(range) {
      const rows = data[range] || [];
      const m = META[range];
      const cur = rows[rows.length - 1] || { omzet: 0, fee: 0, trx: 0, wd: 0 };
      const prev = rows[rows.length - 2] || { omzet: 0, fee: 0, trx: 0, wd: 0 };

      $('salesPeriodLabel').textContent = m.cur;
      $('sOmzet').textContent = rp(cur.omzet); delta('sOmzetD', cur.omzet, prev.omzet, m.prev);
      $('sFee').textContent   = rp(cur.fee);   delta('sFeeD',   cur.fee,   prev.fee,   m.prev);
      $('sTrx').textContent   = num(cur.trx);  delta('sTrxD',   cur.trx,   prev.trx,   m.prev);
      $('sWd').textContent    = rp(cur.wd);    delta('sWdD',    cur.wd,    prev.wd,    m.prev);

      chart.data.labels = rows.map((r) => r.label);
      chart.data.datasets[0].data = rows.map((r) => r.omzet);
      chart.data.datasets[1].data = rows.map((r) => r.wd);
      chart.data.datasets[2].data = rows.map((r) => r.fee);
      chart.update();

      const t = rows.reduce((a, r) => {
        a.omzet += r.omzet; a.fee += r.fee; a.trx += r.trx; a.wd += r.wd; return a;
      }, { omzet: 0, fee: 0, trx: 0, wd: 0 });
      $('sRangeLabel').textContent = m.range;
      $('rOmzet').textContent = rp(t.omzet);
      $('rFee').textContent = rp(t.fee);
      $('rTrx').textContent = num(t.trx);
      $('rAvg').textContent = rp(t.trx ? t.omzet / t.trx : 0);
      $('rWd').textContent = rp(t.wd);

      $('salesTbody').innerHTML = rows.slice().reverse().map((r) =>
        '<tr class="border-b border-gray-100">' +
        '<td class="py-2 pr-3 font-semibold text-gray-700 whitespace-nowrap">' + r.label + '</td>' +
        '<td class="py-2 pr-3 text-right">' + num(r.trx) + '</td>' +
        '<td class="py-2 pr-3 text-right whitespace-nowrap">' + rp(r.omzet) + '</td>' +
        '<td class="py-2 pr-3 text-right whitespace-nowrap">' + rp(r.fee) + '</td>' +
        '<td class="py-2 text-right whitespace-nowrap">' + rp(r.wd) + '</td>' +
        '</tr>'
      ).join('');
    }

    document.querySelectorAll('.salesTab').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.salesTab').forEach((b) => { b.classList.remove('bg-blue-600', 'text-white'); b.classList.add('bg-gray-100', 'text-gray-600'); });
        btn.classList.remove('bg-gray-100', 'text-gray-600'); btn.classList.add('bg-blue-600', 'text-white');
        render(btn.dataset.range);
      });
    });

    render('daily');
  })();
</script>

<%- include('partials/footer') %>
