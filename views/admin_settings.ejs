          <img src="https://img3.pixhost.to/images/6091/776776751_356980.jpg" alt="ShopeePay" class="w-8 h-8 rounded-xl object-cover border border-gray-200">
          <div>
            <p class="text-xs font-medium text-gray-800">ShopeePay</p>
            <p class="text-[10px] text-gray-400">Pembayaran QRIS ShopeePay Merchant</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">API Key</label>
            <textarea name="kianarapayApiKey" rows="2" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="kg_live_..."><%= settings.kianarapayApiKey || '' %></textarea>
            <p class="text-[10px] text-gray-400 mt-2">Isi API key akun ShopeePay Merchant kamu. Pastikan akun Shopee sudah terhubung terlebih dahulu.</p>
          </div>

          <div class="border-t border-gray-100 pt-3 mt-1">
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-medium text-gray-700">Tahan Saldo (Hold) Deposit ShopeePay</label>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="shopeepayHoldEnabled" id="shopeepayHoldEnabled" class="sr-only peer" <%= settings.shopeepayHoldEnabled ? "checked" : "" %>>
                <div class="w-10 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:bg-green-500 transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-5"></div>
                <span class="ml-2 text-xs font-medium text-gray-600" id="shopeepayHoldLabel"><%= settings.shopeepayHoldEnabled ? "Aktif" : "Nonaktif" %></span>
              </label>
            </div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Jam Otomatis Cair (semua role)</label>
            <input name="shopeepayHoldHours" type="number" min="1" max="720" value="<%= settings.shopeepayHoldHours || 24 %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="24">
            <p class="text-[10px] text-gray-500 mt-2">Kalau <strong>Aktif</strong>: saldo hasil deposit ShopeePay (semua role) masuk dulu ke "Saldo Tertahan" dan otomatis cair ke saldo aktif sesuai jam di atas. Admin tetap bisa mencairkan manual dari menu User. Kalau <strong>Nonaktif</strong>, langsung masuk saldo tanpa ditahan.</p>
          </div>
        </div>
      </div>

      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Gateway
        </button>
