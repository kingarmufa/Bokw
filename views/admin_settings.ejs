<script>
  // "Portal": pindahkan kedua modal ke langsung jadi child dari <body>.
  // <main> di layout punya animasi masuk halaman (comicPageIn) yang memakai
  // transform — di beberapa browser mobile, elemen dengan position:fixed yang
  // masih jadi keturunan elemen ber-animasi transform begitu ikut "terjebak"
  // jadi relatif ke elemen itu (bukan ke layar penuh), sehingga modal
  // kelihatan kepotong/nempel di posisi yang salah. Dengan dipindah jadi
  // langsung anak dari <body>, position:fixed pasti dihitung relatif ke
  // viewport asli, bukan ke <main>.
  (function() {
    const mM = document.getElementById('methodModal');
    const iM = document.getElementById('instantMethodModal');
    if (mM) document.body.appendChild(mM);
    if (iM) document.body.appendChild(iM);
  })();

  // Kunci scroll body selama modal terbuka, tanpa bikin halaman "lompat".
  // Modal sendiri selalu tampil DI TENGAH LAYAR (position:fixed + flex center)
  // jadi tidak butuh scroll halaman apapun untuk menampilkannya.
  let _lockedScrollY = 0;
  function lockBodyScroll() {
    _lockedScrollY = window.scrollY || window.pageYOffset || 0;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${_lockedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
  }
  function unlockBodyScroll() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    window.scrollTo(0, _lockedScrollY);
  }

  // ==============================
  // QR Decoder dari Upload Gambar
  // ==============================
  document.getElementById('qrImageInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    const fileNameSpan = document.getElementById('qrFileName');
    if (!file) {
      fileNameSpan.textContent = 'Tidak ada file';
      return;
    }
    fileNameSpan.textContent = file.name;

    const reader = new FileReader();
    reader.onload = function(event) {
      const img = new Image();
      img.onload = function() {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = img.width;
        canvas.height = img.height;
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        
        if (typeof jsQR === 'undefined') {
          alert('Library jsQR tidak ditemukan. Pastikan koneksi internet aktif.');
          return;
        }
        
        const code = jsQR(imageData.data, imageData.width, imageData.height);
        if (code) {
          document.getElementById('gopayStaticQr').value = code.data;
          const notif = document.getElementById('localNotif');
          if (notif) {
            document.getElementById('localNotifMessage').textContent = 'QR Code berhasil dibaca dan string terisi.';
            notif.classList.remove('hidden');
            setTimeout(() => notif.classList.add('hidden'), 3000);
          }
        } else {
          alert('Tidak dapat mendeteksi QR Code pada gambar. Pastikan gambar jelas dan berisi QR Code.');
        }
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  });

  // ==============================
  // Withdraw Methods Manual (dengan field min)
  // ==============================
  (function() {
    let withdrawMethods = <%- JSON.stringify(settings.withdrawMethods || []) %>;
    // Pastikan setiap item memiliki field min (default 0)
    withdrawMethods = withdrawMethods.map(m => ({
      name: m.name,
      fee: typeof m.fee === 'number' ? m.fee : 0,
      min: (typeof m.min === 'number' && m.min > 0) ? m.min : 0
    }));

    const listContainer = document.getElementById('withdrawMethodList');
    const jsonInput = document.getElementById('withdrawMethodsJsonInput');
    const modal = document.getElementById('methodModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const methodForm = document.getElementById('methodForm');
    const editIndexInput = document.getElementById('editIndex');
    const nameInput = document.getElementById('methodName');
    const feeInput = document.getElementById('methodFee');
    const minInput = document.getElementById('methodMin');
    const btnAdd = document.getElementById('btnAddMethod');
    const btnCloseModal = document.getElementById('btnCloseModal');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const notifBox = document.getElementById('localNotif');
    const notifMessage = document.getElementById('localNotifMessage');
    const mainForm = document.getElementById('mainSettingsForm');

    // Logo preview (URL based)
    const logoUrlInput = document.getElementById('logoUrlInput');
    const logoPreview = document.getElementById('logoPreview');
    const logoPreviewImg = document.getElementById('logoPreviewImg');

    if (logoUrlInput) {
      logoUrlInput.addEventListener('input', function() {
        const url = logoUrlInput.value.trim();
        if (url) {
          logoPreviewImg.src = url;
          logoPreview.classList.remove('hidden');
        } else {
          logoPreview.classList.add('hidden');
        }
      });
    }

    function showLocalNotification(message, type = 'success') {
      if (!notifBox || !notifMessage) return;
      notifBox.className = type === 'success' 
        ? 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3'
        : 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3';
      notifMessage.textContent = message;
      notifBox.classList.remove('hidden');
      setTimeout(() => notifBox.classList.add('hidden'), 5000);
    }

    function renderList() {
      if (!listContainer) return;
      if (withdrawMethods.length === 0) {
        listContainer.innerHTML = `<div class="text-center py-6 text-gray-400 text-xs font-medium bg-gray-50 rounded-xl border border-gray-200">Belum ada metode withdraw manual. Klik tombol "Tambah Metode".</div>`;
      } else {
        listContainer.innerHTML = withdrawMethods.map((m, i) => `
          <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3 border border-gray-200 hover:border-gray-400 transition-all">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-white border border-gray-200 flex items-center justify-center text-xs font-medium text-gray-600">
                ${m.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800">${escapeHtml(m.name)}</p>
                <p class="text-xs font-medium text-gray-800">Fee: Rp ${m.fee.toLocaleString('id-ID')} | Min: ${m.min > 0 ? 'Rp ' + m.min.toLocaleString('id-ID') : '<span class="text-gray-400">Sesuai Default</span>'}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="w-8 h-8 flex items-center justify-center bg-blue-500 hover:bg-blue-600 text-white transition-colors rounded-xl shadow-sm" onclick="editMethod(${i}, this)" title="Edit">
                <i class="fas fa-pen text-xs"></i>
              </button>
              <button type="button" class="w-8 h-8 flex items-center justify-center bg-red-500 hover:bg-red-600 text-white transition-colors rounded-xl shadow-sm" onclick="deleteMethod(${i})" title="Hapus">
                <i class="fas fa-trash text-xs"></i>
              </button>
            </div>
          </div>
        `).join('');
      }
      if (jsonInput) {
        jsonInput.value = JSON.stringify(withdrawMethods);
      }
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showModal(editing = false, index = -1, triggerEl = null) {
      if (editing && index >= 0 && index < withdrawMethods.length) {
        modalTitle.textContent = 'Edit Metode Withdraw Manual';
        editIndexInput.value = index;
        nameInput.value = withdrawMethods[index].name;
        feeInput.value = withdrawMethods[index].fee;
        minInput.value = withdrawMethods[index].min;
      } else {
        modalTitle.textContent = 'Tambah Metode Withdraw Manual';
        editIndexInput.value = -1;
        nameInput.value = '';
        feeInput.value = '1000';
        minInput.value = '0';
      }
      modal.classList.remove('hidden');
      lockBodyScroll();
      if (modalContent) modalContent.scrollTop = 0;
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function hideModal() {
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      unlockBodyScroll();
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    methodForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = nameInput.value.trim();
      const fee = parseInt(feeInput.value);
      const min = parseInt(minInput.value) || 0;
      if (!name || isNaN(fee) || fee < 0 || isNaN(min) || min < 0) {
        alert('Nama, biaya, dan minimal penarikan harus diisi dengan benar.');
        return;
      }

      const editIdx = parseInt(editIndexInput.value);
      if (editIdx >= 0) {
        withdrawMethods[editIdx] = { name, fee, min };
      } else {
        withdrawMethods.push({ name, fee, min });
      }

      jsonInput.value = JSON.stringify(withdrawMethods);
      renderList();

      try {
        const response = await fetch('/admin/settings/withdraw-methods', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ withdrawMethods })
        });
        const data = await response.json();
        if (response.ok && data.success) {
          showLocalNotification('Metode withdraw manual berhasil disimpan.');
          hideModal();
        } else {
          if (editIdx >= 0) {
            showLocalNotification('Gagal menyimpan metode.', 'error');
          } else {
            withdrawMethods.pop();
            renderList();
            alert('Gagal menyimpan metode.');
          }
        }
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan jaringan.\n' + err);
        if (editIdx === -1) {
          withdrawMethods.pop();
          renderList();
        }
      }
    });

    btnAdd.addEventListener('click', function() { showModal(false, -1, btnAdd); });
    btnCloseModal.addEventListener('click', hideModal);
    btnCancelModal.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) hideModal();
    });

    window.editMethod = function(index, triggerEl) {
      showModal(true, index, triggerEl);
    };
    
    window.deleteMethod = async function(index) {
      if (!confirm('Hapus metode ini?')) return;
      const deletedMethod = withdrawMethods.splice(index, 1)[0];
      jsonInput.value = JSON.stringify(withdrawMethods);
      renderList();

      try {
        const response = await fetch('/admin/settings/withdraw-methods', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ withdrawMethods })
        });
        const data = await response.json();
        if (response.ok && data.success) {
          showLocalNotification('Metode berhasil dihapus.');
        } else {
          withdrawMethods.splice(index, 0, deletedMethod);
          jsonInput.value = JSON.stringify(withdrawMethods);
          renderList();
          alert('Gagal menghapus metode.');
        }
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan jaringan.');
        withdrawMethods.splice(index, 0, deletedMethod);
        jsonInput.value = JSON.stringify(withdrawMethods);
        renderList();
      }
    };

    mainForm.addEventListener('submit', function(e) {
      jsonInput.value = JSON.stringify(withdrawMethods);
    });

    renderList();
  })();

  // ==============================
  // Instant Withdraw Methods (H2H) - Disimpan via AJAX langsung
  // ==============================
  (function() {
    let instantMethods = <%- JSON.stringify(settings.instantWithdrawMethods || []) %>;
    // Produk (kode + nominal + fee) yang sedang diedit di dalam modal, terpisah
    // dari instantMethods supaya bisa dibatalkan (Batal) tanpa menyentuh data asli.
    let editingProducts = [];
    const listContainer = document.getElementById('instantMethodList');
    const jsonInput = document.getElementById('instantWithdrawMethodsJsonInput');
    // ===== Pilihan provider (VIP Reseller / FR3 / Austin) — ganti provider = daftar metode otomatis berganti =====
    const austinMethodsInit = <%- JSON.stringify(settings.austinWithdrawMethods || []) %>;
    const sekalipayMethodsInit = <%- JSON.stringify(settings.sekalipayWithdrawMethods || []) %>;
    const PROVIDER_LABEL = { vipreseller: 'VIP Reseller', fr3: 'FR3 NEWERA', austin: 'Austin Pay', sekalipay: 'Sekalipay' };
    const provOf = (m) => (m && m.provider === 'vipreseller') ? 'vipreseller' : 'fr3';
    let activeProvider = <%- JSON.stringify(settings.instantActiveProvider || '') %>; // provider yang sudah TERSIMPAN di database
    let currentProvider = (function() {
      if (PROVIDER_LABEL[activeProvider]) return activeProvider;
      try { const saved = sessionStorage.getItem('instantProviderTab'); if (saved && PROVIDER_LABEL[saved]) return saved; } catch (e) {}
      const fixed = <%- JSON.stringify(settings.instantWithdrawMethods || []) %>;
      if (fixed.some(m => provOf(m) === 'vipreseller')) return 'vipreseller';
      if (fixed.some(m => provOf(m) === 'fr3')) return 'fr3';
      if (austinMethodsInit.length) return 'austin';
      if (sekalipayMethodsInit.length) return 'sekalipay';
      return 'fr3';
    })();
    function updateProviderTabs() {
      document.querySelectorAll('.instant-provider-tab').forEach(btn => {
        const on = btn.dataset.provider === currentProvider;
        btn.className = 'instant-provider-tab px-2 py-3 rounded-2xl text-xs font-medium border transition-all ' + (on ? 'bg-blue-500 text-white border-blue-500 shadow-sm' : 'bg-gray-50 text-gray-700 border-gray-200 hover:border-gray-400');
      });
      const counts = { vipreseller: 0, fr3: 0, austin: (window.__austinCount ? window.__austinCount() : austinMethodsInit.length), sekalipay: (window.__sekalipayCount ? window.__sekalipayCount() : sekalipayMethodsInit.length) };
      instantMethods.forEach(m => { counts[provOf(m)]++; });
      Object.keys(counts).forEach(k => {
        const el = document.querySelector('[data-count="' + k + '"]');
        if (el) el.textContent = counts[k] + ' metode';
      });
      const actLbl = document.getElementById('instantActiveLabel');
      if (actLbl) actLbl.textContent = activeProvider ? PROVIDER_LABEL[activeProvider] : 'Belum dipilih (semua provider tampil)';
      const saveBtn = document.getElementById('btnSaveActiveProvider');
      if (saveBtn) {
        const same = currentProvider === activeProvider;
        saveBtn.disabled = same;
        saveBtn.className = 'mt-3 w-full px-3 py-3 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2 ' + (same ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 hover:bg-blue-600 text-white');
        saveBtn.innerHTML = same ? '<i class="fas fa-check text-xs"></i> ' + PROVIDER_LABEL[currentProvider] + ' sudah aktif' : '<i class="fas fa-save text-xs"></i> Simpan Provider Aktif: ' + PROVIDER_LABEL[currentProvider];
      }
      const fixedCard = document.getElementById('metode-withdraw-instan');
      const austinCard = document.getElementById('metode-withdraw-austin');
      const sekalipayCard = document.getElementById('metode-withdraw-sekalipay');
      const openProv = currentProvider === 'austin' || currentProvider === 'sekalipay';
      if (fixedCard) fixedCard.style.display = openProv ? 'none' : '';
      if (austinCard) austinCard.style.display = currentProvider === 'austin' ? '' : 'none';
      if (sekalipayCard) sekalipayCard.style.display = currentProvider === 'sekalipay' ? '' : 'none';
      const title = document.getElementById('instantCardTitle');
      if (title) title.textContent = 'Metode Withdraw Instan ' + PROVIDER_LABEL[currentProvider] + ' — Nominal Pilihan';
      const lbl = document.getElementById('btnAddInstantLabel');
      if (lbl) lbl.textContent = 'Metode ' + PROVIDER_LABEL[currentProvider];
    }
    window.setInstantProvider = function(p) {
      if (!PROVIDER_LABEL[p]) return;
      currentProvider = p;
      try { sessionStorage.setItem('instantProviderTab', p); } catch (e) {}
      renderList();
    };
    window.__refreshProviderTabs = function() { updateProviderTabs(); };
    const btnSaveActive = document.getElementById('btnSaveActiveProvider');
    if (btnSaveActive) btnSaveActive.addEventListener('click', async function() {
      btnSaveActive.disabled = true;
      try {
        const r = await fetch('/admin/settings/instant-active-provider', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ provider: currentProvider }) });
        const d = await r.json();
        if (!r.ok || !d.success) throw new Error(d.error || 'Gagal menyimpan');
        activeProvider = d.provider;
        showLocalNotification('Provider aktif disimpan: ' + PROVIDER_LABEL[activeProvider] + '. User sekarang hanya melihat metode provider ini.');
      } catch (e) { alert('Gagal menyimpan provider aktif: ' + e.message); }
      updateProviderTabs();
    });
    document.querySelectorAll('.instant-provider-tab').forEach(btn => btn.addEventListener('click', () => window.setInstantProvider(btn.dataset.provider)));
    const modal = document.getElementById('instantMethodModal');
    const modalContent = document.getElementById('instantModalContent');
    const modalTitle = document.getElementById('instantModalTitle');
    const form = document.getElementById('instantMethodForm');
    const editIndexInput = document.getElementById('instantEditIndex');
    const nameInput = document.getElementById('instantMethodName');
    const ewalletInput = document.getElementById('instantMethodEwallet');
    const providerInput = document.getElementById('instantMethodProvider');
    function syncProviderHint() {
      const vip = providerInput && providerInput.value === 'vipreseller';
      const hint = document.getElementById('instantProviderHint');
      const lbl = document.getElementById('instantProductLabel');
      if (hint) hint.textContent = vip ? 'Kode produk = KODE LAYANAN VIP Reseller (type=services). Nomor tujuan dikirim sebagai data_no.' : 'Kode produk = kode produk FR3 NEWERA.';
      if (lbl) lbl.textContent = vip ? 'Kode Layanan VIP Reseller' : 'Kode Produk FR3 NEWERA';
    }
    if (providerInput) providerInput.addEventListener('change', syncProviderHint);
    const activeCheck = document.getElementById('instantMethodActive');
    const feeInput = document.getElementById('instantMethodFee');
    const btnAdd = document.getElementById('btnAddInstantMethod');
    const btnCloseModal = document.getElementById('btnCloseInstantModal');
    const btnCancelModal = document.getElementById('btnCancelInstantModal');
    const btnAddProductRow = document.getElementById('btnAddProductRow');
    const productRowsContainer = document.getElementById('instantProductRows');
    const productError = document.getElementById('instantProductError');
    const notifBox = document.getElementById('localNotif');
    const notifMessage = document.getElementById('localNotifMessage');

    function renderProductRows() {
      if (!productRowsContainer) return;
      if (editingProducts.length === 0) {
        productRowsContainer.innerHTML = `<div class="text-center py-4 text-gray-400 text-[11px] font-medium bg-gray-50 rounded-xl border border-gray-200">Belum ada produk. Klik "Tambah Produk".</div>`;
        return;
      }
      productRowsContainer.innerHTML = editingProducts.map((p, i) => `
        <div class="flex items-center gap-2 bg-gray-50 rounded-xl border border-gray-200 p-2 pr-3">
          <input type="text" data-idx="${i}" data-field="code" value="${escapeHtml(p.code)}" placeholder="Kode (mis. g1)" class="product-code-input w-24 bg-white border border-gray-100 rounded-xl px-2 py-2 text-[11px] font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500">
          <input type="number" data-idx="${i}" data-field="amount" value="${p.amount}" placeholder="Nominal" min="0" class="product-amount-input flex-1 bg-white border border-gray-100 rounded-xl px-2 py-2 text-[11px] font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500">
          <button type="button" data-idx="${i}" class="product-remove-btn shrink-0 w-8 h-8 flex items-center justify-center bg-red-500 hover:bg-red-600 text-white transition-colors rounded-xl shadow-sm" title="Hapus produk">
            <i class="fas fa-trash text-xs"></i>
          </button>
        </div>
      `).join('');

      productRowsContainer.querySelectorAll('.product-code-input, .product-amount-input').forEach(el => {
        el.addEventListener('input', function() {
          const idx = parseInt(this.dataset.idx);
          const field = this.dataset.field;
          if (!editingProducts[idx]) return;
          editingProducts[idx][field] = field === 'code' ? this.value : (parseInt(this.value) || 0);
        });
      });
      productRowsContainer.querySelectorAll('.product-remove-btn').forEach(el => {
        el.addEventListener('click', function() {
          const idx = parseInt(this.dataset.idx);
          editingProducts.splice(idx, 1);
          renderProductRows();
        });
      });
    }

    if (btnAddProductRow) {
      btnAddProductRow.addEventListener('click', function() {
        editingProducts.push({ code: '', amount: 10000 });
        renderProductRows();
      });
    }

    function showLocalNotification(message, type = 'success') {
      if (!notifBox || !notifMessage) return;
      notifBox.className = type === 'success' 
        ? 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3'
        : 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3';
      notifMessage.textContent = message;
      notifBox.classList.remove('hidden');
      setTimeout(() => notifBox.classList.add('hidden'), 5000);
    }

    function renderList() {
      if (!listContainer) return;
      updateProviderTabs();
      const visible = instantMethods.map((m, i) => ({ m, i })).filter(x => provOf(x.m) === currentProvider);
      if (currentProvider === 'austin' || currentProvider === 'sekalipay') {
        // Kartu Austin/Sekalipay punya daftar & penyimpanan sendiri; di sini hanya perlu menyimpan pilihan tab.
      } else if (visible.length === 0) {
        listContainer.innerHTML = `<div class="text-center py-6 text-gray-400 text-xs font-medium bg-gray-50 rounded-xl border border-gray-200">Belum ada metode ${PROVIDER_LABEL[currentProvider]}. Kosong &mdash; buat dulu dengan tombol "Metode ${PROVIDER_LABEL[currentProvider]}" lalu Simpan.</div>`;
      } else {
        listContainer.innerHTML = visible.map(({ m, i }) => `
          <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3 border border-gray-200 hover:border-gray-400 transition-all">
            <div class="flex items-center gap-3 flex-1">
              <div class="w-8 h-8 rounded-xl bg-white border border-gray-200 flex items-center justify-center text-xs font-medium text-gray-600">
                ${m.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <p class="text-xs font-medium text-gray-800">${escapeHtml(m.name)}</p>
                  <span class="text-[10px] px-1.5 py-0.5 rounded-xl font-medium ${m.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${m.active ? 'Aktif' : 'Nonaktif'}</span>
                </div>
                <p class="text-xs text-gray-500">Provider: ${PROVIDER_LABEL[provOf(m)]} | E-Wallet: ${escapeHtml(m.ewallet || '-')} | ${(m.products || []).length} produk | Biaya admin: Rp${(m.fee || 0).toLocaleString('id-ID')} (ditambahkan)</p>
                <p class="text-[11px] text-gray-400">${(m.products || []).map(p => `${escapeHtml(p.code)}: Rp${p.amount.toLocaleString('id-ID')}`).join(', ') || 'Belum ada produk'}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="w-8 h-8 flex items-center justify-center bg-blue-500 hover:bg-blue-600 text-white transition-colors rounded-xl shadow-sm" onclick="editInstantMethod(${i}, this)" title="Edit">
                <i class="fas fa-pen text-xs"></i>
              </button>
              <button type="button" class="w-8 h-8 flex items-center justify-center bg-red-500 hover:bg-red-600 text-white transition-colors rounded-xl shadow-sm" onclick="deleteInstantMethod(${i})" title="Hapus">
                <i class="fas fa-trash text-xs"></i>
              </button>
            </div>
          </div>
        `).join('');
      }
      if (jsonInput) {
        jsonInput.value = JSON.stringify(instantMethods);
      }
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showModal(editing = false, index = -1, triggerEl = null) {
      if (productError) productError.classList.add('hidden');
      if (editing && index >= 0 && index < instantMethods.length) {
        modalTitle.textContent = 'Edit Metode Withdraw Instan';
        editIndexInput.value = index;
        nameInput.value = instantMethods[index].name;
        ewalletInput.value = instantMethods[index].ewallet || 'dana';
        if (providerInput) providerInput.value = instantMethods[index].provider === 'vipreseller' ? 'vipreseller' : 'fr3';
        activeCheck.checked = instantMethods[index].active;
        if (feeInput) feeInput.value = instantMethods[index].fee || 0;
        editingProducts = JSON.parse(JSON.stringify(instantMethods[index].products || []));
      } else {
        modalTitle.textContent = 'Tambah Metode Withdraw Instan';
        editIndexInput.value = -1;
        nameInput.value = '';
        ewalletInput.value = 'dana';
        if (providerInput) providerInput.value = (currentProvider === 'vipreseller') ? 'vipreseller' : 'fr3';
        activeCheck.checked = true;
        if (feeInput) feeInput.value = 0;
        editingProducts = [];
      }
      if (providerInput) providerInput.disabled = true; // provider mengikuti tab yang dipilih
      syncProviderHint();
      renderProductRows();
      modal.classList.remove('hidden');
      lockBodyScroll();
      if (modalContent) modalContent.scrollTop = 0;
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function hideModal() {
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      unlockBodyScroll();
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    // Fungsi untuk menyimpan ke server via endpoint khusus
    async function saveToServer() {
      try {
        const response = await fetch('/admin/settings/instant-withdraw-methods', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ instantWithdrawMethods: instantMethods })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.error || 'Gagal menyimpan');
        }
        return true;
      } catch (err) {
        console.error(err);
        alert('Gagal menyimpan metode instan: ' + err.message);
        return false;
      }
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = nameInput.value.trim();
      const ewallet = ewalletInput.value.trim();
      const active = activeCheck.checked;
      const fee = parseInt(feeInput && feeInput.value) || 0;

      // Validasi daftar produk: kode wajib diisi & unik, nominal harus > 0.
      const products = editingProducts
        .map(p => ({ code: (p.code || '').trim(), amount: parseInt(p.amount) || 0 }));
      const validProducts = products.filter(p => p.code !== '' && p.amount > 0);
      const codes = validProducts.map(p => p.code);
      const hasDuplicate = new Set(codes).size !== codes.length;

      if (!name || !ewallet) {
        alert('Nama metode dan E-Wallet harus diisi.');
        return;
      }
      if (validProducts.length === 0 || validProducts.length !== products.length) {
        if (productError) productError.classList.remove('hidden');
        return;
      }
      if (hasDuplicate) {
        alert('Kode produk tidak boleh duplikat dalam satu metode.');
        return;
      }
      if (productError) productError.classList.add('hidden');

      const editIdx = parseInt(editIndexInput.value);
      const provider = (providerInput && providerInput.value === 'vipreseller') ? 'vipreseller' : 'fr3'; // select disabled tetap terbaca via JS
      const methodObj = { name, ewallet, provider, active, fee, products: validProducts };

      // Backup array sebelum perubahan
      const oldMethods = JSON.parse(JSON.stringify(instantMethods));

      if (editIdx >= 0) {
        instantMethods[editIdx] = methodObj;
      } else {
        instantMethods.push(methodObj);
      }

      renderList();

      const saved = await saveToServer();
      if (saved) {
        showLocalNotification('Metode withdraw instan berhasil disimpan.');
        hideModal();
      } else {
        // Rollback
        instantMethods = oldMethods;
        renderList();
      }
    });

    btnAdd.addEventListener('click', function() { showModal(false, -1, btnAdd); });
    btnCloseModal.addEventListener('click', hideModal);
    btnCancelModal.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) hideModal();
    });

    window.editInstantMethod = function(index, triggerEl) {
      showModal(true, index, triggerEl);
    };

    window.deleteInstantMethod = async function(index) {
      if (!confirm('Hapus metode ini?')) return;
      const deleted = instantMethods.splice(index, 1)[0];
      renderList();

      const saved = await saveToServer();
      if (!saved) {
        // Rollback
        instantMethods.splice(index, 0, deleted);
        renderList();
      } else {
        showLocalNotification('Metode berhasil dihapus.');
      }
    };

    // Render awal
    renderList();
  })();

  // ==============================
  // Metode Withdraw Instan AUSTIN (Bebas Nominal) — daftar terpisah, disimpan lewat endpoint sendiri
  // ==============================
  (function() {
    let methods = <%- JSON.stringify(settings.austinWithdrawMethods || []) %>;
    const $ = (id) => document.getElementById(id);
    const modal = $('austinMethodModal');
    if (!modal) return;
    document.body.appendChild(modal);
    const list = $('austinMethodList');
    const esc = (t) => String(t).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    const rp = (n) => 'Rp' + (Number(n) || 0).toLocaleString('id-ID');

    window.__austinCount = function() { return methods.length; };
    function render() {
      if (typeof window.__refreshProviderTabs === 'function') window.__refreshProviderTabs();
      if (!methods.length) {
        list.innerHTML = '<div class="text-center py-6 text-gray-400 text-xs font-medium bg-gray-50 rounded-xl border border-gray-200">Belum ada metode Austin. Kosong &mdash; buat dulu dengan tombol "Metode Austin" lalu Simpan.</div>';
        return;
      }
      list.innerHTML = methods.map((m, i) => `
        <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3 border border-gray-200">
          <div>
            <div class="flex items-center gap-2">
              <p class="text-xs font-medium text-gray-800">${esc(m.name)}</p>
              <span class="text-[10px] px-1.5 py-0.5 rounded-xl font-medium ${m.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${m.active ? 'Aktif' : 'Nonaktif'}</span>
            </div>
            <p class="text-xs text-gray-500">Wallet: ${esc(m.wallet)} | Kode: ${esc(m.openCode)} | Biaya admin: ${rp(m.fee)}</p>
            <p class="text-[11px] text-gray-400">Bebas nominal: Min ${rp(m.min)} — Max ${rp(m.max)}</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" data-edit="${i}" class="w-8 h-8 flex items-center justify-center bg-blue-500 hover:bg-blue-600 text-white rounded-xl shadow-sm"><i class="fas fa-pen text-xs"></i></button>
