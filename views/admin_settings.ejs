        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Base URL API</label>
          <input name="premkuBaseUrl" type="text" value="<%= settings.premkuBaseUrl || 'https://premku.com/api' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="https://premku.com/api">
