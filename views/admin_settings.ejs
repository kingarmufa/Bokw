      $('austinName').value = m.name; $('austinWallet').value = m.wallet; $('austinOpenCode').value = m.openCode;
      $('austinMin').value = m.min; $('austinMax').value = m.max; $('austinFee').value = m.fee; $('austinActive').checked = !!m.active;
      $('austinFetchInfo').classList.add('hidden');
      modal.classList.remove('hidden');
    }
    function close() { modal.classList.add('hidden'); }
    $('btnAddAustinMethod').addEventListener('click', () => open(-1));
    $('btnCloseAustinModal').addEventListener('click', close);
    $('btnCancelAustinModal').addEventListener('click', close);
    list.addEventListener('click', async (e) => {
      const ed = e.target.closest('[data-edit]'); const de = e.target.closest('[data-del]');
      if (ed) return open(parseInt(ed.dataset.edit));
      if (de) {
        if (!confirm('Hapus metode ini?')) return;
        const backup = methods.slice();
        methods.splice(parseInt(de.dataset.del), 1);
        render();
        if (!(await save())) { methods = backup; render(); }
      }
    });
    $('btnAustinFetch').addEventListener('click', async () => {
      const info = $('austinFetchInfo');
      const show = (t, err) => { info.textContent = t; info.classList.remove('hidden'); info.style.color = err ? '#dc2626' : ''; };
      show('Mengambil katalog dari Austin...');
      try {
        const d = await (await fetch('/admin/settings/austin-catalog?wallet=' + encodeURIComponent($('austinWallet').value))).json();
        if (!d.success) throw new Error(d.message || d.error || 'Gagal');
        const open = (d.products || []).find(p => p.open_denom);
        if (!open) return show('Wallet ini tidak punya produk Bebas Nominal di Austin.', true);
        $('austinOpenCode').value = open.code;
        if (open.min) $('austinMin').value = open.min;
        if (open.max) $('austinMax').value = open.max;
        show('Terisi: ' + open.code + ' (batas Austin ' + rp(open.min) + ' – ' + rp(open.max) + ').');
      } catch (err) { show('Gagal: ' + err.message, true); }
    });
    $('austinMethodForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const obj = {
        name: $('austinName').value.trim(), wallet: $('austinWallet').value, openCode: $('austinOpenCode').value.trim(),
        min: parseInt($('austinMin').value) || 0, max: parseInt($('austinMax').value) || 0,
        fee: parseInt($('austinFee').value) || 0, active: $('austinActive').checked
      };
      if (!obj.name || !obj.openCode) return alert('Nama metode dan kode produk wajib diisi.');
      if (obj.max <= 0) return alert('Maksimal harus lebih dari 0.');
      if (obj.min > obj.max) return alert('Minimal tidak boleh lebih besar dari maksimal.');
      const idx = parseInt($('austinEditIndex').value);
      if (methods.some((m, i) => i !== idx && m.name.toLowerCase() === obj.name.toLowerCase())) return alert('Nama metode Austin sudah dipakai.');
      const backup = methods.slice();
      if (idx >= 0) methods[idx] = obj; else methods.push(obj);
      render();
      if (await save()) { close(); if (typeof showLocalNotification === 'function') showLocalNotification('Metode Austin berhasil disimpan.'); }
      else { methods = backup; render(); }
    });
    render();
  })();

