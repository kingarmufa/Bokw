  // ===== WHATSAPP SENDER (Baileys) =====
  (function() {
    const $ = id => document.getElementById(id);
    const dot = $('waDot'), badgeText = $('waBadgeText'), formArea = $('waFormArea');
    const codeBox = $('waCodeBox'), codeText = $('waCodeText'), errEl = $('waError');
    const connBox = $('waConnectedBox'), connNum = $('waConnectedNumber');
    const pairBtn = $('waPairBtn'), pairBtnText = $('waPairBtnText'), logoutBtn = $('waLogoutBtn'), numInput = $('waNumberInput');
    if (!pairBtn) return;
    let poll = null;

    function render(d) {
      const st = d.status || 'disconnected';
      const map = { connected: ['#22c55e', 'Tersambung'], pairing: ['#f59e0b', 'Menunggu kode dimasukkan'], connecting: ['#f59e0b', 'Menyambungkan...'], disconnected: ['#d1d5db', 'Belum tertaut'] };
      const m = map[st] || map.disconnected;
      dot.style.background = m[0]; badgeText.textContent = m[1];
      formArea.classList.toggle('hidden', st === 'connected');
      connBox.classList.toggle('hidden', st !== 'connected');
      connNum.textContent = d.number ? '+' + d.number : '';
      const showCode = st === 'pairing' && d.pairingCode;
      codeBox.classList.toggle('hidden', !showCode);
      if (showCode) codeText.textContent = d.pairingCode;
      if (d.error && st !== 'connected') { errEl.textContent = d.error; errEl.classList.remove('hidden'); } else { errEl.classList.add('hidden'); }
      if (st === 'pairing' || st === 'connecting') startPoll(); else stopPoll();
    }
    // Tombol salin kode perangkat (fallback execCommand untuk halaman http / browser lama)
    const copyBtn = $('waCopyBtn'), copyBtnText = $('waCopyBtnText');
    if (copyBtn) copyBtn.addEventListener('click', function() {
      const text = (codeText.textContent || '').trim();
      if (!text || text === '----') return;
      const done = function() {
        copyBtnText.textContent = 'Tersalin!';
        setTimeout(function() { copyBtnText.textContent = 'Salin Kode'; }, 1500);
      };
      const fallback = function() {
        const t = document.createElement('textarea');
        t.value = text; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
        document.body.appendChild(t); t.select(); t.setSelectionRange(0, text.length);
        try { if (document.execCommand('copy')) done(); } catch (e) {}
        document.body.removeChild(t);
      };
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done).catch(fallback);
      else fallback();
    });
    function startPoll() { if (!poll) poll = setInterval(refresh, 3000); }
    function stopPoll() { if (poll) { clearInterval(poll); poll = null; } }
    async function refresh() {
      try { const r = await fetch('/admin/wa/status'); render(await r.json()); } catch (_) {}
    }
    pairBtn.addEventListener('click', async function() {
      pairBtn.disabled = true; pairBtn.style.opacity = '0.7'; pairBtnText.textContent = 'Membuat kode...';
      try {
        const r = await fetch('/admin/wa/pair', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ number: numInput.value }) });
        const d = await r.json();
        if (d.success === false) { errEl.textContent = d.error || 'Gagal membuat kode.'; errEl.classList.remove('hidden'); }
        else render(d);
      } catch (e) { errEl.textContent = 'Gagal menghubungi server.'; errEl.classList.remove('hidden'); }
      pairBtn.disabled = false; pairBtn.style.opacity = '1'; pairBtnText.textContent = 'Tautkan Perangkat';
    });
    logoutBtn.addEventListener('click', async function() {
      if (!confirm('Putuskan WhatsApp sender? Verifikasi WhatsApp tidak akan tersedia sampai ditautkan lagi.')) return;
      try { const r = await fetch('/admin/wa/logout', { method: 'POST' }); render(await r.json()); } catch (_) {}
    });
    refresh();
  })();

