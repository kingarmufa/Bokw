    async function save() {
      try {
        const r = await fetch('/admin/settings/austin-withdraw-methods', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ austinWithdrawMethods: methods }) });
        const d = await r.json();
        if (!r.ok || !d.success) throw new Error(d.error || 'Gagal menyimpan');
        if (Array.isArray(d.methods)) methods = d.methods;
        return true;
      } catch (e) { alert('Gagal menyimpan metode Austin: ' + e.message); return false; }
    }
    function open(idx) {
      const m = idx >= 0 ? methods[idx] : { name: '', wallet: 'DANA', openCode: '', min: 10000, max: 1000000, fee: 0, active: true };
      $('austinModalTitle').textContent = idx >= 0 ? 'EDIT METODE AUSTIN' : 'TAMBAH METODE AUSTIN';
