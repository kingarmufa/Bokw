      </div>
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Kredensial premku.com
        </button>
      </div>
    </div>

    <!-- ===================== SUNTIK SOSMED (SMM PANEL) VIA HERU PEDIA ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-bullhorn text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Suntik Sosmed — Heru Pedia</h2>
      </div>
      <p class="text-[11px] text-gray-500 mb-3">Layanan Suntik Sosmed (Followers, Likes, Views, dll) memakai <b>Heru Pedia</b> (<a href="https://herupedia.id/api" target="_blank" rel="noopener" class="text-blue-500 hover:underline font-medium">herupedia.id/api</a>). Ambil API Key dari dashboard Heru Pedia, isi di bawah, lalu pastikan saldo akun Heru Pedia cukup.</p>
      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 p-3">
          <div>
            <p class="text-xs font-medium text-gray-800">Aktifkan Fitur Suntik Sosmed</p>
            <p class="text-[11px] text-gray-500">Kalau nonaktif, menu Suntik Sosmed disembunyikan dari user.</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="fayupediaEnabled" class="sr-only peer" <%= settings.fayupediaEnabled ? "checked" : "" %>>
            <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:bg-blue-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
          </label>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">API Key</label>
          <input name="sosmedApiKey" type="text" value="<%= settings.sosmedApiKey || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="API Key dari dashboard Heru Pedia" autocomplete="off">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">URL API <span class="text-gray-400">(biarkan default)</span></label>
          <input name="sosmedApiUrl" type="text" value="<%= settings.sosmedApiUrl || 'https://herupedia.id/api/v2' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="https://herupedia.id/api/v2">
        </div>
        <input type="hidden" name="sosmedApiStyle" value="v2">
