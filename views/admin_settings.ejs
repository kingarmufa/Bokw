        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Base URL API <span class="text-gray-400">(opsional, isi kalau berbeda dari default)</span></label>
          <input name="austinBaseUrl" type="text" value="<%= settings.austinBaseUrl || 'https://austinstore.id' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="https://austinstore.id">
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
