  // ==============================
  // Toggle Konfigurasi Payment Gateway
  // ==============================
  (function() {
    const radioOrderkuota = document.querySelector('input[name="paymentGateway"][value="orderkuota"]');
    const radioGopay = document.querySelector('input[name="paymentGateway"][value="gopaymerchant"]');
    const radioKianarapay = document.querySelector('input[name="paymentGateway"][value="kianarapay"]');
    const radioDana = document.querySelector('input[name="paymentGateway"][value="dana"]');
    const configOrderkuota = document.getElementById('config-orderkuota');
    const configGopay = document.getElementById('config-gopaymerchant');
    const configKianarapay = document.getElementById('config-kianarapay');
    const configDana = document.getElementById('config-dana');
    const labelOrderkuota = document.getElementById('label-orderkuota');
    const labelGopay = document.getElementById('label-gopaymerchant');
    const labelKianarapay = document.getElementById('label-kianarapay');
    const labelDana = document.getElementById('label-dana');

    function toggleGatewayConfig() {
      const active = radioDana.checked ? 'dana' : (radioKianarapay.checked ? 'kianarapay' : (radioGopay.checked ? 'gopaymerchant' : 'orderkuota'));

      configOrderkuota.classList.toggle('hidden', active !== 'orderkuota');
      configGopay.classList.toggle('hidden', active !== 'gopaymerchant');
      configKianarapay.classList.toggle('hidden', active !== 'kianarapay');
      configDana.classList.toggle('hidden', active !== 'dana');

      // Catatan: input provider yang lagi non-aktif SENGAJA TIDAK di-disable, supaya
      // datanya (domain/apikey/token dsb) tetap ikut kekirim & kesimpen pas Simpan Gateway,
      // gak ke-timpa kosong walau provider yang lagi dipilih beda.

      // Gaya label terpilih. Orderkuota tanpa warna background (cuma border); state terpilih
      // ditandai border biru + shadow. Warna biru pakai hex (bukan kelas bg-blue-/border-blue-) karena
      // comic-theme.css memaksa semua class*="bg-blue-" jadi berwarna walau peer-checked belum aktif.
      labelOrderkuota.classList.toggle('border-[#3b5bdb]', active === 'orderkuota');
      labelOrderkuota.classList.toggle('shadow-md', active === 'orderkuota');
      labelOrderkuota.classList.toggle('border-gray-200', active !== 'orderkuota');
      labelGopay.classList.toggle('border-green-500', active === 'gopaymerchant');
      labelGopay.classList.toggle('bg-green-50', active === 'gopaymerchant');
      labelGopay.classList.toggle('shadow-md', active === 'gopaymerchant');
      labelGopay.classList.toggle('border-green-200', active !== 'gopaymerchant');
      labelGopay.classList.toggle('bg-green-50/50', active !== 'gopaymerchant');
      labelKianarapay.classList.toggle('border-orange-500', active === 'kianarapay');
      labelKianarapay.classList.toggle('bg-orange-50', active === 'kianarapay');
      labelKianarapay.classList.toggle('shadow-md', active === 'kianarapay');
      labelKianarapay.classList.toggle('border-orange-200', active !== 'kianarapay');
      labelKianarapay.classList.toggle('bg-orange-50/50', active !== 'kianarapay');
      labelDana.classList.toggle('border-sky-500', active === 'dana');
      labelDana.classList.toggle('bg-sky-50', active === 'dana');
      labelDana.classList.toggle('shadow-md', active === 'dana');
      labelDana.classList.toggle('border-sky-200', active !== 'dana');
      labelDana.classList.toggle('bg-sky-50/50', active !== 'dana');
    }

    radioOrderkuota.addEventListener('change', toggleGatewayConfig);
    radioGopay.addEventListener('change', toggleGatewayConfig);
    radioKianarapay.addEventListener('change', toggleGatewayConfig);
    radioDana.addEventListener('change', toggleGatewayConfig);
    // Panggil saat load untuk sinkronisasi disable
    toggleGatewayConfig();
  })();

  // Deklarasi ulang showLocalNotification agar bisa diakses di luar scope
