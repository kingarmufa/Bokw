  // ===== JAM KERJA PENARIKAN =====
  (function() {
    const toggle = document.getElementById('workHoursEnabled');
    const fields = document.getElementById('workHoursFields');
    const label  = document.getElementById('workHoursLabel');
    const preview = document.getElementById('workSchedulePreview');
    const hariNama = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];

    function updatePreview() {
      var openEl  = document.querySelector('[name=workOpenTime]');
      var closeEl = document.querySelector('[name=workCloseTime]');
      var openDay = parseInt((document.querySelector('[name=workOpenDay]') || {}).value || 1);
      var closeDay = parseInt((document.querySelector('[name=workCloseDay]') || {}).value || 5);
      if (preview && openEl && closeEl) {
        preview.textContent = hariNama[openDay] + ' – ' + hariNama[closeDay] + ', ' + openEl.value + ' s/d ' + closeEl.value + ' WIB';
      }
    }

    if (toggle) {
      toggle.addEventListener('change', function() {
        if (this.checked) {
          if (fields) { fields.classList.remove('opacity-50','pointer-events-none'); }
          if (label) label.textContent = 'Aktif';
        } else {
          if (fields) { fields.classList.add('opacity-50','pointer-events-none'); }
          if (label) label.textContent = 'Nonaktif';
        }
      });
    }

    document.querySelectorAll('[name=workOpenTime],[name=workCloseTime],[name=workOpenDay],[name=workCloseDay]').forEach(function(el) {
      el.addEventListener('change', updatePreview);
    });

    updatePreview();
  })();

  // ==============================
  // Perbaikan navigasi anchor (#metode-withdraw / #metode-withdraw-instan)
  // dari tombol "Setting" di navbar. Di HP, gambar/ikon/font yang telat
  // selesai render bikin tinggi halaman berubah SETELAH browser melakukan
  // scroll-ke-anchor bawaan, sehingga posisi akhirnya geser turun (mis. jadi
  // nyangkut di tengah "Jam Kerja Penarikan"). Di sini posisi anchor
  // dikoreksi ulang setelah semua aset (gambar dll.) benar-benar selesai
  // dimuat, supaya posisinya presisi.
  // ==============================
  (function() {
    if (!location.hash) return;
    const target = document.querySelector(location.hash);
    if (!target) return;
    const SCROLL_OFFSET = 96;
    function correctScroll() {
      const rect = target.getBoundingClientRect();
      const currentScrollY = window.scrollY || window.pageYOffset || 0;
      const targetY = Math.max(0, rect.top + currentScrollY - SCROLL_OFFSET);
      window.scrollTo(0, targetY);
    }
    // Koreksi beberapa kali: sesaat setelah load, dan lagi setelah jeda
    // (mengakomodasi font/ikon yang telat selesai reflow di HP yang lebih lambat).
    window.addEventListener('load', () => setTimeout(correctScroll, 50));
    setTimeout(correctScroll, 400);
    setTimeout(correctScroll, 1000);
  })();

</script>
<style>
  /* Offset anchor scroll bawaan browser, disamakan dengan tinggi navbar sticky */
  #metode-withdraw, #metode-withdraw-instan { scroll-margin-top: 96px; }
</style>
