        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">API Key</label>
          <input name="fr3ApiKey" type="text" value="<%= settings.fr3ApiKey || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="AO_xxxxx221220241234abcdefghij">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Base URL API <span class="text-gray-400">(opsional, isi kalau berbeda dari default)</span></label>
          <input name="fr3BaseUrl" type="text" value="<%= settings.fr3BaseUrl || 'https://fr3newera.com' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="https://fr3newera.com">
