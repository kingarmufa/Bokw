    <!-- ===================== ATURAN FINANSIAL (DENGAN RENTANG FEE) ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-money-bill-wave text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Aturan Finansial</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Kolom Kiri: Minimal Deposit & Minimal Fee Random (Start) -->
        <div class="space-y-3">
          <!-- Minimal Deposit -->
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Minimal Deposit</label>
            <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
              <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
              <input name="minDeposit" type="number" value="<%= (typeof settings.minDeposit === 'number' && !isNaN(settings.minDeposit)) ? settings.minDeposit : 1000 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
            </div>
          </div>
          <!-- Minimal Fee Random (Start) -->
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Minimal Fee Random (Start)</label>
            <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
              <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
              <input name="minFee" type="number" value="<%= (typeof settings.minFee === 'number' && !isNaN(settings.minFee)) ? settings.minFee : 0 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full">
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Nilai awal biaya acak, default 0.</p>
          </div>
        </div>

        <!-- Kolom Kanan: Maksimal Fee Random (Max) -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Maksimal Fee Random (Max)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
            <input name="maxFee" type="number" value="<%= (typeof settings.maxFee === 'number' && !isNaN(settings.maxFee)) ? settings.maxFee : 500 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Batas atas biaya acak.</p>
        </div>
      </div>
      <!-- Tombol simpan -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Aturan Finansial
        </button>
      </div>
    </div>

    <!-- ===================== METODE WITHDRAW (MANUAL) ===================== -->
    <div id="metode-withdraw" class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4 scroll-mt-24">
