<%- include('partials/header', { title: 'Settings' }) %>
<% if (locals.serverless) { %>
<aside style="margin:16px;padding:16px;border:2px solid #d39f19;border-radius:12px;background:#fff8dc;color:#242424;font:14px/1.6 system-ui">
<strong>Mode Vercel aktif</strong> · Login memakai MongoDB. Upload harus memakai cloud (maksimal total 3,8 MB).
Aktifkan scheduler pembayaran sesuai README_VERCEL.md. Gunakan OTP email; bot Telegram polling dan WhatsApp pairing membutuhkan hosting Node/VPS.
<a href="/api/runtime/status" style="color:#2348a6">Lihat status scheduler</a>
</aside>
<% } %>
<link rel="stylesheet" href="/bot-controls.css?v=7.0">
<script src="/bot-controls.js?v=7.0" defer></script>

<!-- Library jsQR untuk decode QR dari gambar (client-side) -->
<script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js"></script>

<style>
  .custom-scroll::-webkit-scrollbar { width: 2px; height: 2px; }
  .custom-scroll::-webkit-scrollbar-track { background: transparent; margin-top: 10px; margin-bottom: 10px; }
  .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
  .custom-scroll:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }
</style>

<div class="px-6 pb-6 mt-1 max-w-[480px] md:max-w-lg mx-auto">

  <!-- Notifikasi lokal (dinamis via JS) -->
  <div id="localNotif" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
    <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
    <p id="localNotifMessage"></p>
    <button type="button" onclick="this.parentElement.classList.add('hidden')" class="ml-auto text-gray-400 hover:text-gray-600">&times;</button>
  </div>

  <!-- Alert Success dari server -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  
  <!-- Alert Error dari server -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <style data-comic-owned>
/* Tombol aktif/nonaktif (switch) gaya komik: pasti terlihat di tema hitam & kuning. Menimpa utilitas Tailwind peer-checked. */
html body label.relative > input.sr-only.peer + div{display:block!important;position:relative!important;flex:none!important;width:70px!important;height:32px!important;margin:0!important;border:3px solid #171717!important;border-radius:999px!important;background:#fca5a5!important;box-shadow:2px 2px 0 #171717!important;transition:background .15s!important}
html body label.relative > input.sr-only.peer + div::before{content:'OFF'!important;position:absolute!important;right:9px!important;left:auto!important;top:50%!important;transform:translateY(-50%)!important;font:700 11px/1 Arial,sans-serif!important;letter-spacing:.5px!important;color:#171717!important;-webkit-text-fill-color:#171717!important}
html body label.relative > input.sr-only.peer + div::after{content:''!important;position:absolute!important;left:3px!important;right:auto!important;top:50%!important;width:20px!important;height:20px!important;transform:translateY(-50%)!important;border-radius:50%!important;background:#fff!important;border:3px solid #171717!important;transition:left .15s!important}
html body label.relative > input.sr-only.peer:checked + div{background:#22c55e!important}
html body label.relative > input.sr-only.peer:checked + div::before{content:'ON'!important;left:10px!important;right:auto!important}
html body label.relative > input.sr-only.peer:checked + div::after{left:37px!important;transform:translateY(-50%)!important}
html body label.relative > input.sr-only.peer:focus-visible + div{outline:3px solid #facc15!important;outline-offset:2px}
</style>
<form method="POST" action="/admin/settings" id="mainSettingsForm">
    <!-- JSON withdrawMethods akan diisi oleh JavaScript -->
    <input type="hidden" name="withdrawMethodsJson" id="withdrawMethodsJsonInput" value="<%= JSON.stringify(settings.withdrawMethods || []) %>">
    <!-- JSON instantWithdrawMethods -->
    <input type="hidden" name="instantWithdrawMethodsJson" id="instantWithdrawMethodsJsonInput" value="<%= JSON.stringify(settings.instantWithdrawMethods || []) %>">

    <!-- ===================== PENGATURAN UMUM ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-globe text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Pengaturan Umum</h2>
      </div>
      <div class="flex flex-col gap-3">
        <!-- Nama Gateway -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Nama Gateway</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="name" type="text" value="<%= settings.name %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Nama Gateway">
          </div>
        </div>
        <!-- WhatsApp Channel -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Channel Telegram</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="channelInformation" type="url" value="<%= settings.channelInformation %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://...">
          </div>
        </div>
        <!-- Download Aplikasi (link + on/off) -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-medium text-gray-700">Link Download Aplikasi</label>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="appDownloadEnabled" id="appDownloadEnabled" class="sr-only peer" <%= settings.appDownloadEnabled ? "checked" : "" %>>
              <div class="w-10 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:bg-green-500 transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-5"></div>
              <span class="ml-2 text-xs font-medium text-gray-600" id="appDownloadLabel"><%= settings.appDownloadEnabled ? "Aktif" : "Nonaktif" %></span>
            </label>
          </div>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="appDownloadUrl" type="url" value="<%= settings.appDownloadUrl %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://... (link APK / Play Store)">
          </div>
          <p class="text-[11px] text-gray-500 mt-2">Kalau <strong>Aktif</strong> dan link diisi, menu "Download Aplikasi" akan muncul di menu user, mengarah ke link ini. Kalau <strong>Nonaktif</strong>, menu tidak ditampilkan.</p>
        </div>
        <!-- Transfer antar-user -->
        <div class="border-2 border-black rounded-2xl p-4 bg-yellow-50">
          <div class="flex items-center justify-between mb-3"><div><b class="text-sm">Transfer Saldo Antar User</b><p class="text-[11px] text-gray-500">Tidak tersedia untuk role Merchant.</p></div><input type="checkbox" name="transferEnabled" <%= settings.transferEnabled !== false ? 'checked' : '' %> class="w-5 h-5"></div>
          <div class="grid grid-cols-2 gap-3"><div><label class="text-xs font-bold">Biaya Admin Transfer Username (Rp)</label><input name="transferAdminFee" type="number" min="0" value="<%= settings.transferAdminFee || 0 %>" class="w-full border-2 border-black rounded-xl p-2 mt-1"></div><div><label class="text-xs font-bold">Biaya Admin Transfer QRIS (Rp)</label><input name="transferQrisAdminFee" type="number" min="0" value="<%= (settings.transferQrisAdminFee === null || settings.transferQrisAdminFee === undefined) ? '' : settings.transferQrisAdminFee %>" placeholder="Kosong = sama dengan username" class="w-full border-2 border-black rounded-xl p-2 mt-1"></div><div class="col-span-2"><label class="text-xs font-bold">Minimal Transfer (Rp)</label><input name="minTransfer" type="number" min="1" value="<%= settings.minTransfer || 1000 %>" class="w-full border-2 border-black rounded-xl p-2 mt-1"></div></div>
          <p class="text-[11px] text-gray-500 mt-2">Biaya admin dipotong dari saldo pengirim di atas nominal transfer. Isi 0 untuk gratis.</p>
        </div>
        <!-- Contact Developer -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Contact Developer</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="contactDeveloper" type="url" value="<%= settings.contactDeveloper %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://...">
          </div>
        </div>
        <!-- ID Channel Telegram (untuk notifikasi Deposit/Withdraw Berhasil ke channel) -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">ID Channel Telegram (notifikasi Deposit/Withdraw)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="telegramChannelId" type="text" value="<%= settings.telegramChannelId %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Contoh: @namachannel atau -1001234567890">
          </div>
          <p class="text-[11px] text-gray-500 mt-2">Terpisah dari link "Channel Telegram" di atas. Isi username publik channel (cth: <code>@namachannel</code>) atau ID numerik channel privat (cth: <code>-1001234567890</code>). Bot harus sudah jadi admin di channel ini. Kosongkan kalau tidak ingin ada notifikasi Deposit/Withdraw Berhasil ke channel.</p>
        </div>
        <!-- Contact Gmail -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Contact Gmail</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="contactGmail" type="email" value="<%= settings.contactGmail %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="emailanda@gmail.com">
          </div>
        </div>
        <!-- Nama Pembuat (tampil di login & footer semua menu) -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Nama Pembuat (tampil di Login &amp; menu lain)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="creatorName" type="text" maxlength="40" value="<%= settings.creatorName %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Contoh: Xskycode (kosongkan untuk menyembunyikan)">
          </div>
        </div>
        <%- include('partials/theme_templates') %>
        <!-- Judul Landing Page -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Judul Landing Page</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="title" type="text" value="<%= settings.title %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Judul landing page">
          </div>
        </div>
        <!-- Deskripsi Landing Page -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Deskripsi Landing Page</label>
          <textarea name="description" rows="3" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Deskripsi singkat..."><%= settings.description %></textarea>
        </div>
        <!-- ===== LOGO (URL) ===== -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Logo (URL Gambar)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="logoUrl" id="logoUrlInput" type="url" value="<%= settings.logoUrl || '' %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://.../logo.png">
          </div>
          <div id="logoPreview" class="mt-2 <%= settings.logoUrl ? '' : 'hidden' %>">
            <img id="logoPreviewImg" src="<%= settings.logoUrl %>" class="h-12 w-auto object-cover" alt="Logo Preview">
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Masukkan link gambar (PNG, JPG, GIF). Bisa upload ke layanan seperti imgur/postimages lalu tempel link-nya di sini.</p>
        </div>
      </div>
      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Pengaturan Umum
        </button>
      </div>
    </div>

    <!-- ===================== PAYMENT GATEWAY (PILIH PROVIDER) ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-plug text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Payment Gateway</h2>
      </div>

      <!-- Pilihan Gateway -->
      <div class="mb-5">
        <label class="block text-xs font-medium text-gray-700 mb-3">Pilih Provider Integrasi</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <label class="relative flex flex-col items-center gap-3 p-4 rounded-xl border-2 border-gray-200 cursor-pointer transition-all duration-200"
                 id="label-orderkuota">
            <input type="radio" name="paymentGateway" value="orderkuota" class="peer hidden"
                   <%= settings.paymentGateway === 'orderkuota' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
              <img src="https://i.ibb.co.com/FqK256JH/IMG-20260603-WA0000.jpg" alt="Orderkuota" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Orderkuota</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-[#3b5bdb] peer-checked:bg-[#3b5bdb] transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-xl border-2 border-green-200 bg-green-50/50 cursor-pointer transition-all duration-200"
                 id="label-gopaymerchant">
            <input type="radio" name="paymentGateway" value="gopaymerchant" class="peer hidden"
                   <%= settings.paymentGateway === 'gopaymerchant' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
              <img src="https://i.ibb.co.com/VYL8rKdc/IMG-20260603-WA0001.jpg" alt="GoPay Merchant" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Gopay Merchant</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-green-500 peer-checked:bg-green-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-xl border-2 border-orange-200 bg-orange-50/50 cursor-pointer transition-all duration-200"
                 id="label-kianarapay">
            <input type="radio" name="paymentGateway" value="kianarapay" class="peer hidden"
                   <%= settings.paymentGateway === 'kianarapay' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
              <img src="https://img3.pixhost.to/images/6091/776776751_356980.jpg" alt="ShopeePay" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">ShopeePay</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-orange-500 peer-checked:bg-orange-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-xl border-2 border-sky-200 bg-sky-50/50 cursor-pointer transition-all duration-200"
                 id="label-dana">
            <input type="radio" name="paymentGateway" value="dana" class="peer hidden"
                   <%= settings.paymentGateway === 'dana' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
              <img src="https://img3.pixhost.to/images/6091/776776856_356979.jpg" alt="DANA" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">DANA</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-orange-500 peer-checked:bg-orange-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>
        </div>
      </div>

      <!-- Konfigurasi Orderkuota -->
      <div id="config-orderkuota" class="<%= settings.paymentGateway !== 'orderkuota' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <img src="https://i.ibb.co.com/FqK256JH/IMG-20260603-WA0000.jpg" alt="Orderkuota" class="w-8 h-8 rounded-xl object-cover border border-gray-200">
          <div>
            <p class="text-xs font-medium text-gray-800">Orderkuota</p>
            <p class="text-[10px] text-gray-400">Integrasi dengan API Orderkuota</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Domain Rest API</label>
            <input name="orderkuotaDomain" type="text" value="<%= settings.orderkuotaDomain || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="api.orderkuota.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Apikey Rest API</label>
            <input name="orderkuotaApiKey" type="text" value="<%= settings.orderkuotaApiKey || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="API Key">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Username Orderkuota</label>
            <input name="orderkuotaUsername" type="text" value="<%= settings.orderkuotaUsername || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Username">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Token Orderkuota</label>
            <input name="orderkuotaToken" type="text" value="<%= settings.orderkuotaToken || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Token">
          </div>
        </div>
      </div>

      <!-- Konfigurasi Gopay Merchant -->
      <div id="config-gopaymerchant" class="<%= settings.paymentGateway !== 'gopaymerchant' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <img src="https://i.ibb.co.com/VYL8rKdc/IMG-20260603-WA0001.jpg" alt="GoPay Merchant" class="w-8 h-8 rounded-xl object-cover border border-gray-200">
          <div>
            <p class="text-xs font-medium text-gray-800">Gopay Merchant</p>
            <p class="text-[10px] text-gray-400">Integrasi otomatis dengan API Gopay Merchant</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Domain Rest API</label>
            <input name="gopayDomain" type="text" value="<%= settings.gopayDomain || 'gomerch.vercel.app' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="api.example.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Token Gopay Merchant</label>
            <textarea name="gopayToken" rows="3" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Token dari Gopay Merchant"><%= settings.gopayToken %></textarea>
          </div>
          <div>
