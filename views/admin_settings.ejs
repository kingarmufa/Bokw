<script>
(function () {
  var btn = document.getElementById('sosmedDiagBtn'); if (!btn) return;
  var out = document.getElementById('sosmedDiagOut');
  btn.addEventListener('click', async function () {
    out.classList.remove('hidden'); out.style.color = '#171717'; out.textContent = 'Mengambil katalog Heru Pedia...';
    try {
      var r = await fetch('/admin/settings/sosmed-diagnose?search=' + encodeURIComponent(document.getElementById('sosmedDiagSearch').value.trim()), { credentials: 'same-origin' });
      var d = await r.json();
      if (!d.success) { out.style.color = '#b91c1c'; out.textContent = 'Gagal: ' + (d.error || 'tidak diketahui'); return; }
      var t = 'Saldo panel: ' + (d.balance === null ? '(tidak tersedia)' : d.balance) + '\nGaya API: ' + d.style + '\nLayanan terbaca: ' + d.total + ' | bisa dipesan: ' + d.usable + '\n\nContoh layanan (harga Rp per 1000, sebelum markup):';
      (d.sample || []).forEach(function (s) { t += '\n#' + s.id + ' ' + s.name + ' | ' + s.category + ' | Rp' + s.rate + ' | min ' + s.min + ' max ' + s.max + (s.refill ? ' | refill' : ''); });
      if (!(d.sample || []).length) t += '\n(tidak ada yang cocok)';
      out.textContent = t;
    } catch (e) { out.style.color = '#b91c1c'; out.textContent = 'Gagal menghubungi server.'; }
  });
})();
</script>
