# Isi melalui Vercel > Project Settings > Environment Variables.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/averpay
SESSION_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_32_KARAKTER
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_MINIMAL_12_KARAKTER
BASE_URL=https://nama-proyek.vercel.app
CRON_SECRET=GANTI_DENGAN_RANDOM_BERBEDA_MINIMAL_32_KARAKTER
# NODE_ENV=production otomatis pada Vercel.
# SERVERLESS=1 hanya untuk menguji mode Vercel di lokal.
# Optional: pasangan VAPID tetap untuk web push, bukan key acak tiap instance.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# ENABLE_BACKGROUND_JOBS=false untuk mode Node tanpa timer/bot.
